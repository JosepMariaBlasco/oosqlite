# This defines the current version of ooSQLite.
#
# Until 1.0.2.13107, in the ooRexx SVN, the build level was the SVN revision,
# set by the make files.  Since 1.1 it is fixed here, as the other numbers.
OOSQLITE_MAJOR=1
OOSQLITE_MINOR=1
OOSQLITE_MOD_LVL=0
OOSQLITE_BLD_LVL=0
OOSQLITE_VER_STR="1.1.0.0"
OOSQLITE_COPY_YEAR="2012-2026"

