# Makefile for ooSQLite on macOS (arm64 or x86_64, whichever the compiler
# targets).  It is Makefile.lin with the differences macOS needs: a .dylib,
# clang's C++ library, no posix_fallocate, and libedit for the shell.
#
# The compiler needs the ooRexx native API headers and libraries.  If REXX_HOME
# is defined (the folder of an ooRexx portable build, say), its include and lib
# folders are added; otherwise they must be where the compiler looks:
#
#   make -f Makefile.mac lib REXX_HOME=/path/to/oorexx
#
# Note that the ooSQLite3 executable is named oosqlite3 here rather than
# ooSQLite3 as it is on Windows.

# Include the ooSQLite version numbers.  Since 1.1 the build level is fixed
# in src/ooSQLite.ver; until 1.0.2.13107 it was the SVN revision.
include src/ooSQLite.ver

OOSQLITE_VER_STR:= "$(OOSQLITE_MAJOR).$(OOSQLITE_MINOR).$(OOSQLITE_MOD_LVL).$(OOSQLITE_BLD_LVL)"

# APICommon (from the ooRexx SVN, incubator/APICommon) is kept in the tree and
# built with the rest of the objects.  Define DEBUG=1 for a debug build.
APICOMMON_DIR=src/APICommon

ifeq ($(DEBUG),1)
    OPT=-g
else
    OPT=-O3
endif

ifdef REXX_HOME
    REXXINCLUDE=-I $(REXX_HOME)/include
    REXXLIBDIR=-L $(REXX_HOME)/lib
endif

PLATFORM_DIR=src/platform/unix

# As in Makefile.lin, minus HAVE_POSIX_FALLOCATE and HAVE_FDATASYNC, which
# macOS does not have (SQLite uses fcntl(F_FULLFSYNC) there).
CONFFLAGS = -DSTDC_HEADERS=1 -DHAVE_SYS_TYPES_H=1 -DHAVE_SYS_STAT_H=1 -DHAVE_STDLIB_H=1 -DHAVE_STRING_H=1 -DHAVE_MEMORY_H=1 -DHAVE_STRINGS_H=1 -DHAVE_INTTYPES_H=1 -DHAVE_STDINT_H=1 -DHAVE_UNISTD_H=1 -DHAVE_DLFCN_H=1 -DHAVE_USLEEP=1 -DHAVE_LOCALTIME_R=1 -DHAVE_GMTIME_R=1 -DHAVE_DECL_STRERROR_R=1 -DHAVE_STRERROR_R=1 -DHAVE_READLINE=1 -D_REENTRANT=1

WARNINGFLAGS=
VERDEFS=-DOOSQLITE_VER_MAJOR=$(OOSQLITE_MAJOR) -DOOSQLITE_VER_MINOR=$(OOSQLITE_MINOR) -DOOSQLITE_VER_LEVEL=$(OOSQLITE_MOD_LVL) -DOOSQLITE_VER_BUILD=$(OOSQLITE_BLD_LVL) -DOOSQLITE_VER_STRING=\"$(OOSQLITE_VER_STR)\" -DOOSQLITE_COPYRIGHT_YEAR=\"$(OOSQLITE_COPY_YEAR)\"
EXTRAINCLUDE=-I src/sqlite -I $(PLATFORM_DIR) -I $(APICOMMON_DIR) $(REXXINCLUDE)

SQLITEFLAGS=-DSQLITE_ENABLE_COLUMN_METADATA -DSQLITE_ENABLE_MEMORY_MANAGEMENT -DSQLITE_ENABLE_FTS3 -DSQLITE_ENABLE_FTS3_PARENTHESIS -DSQLITE_ENABLE_FTS4 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_GEOPOLY -DSQLITE_ENABLE_MATH_FUNCTIONS -DSQLITE_ENABLE_RTREE -DSQLITE_DEFAULT_FOREIGN_KEYS=1 -DSQLITE_CORE
BASEFLAGS = $(WARNINGFLAGS) $(VERDEFS) $(EXTRAINCLUDE) $(SQLITEFLAGS) $(CONFFLAGS)

OUT_DIR=build/release
BIN_DIR=bin/macos

SYSLIB_FLAGS=-DOOSQLITE_SHARED_LIBRARY_EXT=\".dylib\"

# The interpreter's libraries are found through @rpath, which the rexx that
# loads this library already resolves.
SO_LFLAGS=-dynamiclib -install_name @rpath/liboosqlite.dylib
SO_LLIBS=$(REXXLIBDIR) -lc++ -lrexx -lrexxapi
EXE_LLIBS=-ledit -lm

CC=cc
CXX=c++
CFLAGS=-c -fPIC $(BASEFLAGS)

# zlib (src/zlib, used by the compress and zipfile builtins) is compiled into
# the library, as on Linux; see Makefile.lin.
ZLIB_DIR=src/zlib
ZLIBFLAGS=-DZ_PREFIX -I $(ZLIB_DIR)
ZLIB_OBJS=$(OUT_DIR)/zlib_adler32.o $(OUT_DIR)/zlib_compress.o $(OUT_DIR)/zlib_crc32.o \
          $(OUT_DIR)/zlib_deflate.o $(OUT_DIR)/zlib_inffast.o $(OUT_DIR)/zlib_inflate.o \
          $(OUT_DIR)/zlib_inftrees.o $(OUT_DIR)/zlib_trees.o $(OUT_DIR)/zlib_uncompr.o \
          $(OUT_DIR)/zlib_zutil.o

EXT_OBJS=$(OUT_DIR)/base64.o  $(OUT_DIR)/compress.o $(OUT_DIR)/csv.o \
         $(OUT_DIR)/ieee754.o $(OUT_DIR)/nextchar.o $(OUT_DIR)/percentile.o \
         $(OUT_DIR)/regexp.o  $(OUT_DIR)/rot13.o    $(OUT_DIR)/spellfix.o \
         $(OUT_DIR)/totype.o  $(OUT_DIR)/wholenumber.o $(OUT_DIR)/zipfile.o

OOSQLITE_OBJS=$(OUT_DIR)/sqlite3.o $(OUT_DIR)/ooSQLite.o $(OUT_DIR)/APICommon.o $(OUT_DIR)/ooSqlSysLibrary.o \
              $(EXT_OBJS) $(ZLIB_OBJS)


# What we want to build.  "lib" is just the extension library and its class
# file, which is all the test suite needs.
all: lib $(BIN_DIR)/oosqlite3 example_dlls

lib: $(BIN_DIR)/liboosqlite.dylib $(BIN_DIR)/ooSQLite.cls

.PHONY: all lib example_dlls dist dist_clean clean_all clean

# git does not keep empty directories, so the output directories are created
# when needed.
$(OUT_DIR) $(BIN_DIR):
	mkdir -p $@


$(OUT_DIR)/sqlite3.o: src/sqlite/sqlite3.c src/sqlite/sqlite3.h Makefile.mac | $(OUT_DIR)
	$(CC) $(OPT) $(CFLAGS) -DOOSQLITE_BUILD -o $@ src/sqlite/sqlite3.c

$(OUT_DIR)/shell.o: src/sqlite/shell.c src/sqlite/sqlite3.h Makefile.mac | $(OUT_DIR)
	$(CC) $(OPT) $(CFLAGS) -o $@ src/sqlite/shell.c

$(OUT_DIR)/ooSQLite.o: src/ooSQLite.cpp src/ooSQLite.hpp $(APICOMMON_DIR)/APICommon.hpp src/sqlite/sqlite3.h Makefile.mac | $(OUT_DIR)
	$(CXX) $(OPT) $(CFLAGS) -DOOSQLITE_BUILD -o $@ src/ooSQLite.cpp

$(OUT_DIR)/APICommon.o: $(APICOMMON_DIR)/APICommon.cpp $(APICOMMON_DIR)/APICommon.hpp Makefile.mac | $(OUT_DIR)
	$(CXX) $(OPT) $(CFLAGS) -o $@ $(APICOMMON_DIR)/APICommon.cpp

$(OUT_DIR)/ooSqlSysLibrary.o: $(PLATFORM_DIR)/ooSqlSysLibrary.cpp $(PLATFORM_DIR)/ooSqlSysLibrary.hpp Makefile.mac | $(OUT_DIR)
	$(CXX) $(OPT) $(CFLAGS) $(SYSLIB_FLAGS) -o $@ $(PLATFORM_DIR)/ooSqlSysLibrary.cpp

$(OUT_DIR)/compress.o $(OUT_DIR)/zipfile.o: $(OUT_DIR)/%.o: src/sqlite/extensions/%.c $(ZLIB_DIR)/zlib.h Makefile.mac | $(OUT_DIR)
	$(CC) $(OPT) $(CFLAGS) $(ZLIBFLAGS) -o $@ $<

$(filter-out $(OUT_DIR)/compress.o $(OUT_DIR)/zipfile.o,$(EXT_OBJS)): $(OUT_DIR)/%.o: src/sqlite/extensions/%.c Makefile.mac | $(OUT_DIR)
	$(CC) $(OPT) $(CFLAGS) -o $@ $<

$(OUT_DIR)/zlib_%.o: $(ZLIB_DIR)/%.c $(wildcard $(ZLIB_DIR)/*.h) Makefile.mac | $(OUT_DIR)
	$(CC) $(OPT) -c -fPIC $(ZLIBFLAGS) -o $@ $<

$(OUT_DIR)/liboosqlite.dylib: $(OOSQLITE_OBJS)
	$(CXX) $(OPT) $(SO_LFLAGS) -o $@ $(OOSQLITE_OBJS) $(SO_LLIBS)

$(OUT_DIR)/oosqlite3: $(OUT_DIR)/sqlite3.o $(OUT_DIR)/shell.o
	$(CC) $(OPT) -o $@ $(OUT_DIR)/sqlite3.o $(OUT_DIR)/shell.o $(EXE_LLIBS)

$(BIN_DIR)/liboosqlite.dylib: $(OUT_DIR)/liboosqlite.dylib | $(BIN_DIR)
	cp $(OUT_DIR)/liboosqlite.dylib $(BIN_DIR)

$(BIN_DIR)/oosqlite3: $(OUT_DIR)/oosqlite3 | $(BIN_DIR)
	cp $(OUT_DIR)/oosqlite3 $(BIN_DIR)

$(BIN_DIR)/ooSQLite.cls: src/rexx/ooSQLite.cls | $(BIN_DIR)
	cp src/rexx/ooSQLite.cls $(BIN_DIR)

example_dlls:
	@echo
	@echo Building example shared library \(libraries\)
	cd examples/user.extensions; $(MAKE) -f Makefile.mac
	cd examples/user.extensions/autoPackages; $(MAKE) -f Makefile.mac

dist: all
	@echo Create distribution file
	rexx src/rexx/makeDistFile.rex $(OOSQLITE_VER_STR)

dist_clean: clean_all

clean_all:
	rm -f $(OUT_DIR)/*.dylib $(OUT_DIR)/*.o $(OUT_DIR)/oosqlite3
	rm -f $(BIN_DIR)/*.dylib $(BIN_DIR)/oosqlite3 $(BIN_DIR)/*.cls
	cd examples/user.extensions; $(MAKE) -f Makefile.mac clean
	cd examples/user.extensions/autoPackages; $(MAKE) -f Makefile.mac clean

clean:
	rm -f $(OUT_DIR)/*.dylib $(OUT_DIR)/ooSQLite.o $(OUT_DIR)/oosqlite3
	cd examples/user.extensions; $(MAKE) -f Makefile.mac clean
	cd examples/user.extensions/autoPackages; $(MAKE) -f Makefile.mac clean
