    "zeroblob should have length 64")
  Call oosqlFinalize stmt2
  Call oosqlClose db

--------------------------------------------------------------------------------
-- ooSQLiteRegisterBuiltin                                                    --
--------------------------------------------------------------------------------

::Method testClassicRegisterBuiltin
  db = self~classicOpenMemory
  rc = ooSQLiteRegisterBuiltin(db, "rot13")
  self~assertEquals(0, rc, -
    "ooSQLiteRegisterBuiltin('rot13') should return OK")
  -- Verify function is usable
  Call oosqlPrepare db, "SELECT rot13('hello')", "stmt"
  Call oosqlStep stmt
  encoded = oosqlColumnText(stmt, 1)
  self~assertEquals("uryyb", encoded, -
    "rot13('hello') should return 'uryyb'")
  Call oosqlFinalize stmt
  Call oosqlClose db

::Method testClassicRegisterBuiltinMultiple
  -- Classic ooSQLiteRegisterBuiltin takes individual names (no 'ALL')
  db = self~classicOpenMemory
  rc = ooSQLiteRegisterBuiltin(db, "rot13")
  self~assertEquals(0, rc, -
    "ooSQLiteRegisterBuiltin('rot13') should return OK")
  rc = ooSQLiteRegisterBuiltin(db, "percentile")
  self~assertEquals(0, rc, -
    "ooSQLiteRegisterBuiltin('percentile') should return OK")
  -- Verify both functions are usable
  Call oosqlPrepare db, "SELECT rot13('test')", "stmt"
  Call oosqlStep stmt
  self~assertEquals("grfg", oosqlColumnText(stmt, 1), -
    "rot13 should work after registering individually")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlAutoExtension / oosqlCancelAutoExtension / oosqlResetAutoExtension    --
--------------------------------------------------------------------------------

::Method testClassicAutoExtension
  -- Clean state
  Call oosqlResetAutoExtension
  -- Register rot13 as auto-extension
  rc = oosqlAutoExtension("rot13")
  self~assertEquals(0, rc, -
    "oosqlAutoExtension('rot13') should return OK")
  -- Open a new connection — rot13 should be auto-registered
  Call oosqlOpen ":memory:", "db2"
  Call oosqlPrepare db2, "SELECT rot13('test')", "stmt"
  Call oosqlStep stmt
  self~assertEquals("grfg", oosqlColumnText(stmt, 1), -
    "rot13 should be available on new connection via auto-extension")
  Call oosqlFinalize stmt
  Call oosqlClose db2
  -- Cleanup
  Call oosqlResetAutoExtension

::Method testClassicCancelAutoExtension
  Call oosqlResetAutoExtension
  Call oosqlAutoExtension "rot13"
  -- Cancel it
  rc = oosqlCancelAutoExtension("rot13")
  self~assertEquals(1, rc, -
    "oosqlCancelAutoExtension should return 1 when extension was registered")
  -- Cancel again — should return 0 (not found)
  rc = oosqlCancelAutoExtension("rot13")
  self~assertEquals(0, rc, -
    "oosqlCancelAutoExtension should return 0 when not registered")
  Call oosqlResetAutoExtension

::Method testClassicResetAutoExtension
  Call oosqlAutoExtension "rot13"
  rc = oosqlResetAutoExtension()
  self~assertEquals(0, rc, -
    "oosqlResetAutoExtension should return 0 (void)")
  -- Verify rot13 is no longer auto-registered on new connections: the
  -- statement can not be prepared
  Call oosqlOpen ":memory:", "db2"
  rc = oosqlPrepare(db2, "SELECT rot13('x')", "stmt")
  self~assertEquals(.ooSQLite~ERROR, rc, -
    "rot13 should not be available after oosqlResetAutoExtension")
  self~assertEquals("no such function: rot13", oosqlErrMsg(db2), -
    "the error should be that rot13 does not exist")
  Call oosqlClose db2

/******************************************************************************/
/*                                                                            */
/* Section C9: Classic — oosqlEnableLoadExtension / oosqlLoadExtension        */
/*                                                                            */
/* Uses the simpleExtension test library from examples/user.extensions       */
/* (make -f Makefile.lin example_dlls).                                       */
/*                                                                            */
/******************************************************************************/

::Method testClassicLoadExtensionNotEnabled
  db = self~classicOpenMemory
  rc = oosqlLoadExtension(db, userExtLib("simpleextension"))
  self~assertEquals(1, rc, -
    "oosqlLoadExtension without oosqlEnableLoadExtension should fail")
  Call oosqlClose db

::Method testClassicLoadExtension
  db = self~classicOpenMemory
  self~assertEquals(0, oosqlEnableLoadExtension(db, .true), -
    "oosqlEnableLoadExtension(db, .true) should return OK")
  self~assertEquals(0, oosqlLoadExtension(db, userExtLib("simpleextension")), -
    "oosqlLoadExtension should return OK")
  rows = oosqlExec(db, "SELECT half(11) AS v;", .true, .ooSQLite~OO_ARRAY_OF_DIRECTORIES)
  self~assertEquals(5.5, rows[1]["V"], "half() from the extension should work")
  Call oosqlClose db

/******************************************************************************/
/*                                                                            */
/* Callback routines for Section C6                                           */
/*                                                                            */
/* These ::Routine definitions implement the callbacks for classic callback   */
/* tests. They use .environment for state communication since routines do     */
/* not have persistent instance variables.                                    */
/*                                                                            */
/******************************************************************************/

/* --- commitHook callbacks --- */

::Routine classicCommitHookCB Public
  Use Arg userData
  .environment~classicCommitHookCallCount = -
    .environment~classicCommitHookCallCount + 1
  Return 0

::Routine classicCommitHookUDCB Public
  Use Arg userData
  .environment~classicCommitHookLastUD = userData
  Return 0

::Routine classicCommitHookVetoCB Public
  Use Arg userData
  Return 1

/* --- rollbackHook callbacks --- */

::Routine classicRollbackHookCB Public
  Use Arg userData
  .environment~classicRollbackHookCallCount = -
    .environment~classicRollbackHookCallCount + 1
  Return 0

::Routine classicRollbackHookUDCB Public
  Use Arg userData
  .environment~classicRollbackHookLastUD = userData
  Return 0

/* --- updateHook callbacks --- */

::Routine classicUpdateHookCB Public
  Use Arg op, dbName, tableName, rowID
  ev = .Directory~new
  ev~op = op
  ev~dbName = dbName
  ev~tableName = tableName
  ev~rowID = rowID
  .environment~classicUpdateHookEvents~append(ev)
  Return 0

::Routine classicUpdateHookUDCB Public
  Use Arg op, dbName, tableName, rowID, userData
  .environment~classicUpdateHookLastUD = userData
  Return 0

/* --- trace callbacks --- */

::Routine classicTraceCB Public
  Use Arg sql, userData
  .environment~classicTraceStatements~append(sql)
  Return 0

::Routine classicTraceArgsCB Public
  .environment~classicTraceArgs~append(Arg(1, "A"))
  Return 0

/* --- profile callbacks --- */

::Routine classicProfileCB Public
  Use Arg sql, nanoSeconds, userData
  ev = .Directory~new
  ev~sql = sql
  ev~nanoSeconds = nanoSeconds
  .environment~classicProfileEvents~append(ev)
  Return 0

/* --- progressHandler callbacks --- */

::Routine classicProgressCB Public
  Use Arg userData
  .environment~classicProgressCallCount = -
    .environment~classicProgressCallCount + 1
  Return 0

::Routine classicProgressInterruptCB Public
  Use Arg maxCalls
  .environment~classicProgressCallCount = -
    .environment~classicProgressCallCount + 1
  If .environment~classicProgressCallCount >= maxCalls Then Return 1
  Return 0

/* --- busyHandler callbacks --- */

::Routine classicBusyHandlerCB Public
  Use Arg countInvoked, userData
  .environment~classicBusyCallCount = -
    .environment~classicBusyCallCount + 1
  If countInvoked < 3 Then Return 1
  Return 0

::Routine classicBusyHandlerUDCB Public
  Use Arg countInvoked, userData
  .environment~classicBusyLastUD = userData
  Return 0

/* --- setAuthorizer callbacks --- */

::Routine classicAuthorizerCB Public
  Use Arg code, str1, str2, str3, str4, userData
  Return 0

::Routine classicAuthorizerRecordCB Public
  Use Arg code, str1, str2, str3, str4, events
  events~append(code str1"|"str2"|"str3"|"str4)
  Return 0

/* --- createCollation callbacks --- */

::Routine classicNoCaseCB Public
  Use Arg str1, str2
  Return str1~caselessCompareTo(str2)

::Routine classicNoCaseUDCB Public
  Use Arg str1, str2, userData
  .environment~classicCollationLastUD = userData
  Return str1~caselessCompareTo(str2)

::Routine classicReverseCB Public
  Use Arg str1, str2
  Return -(str1~compareTo(str2))

/* --- collationNeeded callbacks --- */

::Routine classicCollNeededCB Public
  Use Arg db, collName, userData
  Call oosqlCreateCollation db, "classicDynamicNoCaseCB", collName
  Return 0

::Routine classicCollNeededUDCB Public
  Use Arg db, collName, userData
  .environment~classicCollNeededLastUD = userData
  Call oosqlCreateCollation db, "classicDynamicNoCaseCB", collName
  Return 0

::Routine classicDynamicNoCaseCB Public
  Use Arg str1, str2
  Return str1~caselessCompareTo(str2)

/* --- createFunction callbacks: scalar --- */

::Routine classicScalarDoubleCB Public
  Use Arg db, ctx, userData, val1
  intVal = oosqlValueInt(val1)
  Call oosqlResultInt ctx, intVal * 2
  Return 0

::Routine classicScalarConcatCB Public
  Use Arg db, ctx, userData, val1, val2
  t1 = oosqlValueText(val1)
  t2 = oosqlValueText(val2)
  Call oosqlResultText ctx, t1 || " " || t2
  Return 0

::Routine classicScalarGreetCB Public
  Use Arg db, ctx, userData, val1
  t1 = oosqlValueText(val1)
  Call oosqlResultText ctx, userData || " " || t1
  Return 0

/* --- createFunction callbacks: aggregate --- */

::Routine classicAggregateSumStepCB Public
  Use Arg db, ctx, aggObj, userData, val1
  intVal = oosqlValueInt(val1)
  If aggObj == .nil Then Do
    aggObj = .Directory~new
    aggObj~sum = intVal
  End
  Else Do
    aggObj~sum = aggObj~sum + intVal
  End
  Return aggObj

::Routine classicAggregateSumFinalCB Public
  Use Arg db, ctx, aggObj, userData
  If aggObj == .nil Then
    Call oosqlResultInt ctx, 0
  Else
    Call oosqlResultInt ctx, aggObj~sum
  Return 0

::Routine classicAggregateAvgStepCB Public
  Use Arg db, ctx, aggObj, userData, val1
  intVal = oosqlValueInt(val1)
  If aggObj == .nil Then Do
    aggObj = .Directory~new
    aggObj~sum = intVal
    aggObj~count = 1
  End
  Else Do
    aggObj~sum = aggObj~sum + intVal
    aggObj~count = aggObj~count + 1
  End
  Return aggObj

::Routine classicAggregateAvgFinalCB Public
  Use Arg db, ctx, aggObj, userData
  If aggObj == .nil Then
    Call oosqlResultDouble ctx, 0
  Else
    Call oosqlResultDouble ctx, aggObj~sum / aggObj~count
  Return 0

/******************************************************************************/
/*                                                                            */
/* Callback routines for Section C7                                           */
/*                                                                            */
/* These ::Routine definitions implement the UDF callbacks for classic        */
/* result/value routine tests.                                                */
/*                                                                            */
/******************************************************************************/

/* --- value routines --- */

::Routine classicValueDoubleCB Public
  Use Arg db, ctx, userData, val
  dbl = oosqlValueDouble(val)
  If dbl == .nil Then
    Call oosqlResultText ctx, "NIL"
  Else
    Call oosqlResultText ctx, dbl
  Return 0

-- The doubles must keep all their precision: the shortest string that
-- converts back to the same double.  Compared between brackets, because
-- assertEquals compares numbers with NUMERIC DIGITS 9.
::Routine doubleCases Public
  Return .Array~of( -
    .Array~of("3.141592653589793",     "3.141592653589793"), -
    .Array~of("0.1",                   "0.1"),               -
    .Array~of("0.1 + 0.2",             "0.30000000000000004"), -
    .Array~of("2.5",                   "2.5"),               -
    .Array~of("123456789012.5",        "123456789012.5"),    -
    .Array~of("-2.0",                  "-2"),                -
    .Array~of("1e300",                 "1E+300"))

::Routine classicValueBlobKindCB Public
  -- "NIL" for .nil, otherwise the bytes in hexadecimal between brackets
  Use Arg db, ctx, userData, val
  b = oosqlValueBlob(val)
  If b == .nil Then
    Call oosqlResultText ctx, "NIL"
  Else
    Call oosqlResultText ctx, "[" || b~c2x || "]"
  Return 0

::Routine classicValueBlobCB Public
  Use Arg db, ctx, userData, val
  blob    = oosqlValueBlob(val)
  blobLen = oosqlValueBytes(val)
  Call oosqlResultBlob ctx, blob, blobLen
  Return 0

::Routine classicResultBlobStringCB Public
  Use Arg db, ctx, userData
  Call oosqlResultBlob ctx, "CAFE"x
  Return 0

::Routine classicValueBlobNullCB Public
  Use Arg db, ctx, userData, val
  blobPtr = oosqlValueBlob(val)
  If blobPtr == .nil Then
    Call oosqlResultText ctx, "NIL"
  Else
    Call oosqlResultText ctx, "NOT_NIL"
  Return 0

::Routine classicValueNumTypeCB Public
  Use Arg db, ctx, userData, val
  typ    = oosqlValueType(val)
  numTyp = oosqlValueNumericType(val)
  Call oosqlResultText ctx, typ","numTyp
  Return 0

::Routine classicValueInt64CB Public
  Use Arg db, ctx, userData, val
  intVal = oosqlValueInt64(val)
  If intVal == .nil Then
    Call oosqlResultText ctx, "NIL"
  Else
    Call oosqlResultInt64 ctx, intVal
  Return 0

/* --- result routines --- */

::Routine classicResultInt64CB Public
  Use Arg db, ctx, userData, val
  txtVal = oosqlValueText(val)
  Call oosqlResultInt64 ctx, txtVal
  Return 0

::Routine classicResultNullCB Public
  Use Arg db, ctx, userData
  Call oosqlResultNull ctx
  Return 0

::Routine classicResultZeroBlobCB Public
  Use Arg db, ctx, userData, val
  n = oosqlValueInt(val)
  Call oosqlResultZeroBlob ctx, n
  Return 0

::Routine classicResultValueCB Public
  Use Arg db, ctx, userData, val
  Call oosqlResultValue ctx, val
  Return 0

::Routine classicResultErrorCB Public
  Use Arg db, ctx, userData
  Call oosqlResultError ctx, "Custom UDF error"
  Return 0

::Routine classicResultErrorCodeCB Public
  Use Arg db, ctx, userData
  Call oosqlResultErrorCode ctx, 13
  Return 0

::Routine classicResultErrorNoMemCB Public
  Use Arg db, ctx, userData
  Call oosqlResultErrorNoMem ctx
  Return 0

::Routine classicResultErrorTooBigCB Public
  Use Arg db, ctx, userData
  Call oosqlResultErrorTooBig ctx
  Return 0

/******************************************************************************/
/*                                                                            */
/* userExtLib — full path of a test library in examples/user.extensions      */
/*                                                                            */
/* The libraries are built by "make -f Makefile.lin example_dlls".            */
/*                                                                            */
/******************************************************************************/

::Routine userExtLib Public
  Use Strict Arg baseName
  sep = .File~separator
  testDir = .File~new(.context~package~name)~parent
  dir = .File~new(testDir || sep || ".." || sep || "examples" || sep || "user.extensions")~absolutePath
  If .RexxInfo~platform~upper~left(7) == "WINDOWS" Then
    Return dir || sep || baseName || ".dll"
  Return dir || sep || "lib" || baseName || ".so"

-- Subclasses whose init does not forward to the superclass's, for the tests
-- of objects left without their C data.
::Class PackageWithoutSuperInit Subclass ooSQLPackage
::Method init
  Nop

::Class LibraryWithoutSuperInit Subclass ooSQLLibrary
::Method init
  Nop
