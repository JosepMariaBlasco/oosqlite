--------------------------------------------------------------------------------

::Method testMathLn
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT ln(1);")
  stmt~step
  self~assertEquals(0.0, stmt~columnDouble(1), "ln(1) should be 0.0")
