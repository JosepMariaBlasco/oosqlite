::Method testClassicCallbackCreateFunctionUserData
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES('world');"
  ret = oosqlCreateFunction(db, "cl_greet", 1, -
    "classicScalarGreetCB",,, "Hello")
  self~assertEquals(0, ret, -
