    "coll_data")
  self~assertEquals(0, ret, -
    "oosqlCreateCollation with userData should return OK")
  rs = oosqlExec(db, -
    "SELECT name FROM t ORDER BY name COLLATE CL_NOCASE_UD;", .true, 2)
  self~assertEquals("coll_data", .environment~classicCollationLastUD, -
    "Collation callback should receive userData")
  Call oosqlClose db

