  Call oosqlExec db, "CREATE TABLE t(name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES('alpha');"
  Call oosqlExec db, "INSERT INTO t VALUES('beta');"
  Call oosqlExec db, "INSERT INTO t VALUES('gamma');"
  ret = oosqlCreateCollation(db, "classicReverseCB", "CL_REVERSE")
