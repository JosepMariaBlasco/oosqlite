  db~exec("INSERT INTO t VALUES(1);", .true)
  db~exec("ROLLBACK;")
  self~assertEquals(1, handler~callCount, -
    "rollbackHook should fire once on explicit ROLLBACK")
  db~close

--------------------------------------------------------------------------------
-- rollbackHook: userData propagation                                         --
--------------------------------------------------------------------------------

::Method testRollbackHookUserData
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  handler = .RollbackHookHandler~new
  myData = "rollback_user_data"
  db~rollbackHook(handler,, myData)
  db~exec("BEGIN;")
  db~exec("INSERT INTO t VALUES(1);", .true)
  db~exec("ROLLBACK;")
  self~assertEquals(myData, handler~lastUserData, -
    "rollbackHook should receive userData")
