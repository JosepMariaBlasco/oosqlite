--------------------------------------------------------------------------------
-- base64: encode blob to text                                                --
--------------------------------------------------------------------------------

::Method testBase64Encode
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "base64")
  stmt = .ooSQLiteStmt~new(db, "SELECT base64(x'48656C6C6F');")
  stmt~step
  val = stmt~columnText(1)~strip("T", "0a"x)
  self~assertEquals("SGVsbG8=", val, -
    "base64 encode of 'Hello' should be 'SGVsbG8='")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- base64: decode text to blob                                                --
--------------------------------------------------------------------------------

::Method testBase64Decode
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "base64")
  stmt = .ooSQLiteStmt~new(db, "SELECT base64('SGVsbG8=');")
  stmt~step
  -- Decoded blob, read as text
  self~assertEquals("Hello", stmt~columnText(1), -
    "base64 decode of 'SGVsbG8=' should be 'Hello'")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- base64: return types                                                       --
--------------------------------------------------------------------------------

::Method testBase64EncodeType
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "base64")
  stmt = .ooSQLiteStmt~new(db, "SELECT typeof(base64(x'FF'));")
  stmt~step
  self~assertEquals("text", stmt~columnText(1), -
    "base64(blob) should return text type")
  stmt~finalize
  db~close

::Method testBase64DecodeType
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "base64")
  stmt = .ooSQLiteStmt~new(db, "SELECT typeof(base64('AA=='));")
  stmt~step
  self~assertEquals("blob", stmt~columnText(1), -
    "base64(text) should return blob type")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- base64: roundtrip                                                          --
--------------------------------------------------------------------------------

::Method testBase64Roundtrip
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "base64")
  -- Encode then decode should return original blob
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT typeof(base64(base64(x'DEADBEEF')));")
  stmt~step
  self~assertEquals("blob", stmt~columnText(1), -
    "roundtrip should return blob type")
  stmt~finalize
  -- Use hex() to verify the roundtrip precisely
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT hex(base64(base64(x'DEADBEEF')));")
  stmt~step
  self~assertEquals("DEADBEEF", stmt~columnText(1), -
    "roundtrip hex should be DEADBEEF")
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Tier 5C — csv builtin extension (virtual table)                            */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- csv: basic virtual table with header                                       --
--------------------------------------------------------------------------------

::Method testCsvVirtualTable
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "csv")
  -- Create a CSV file
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite-test.csv")
  csvFile = tempFile~fullName
  stream = .Stream~new(csvFile)
  stream~open("WRITE REPLACE")
  stream~lineOut("name,age,city")
  stream~lineOut("Alice,30,Barcelona")
  stream~lineOut("Bob,25,Madrid")
  stream~lineOut("Carol,35,Valencia")
  stream~close
  -- Create virtual table
  db~exec("CREATE VIRTUAL TABLE csvdata USING csv(" -
    || "filename='" || csvFile || "', header=yes);", .true)
  self~assertEquals(0, db~errCode, "CREATE csv virtual table should succeed")
  -- Query
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM csvdata ORDER BY name;")
  self~assertEquals(3, stmt~columnCount, "csv table should have 3 columns")
  self~assertEquals("name", stmt~columnName(1), "first column should be 'name'")
  -- First row
  stmt~step
  self~assertEquals("Alice", stmt~columnText(1), "first row name should be Alice")
  self~assertEquals("30", stmt~columnText(2), "Alice age should be 30")
  self~assertEquals("Barcelona", stmt~columnText(3), -
    "Alice city should be Barcelona")
  -- Count remaining rows
  rowCount = 1
  Do While stmt~step = stmt~ROW
    rowCount += 1
  End
  self~assertEquals(3, rowCount, "csv should have 3 data rows")
  stmt~finalize
  db~close
  -- Cleanup
  Call SysFileDelete csvFile

/******************************************************************************/
/*                                                                            */
/* Tier 5D — R-Tree extension (spatial indexing)                              */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- R-Tree: create and populate                                                --
--------------------------------------------------------------------------------

::Method testRtreeCreate
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE boxes USING" -
    || " rtree(id, minX, maxX, minY, maxY);", .true)
  self~assertEquals(0, db~errCode, "CREATE rtree should succeed")
  db~exec("INSERT INTO boxes VALUES(1, 0, 5, 0, 5);", .true)
  db~exec("INSERT INTO boxes VALUES(2, 3, 8, 3, 8);", .true)
  db~exec("INSERT INTO boxes VALUES(3, 10, 15, 10, 15);", .true)
  self~assertEquals(0, db~errCode, "INSERT into rtree should succeed")
  db~close

--------------------------------------------------------------------------------
-- R-Tree: spatial query (intersection)                                       --
--------------------------------------------------------------------------------

::Method testRtreeIntersection
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE boxes USING" -
    || " rtree(id, minX, maxX, minY, maxY);", .true)
  db~exec("INSERT INTO boxes VALUES(1, 0, 5, 0, 5);", .true)
  db~exec("INSERT INTO boxes VALUES(2, 3, 8, 3, 8);", .true)
  db~exec("INSERT INTO boxes VALUES(3, 10, 15, 10, 15);", .true)
  -- Query: which boxes intersect the region (1,1)-(4,4)?
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT id FROM boxes WHERE minX<=4 AND maxX>=1 AND minY<=4 AND maxY>=1" -
    || " ORDER BY id;")
  stmt~step
  self~assertEquals(1, stmt~columnInt(1), "Box 1 should intersect (1,1)-(4,4)")
  stmt~step
  self~assertEquals(2, stmt~columnInt(1), "Box 2 should intersect (1,1)-(4,4)")
  -- Box 3 should NOT appear
  self~assertEquals(stmt~DONE, stmt~step, -
    "Box 3 should not intersect (1,1)-(4,4)")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- R-Tree: no matches                                                         --
--------------------------------------------------------------------------------

::Method testRtreeNoMatch
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE boxes USING" -
    || " rtree(id, minX, maxX, minY, maxY);", .true)
  db~exec("INSERT INTO boxes VALUES(1, 0, 5, 0, 5);", .true)
  -- Query a region far away
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT id FROM boxes WHERE minX<=100 AND maxX>=99 AND minY<=100 AND maxY>=99;")
  self~assertEquals(stmt~DONE, stmt~step, -
    "Query in empty region should return no rows")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- R-Tree: coordinate values                                                  --
--------------------------------------------------------------------------------

::Method testRtreeCoordinates
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE boxes USING" -
    || " rtree(id, minX, maxX, minY, maxY);", .true)
  db~exec("INSERT INTO boxes VALUES(1, 1.5, 3.5, 2.5, 4.5);", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM boxes WHERE id=1;")
  stmt~step
  self~assertEquals(1, stmt~columnInt(1), "id should be 1")
  self~assertTrue(stmt~columnDouble(2) > 1.49, "minX should be ~1.5")
  self~assertTrue(stmt~columnDouble(2) < 1.51, "minX should be ~1.5")
  self~assertTrue(stmt~columnDouble(3) > 3.49, "maxX should be ~3.5")
  self~assertTrue(stmt~columnDouble(3) < 3.51, "maxX should be ~3.5")
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Tier 5E — Geopoly extension (polygon geometry)                             */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- Geopoly: create table and insert polygons                                  --
--------------------------------------------------------------------------------

::Method testGeopolyCreate
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE geo USING geopoly();", .true)
  self~assertEquals(0, db~errCode, "CREATE geopoly should succeed")
  -- Insert a unit square
  db~exec("INSERT INTO geo(_shape) VALUES(" -
    || "'[[0,0],[1,0],[1,1],[0,1],[0,0]]');", .true)
  self~assertEquals(0, db~errCode, "INSERT polygon should succeed")
  db~close

--------------------------------------------------------------------------------
-- Geopoly: geopoly_area                                                      --
--------------------------------------------------------------------------------

::Method testGeopolyArea
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE geo USING geopoly();", .true)
  -- 4x4 square, area = 16
  db~exec("INSERT INTO geo(_shape) VALUES(" -
    || "'[[0,0],[4,0],[4,4],[0,4],[0,0]]');", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT geopoly_area(_shape) FROM geo;")
  stmt~step
  self~assertEquals(16, stmt~columnDouble(1), -
    "Area of 4x4 square should be 16")
  stmt~finalize
  db~close

::Method testGeopolyAreaTriangle
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE geo USING geopoly();", .true)
  -- Triangle: base 4, height 3, area = 6
  db~exec("INSERT INTO geo(_shape) VALUES(" -
    || "'[[0,0],[4,0],[2,3],[0,0]]');", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT geopoly_area(_shape) FROM geo;")
  stmt~step
  self~assertEquals(6, stmt~columnDouble(1), -
    "Area of triangle (base 4, height 3) should be 6")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Geopoly: geopoly_contains_point                                            --
--------------------------------------------------------------------------------

::Method testGeopolyContainsPoint
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE geo USING geopoly();", .true)
  db~exec("INSERT INTO geo(_shape) VALUES(" -
    || "'[[0,0],[4,0],[4,4],[0,4],[0,0]]');", .true)
  -- Point (2,2) is inside the square
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT rowid FROM geo WHERE geopoly_contains_point(_shape, 2, 2);")
  stmt~step
  self~assertEquals(1, stmt~columnInt(1), -
    "Point (2,2) should be inside the square")
  stmt~finalize
  -- Point (5,5) is outside
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT rowid FROM geo WHERE geopoly_contains_point(_shape, 5, 5);")
  self~assertEquals(stmt~DONE, stmt~step, -
    "Point (5,5) should be outside the square")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Geopoly: geopoly_json                                                      --
--------------------------------------------------------------------------------

::Method testGeopolyJson
  db = self~openMemoryDB
  db~exec("CREATE VIRTUAL TABLE geo USING geopoly();", .true)
  db~exec("INSERT INTO geo(_shape) VALUES(" -
    || "'[[0,0],[1,0],[1,1],[0,1],[0,0]]');", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT geopoly_json(_shape) FROM geo;")
  stmt~step
  json = stmt~columnText(1)
  self~assertTrue(json~pos("0.0") > 0, -
    "geopoly_json should contain coordinate text:" json)
  self~assertTrue(json~pos("1.0") > 0, -
    "geopoly_json should contain coordinate text:" json)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Geopoly: geopoly_overlap                                                   --
--------------------------------------------------------------------------------

::Method testGeopolyOverlapDisjoint
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT geopoly_overlap(" -
    || "'[[0,0],[1,0],[1,1],[0,1],[0,0]]', " -
    || "'[[5,5],[6,5],[6,6],[5,6],[5,5]]');")
  stmt~step
  self~assertEquals(0, stmt~columnInt(1), -
    "Disjoint polygons should return overlap 0")
  stmt~finalize
  db~close

::Method testGeopolyOverlapPartial
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT geopoly_overlap(" -
    || "'[[0,0],[4,0],[4,4],[0,4],[0,0]]', " -
    || "'[[2,2],[6,2],[6,6],[2,6],[2,2]]');")
  stmt~step
  self~assertEquals(1, stmt~columnInt(1), -
    "Partially overlapping polygons should return 1")
  stmt~finalize
  db~close

::Method testGeopolyOverlapContains
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT geopoly_overlap(" -
    || "'[[0,0],[10,0],[10,10],[0,10],[0,0]]', " -
    || "'[[2,2],[3,2],[3,3],[2,3],[2,2]]');")
  stmt~step
  -- First polygon contains the second: overlap = 3
  self~assertEquals(3, stmt~columnInt(1), -
    "Containment should return overlap 3")
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 33: Tier 6 — user extensions in shared libraries                   */
/*                                                                            */
/* loadExtension / enableLoadExtension (a SQLite extension), and the         */
/* ooSQLExtensions library and package managers: loadLibrary, getLibrary,     */
/* ooSQLLibrary~getHandle, loadPackage, getPackage, ooSQLPackage~register,    */
/* getFunction, getCollation, getCollationNeeded, and the auto* methods.      */
/*                                                                            */
/* The libraries are the test libraries in examples/user.extensions; build   */
/* them first with "make -f Makefile.lin example_dlls".  The auto* tests      */
/* change process-wide state, so each one turns automatic registration off   */
/* again before it checks anything.                                           */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- Helper: an in-memory database with a small table of names                  --
--------------------------------------------------------------------------------

::Method namesDB
  db = self~openMemoryDB
  db~exec("CREATE TABLE names(n TEXT);")
  db~exec("INSERT INTO names VALUES('a'); INSERT INTO names VALUES('c');" -
    "INSERT INTO names VALUES('b');")
  Return db

--------------------------------------------------------------------------------
-- Helper: the names in the order given by a collation, as one string         --
--------------------------------------------------------------------------------

::Method orderedNames
  Use Strict Arg db, collation
  -- On an SQL error exec returns an empty array and sets lastErrMsg
  rows = db~exec("SELECT n FROM names ORDER BY n COLLATE" collation";", .true)
  If rows~items == 0 Then Return "error:" db~lastErrMsg
  names = ""
  Do row Over rows
    names = names || row["N"]
  End
  Return names

--------------------------------------------------------------------------------
-- Helper: the value of a one-row, one-column query, or .nil on error         --
--------------------------------------------------------------------------------

::Method queryValue
  Use Strict Arg db, sql
  rows = db~exec(sql, .true)
  If rows~items == 0 Then Return .nil
  Return rows[1]["V"]

--------------------------------------------------------------------------------
-- loadExtension / enableLoadExtension                                        --
--------------------------------------------------------------------------------

::Method testLoadExtensionNotEnabled
  db = self~openMemoryDB
  rc = db~loadExtension(userExtLib("simpleextension"))
  self~assertEquals(.ooSQLite~ERROR, rc, -
    "loadExtension without enableLoadExtension should fail")
  self~assertTrue(db~lastErrMsg~pos("not authorized") > 0, -
    "lastErrMsg should say not authorized:" db~lastErrMsg)
  db~close

::Method testLoadExtension
  db = self~namesDB
  self~assertEquals(0, db~enableLoadExtension(.true), -
    "enableLoadExtension(.true) should return OK")
  self~assertEquals(0, db~loadExtension(userExtLib("simpleextension")), -
    "loadExtension should return OK")
  self~assertEquals(5.5, self~queryValue(db, "SELECT half(11) AS v;"), -
    "half() from the extension should work")
  self~assertEquals("cba", self~orderedNames(db, "reverse"), -
    "reverse collation from the extension should work")
  self~assertEquals("a, c, b", -
    self~queryValue(db, "SELECT strAggregate(n) AS v FROM names;"), -
    "strAggregate aggregate from the extension should work")
  db~close

::Method testLoadExtensionBadFile
  db = self~openMemoryDB
  db~enableLoadExtension(.true)
  rc = db~loadExtension(userExtLib("nosuchextension"))
  self~assertEquals(.ooSQLite~ERROR, rc, -
    "loadExtension of a missing file should fail")
  self~assertTrue(db~lastErrMsg~pos("nosuchextension") > 0, -
    "lastErrMsg should name the file:" db~lastErrMsg)
  db~close

::Method testEnableLoadExtensionOff
  db = self~openMemoryDB
  db~enableLoadExtension(.true)
  self~assertEquals(0, db~enableLoadExtension(.false), -
    "enableLoadExtension(.false) should return OK")
  rc = db~loadExtension(userExtLib("simpleextension"))
  self~assertEquals(.ooSQLite~ERROR, rc, -
    "loadExtension should fail again after enableLoadExtension(.false)")
  db~close

--------------------------------------------------------------------------------
-- loadLibrary / getLibrary / ooSQLLibrary~getHandle                          --
--------------------------------------------------------------------------------

::Method testLoadLibrary
  success = .ooSQLExtensions~loadLibrary(userExtLib("testlibrary"), -
    .Array~of("reverse", "halfFunc"))
  self~assertTrue(success, "loadLibrary should succeed:" -
    .ooSQLExtensions~lastErrMsg)
  lib = .ooSQLExtensions~getLibrary("testlibrary")
  self~assertTrue(lib~isA(.ooSQLLibrary), -
    "getLibrary should return an ooSQLLibrary")
  hReverse = lib~getHandle("reverse")
  self~assertTrue(hReverse~isA(.Pointer), "getHandle should return a Pointer")
  self~assertFalse(hReverse~isNull, "the handle should not be null")
  db = self~namesDB
  self~assertEquals(0, db~createCollation("REV", hReverse), -
    "createCollation with a library handle should return OK")
  self~assertEquals("cba", self~orderedNames(db, "REV"), -
    "the library collation should sort in reverse")
  self~assertEquals(0, db~createFunction("half", lib~getHandle("halfFunc"), 1), -
    "createFunction with a library handle should return OK")
  self~assertEquals(4.5, self~queryValue(db, "SELECT half(9) AS v;"), -
    "the library function should work")
  db~close

::Method testLoadLibraryUnresolvedName
  -- Names are resolved in order; the load stops at the first that fails, and
  -- what was resolved before it stays usable.
  success = .ooSQLExtensions~loadLibrary(userExtLib("testlibrary"), -
    .Array~of("reverse", "noSuchFunc", "halfFunc"))
  self~assertFalse(success, "loadLibrary should fail on an unknown name")
  self~assertTrue(.ooSQLExtensions~lastErrCode \= 0, -
    "lastErrCode should be set")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~pos("noSuchFunc") > 0, -
    "lastErrMsg should name the function:" .ooSQLExtensions~lastErrMsg)
  lib = .ooSQLExtensions~getLibrary("testlibrary")
  self~assertTrue(lib~isA(.ooSQLLibrary), -
    "the library stays loaded")
  self~assertTrue(lib~getHandle("reverse")~isA(.Pointer), -
    "a name resolved before the error stays usable")

::Method testLoadLibraryBadFile
  success = .ooSQLExtensions~loadLibrary(userExtLib("nosuchlibrary"))
  self~assertFalse(success, "loadLibrary of a missing file should fail")
  self~assertTrue(.ooSQLExtensions~lastErrCode \= 0, -
    "lastErrCode should be set")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~pos("nosuchlibrary") > 0, -
    "lastErrMsg should name the file:" .ooSQLExtensions~lastErrMsg)

::Method testGetLibraryNotLoaded
  lib = .ooSQLExtensions~getLibrary("noSuchLibrary")
  self~assertNull(lib, "getLibrary of an unknown library should return .nil")
  self~assertEquals(1008, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be OO_NO_SUCH_LIBRARY (1008)")

::Method testLibraryGetHandleNoSuch
  .ooSQLExtensions~loadLibrary(userExtLib("testlibrary"))
  lib = .ooSQLExtensions~getLibrary("testlibrary")
  self~assertNull(lib~getHandle("noSuchFunc"), -
    "getHandle of an unknown name should return .nil")
  self~assertTrue(lib~lastErrCode \= 0, "lib~lastErrCode should be set")
  self~assertTrue(lib~lastErrMsg~pos("noSuchFunc") > 0, -
    "lib~lastErrMsg should name the function:" lib~lastErrMsg)

--------------------------------------------------------------------------------
-- loadPackage / getPackage / ooSQLPackage                                    --
--------------------------------------------------------------------------------

::Method loadTestPackage
  success = .ooSQLExtensions~loadPackage(userExtLib("testpackage"))
  self~assertTrue(success, "loadPackage should succeed:" -
    .ooSQLExtensions~lastErrMsg)
  Return .ooSQLExtensions~getPackage("testPackage")

::Method testLoadPackageWithConnection
  db = self~namesDB
  success = .ooSQLExtensions~loadPackage(userExtLib("testpackage"), db)
  self~assertTrue(success, "loadPackage should succeed:" -
    .ooSQLExtensions~lastErrMsg)
  self~assertEquals(1.5, self~queryValue(db, "SELECT half(3) AS v;"), -
    "loadPackage with a connection registers the functions on it")
  self~assertEquals("a, c, b", -
    self~queryValue(db, "SELECT strAggregate(n) AS v FROM names;"), -
    "loadPackage with a connection registers the aggregates on it")
  self~assertEquals("cba", self~orderedNames(db, "reverse"), -
    "loadPackage with a connection registers the collations on it")
  db~close

::Method testLoadPackageBadFile
  success = .ooSQLExtensions~loadPackage(userExtLib("nosuchpackage"))
  self~assertFalse(success, "loadPackage of a missing file should fail")
  self~assertTrue(.ooSQLExtensions~lastErrCode \= 0, -
    "lastErrCode should be set")

::Method testGetPackage
  package = self~loadTestPackage
  self~assertTrue(package~isA(.ooSQLPackage), -
    "getPackage should return an ooSQLPackage")
  self~assertNull(.ooSQLExtensions~getPackage("noSuchPackage"), -
    "getPackage of an unknown package should return .nil")
  self~assertEquals(1007, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be OO_NO_SUCH_PACKAGE (1007)")

::Method testPackageRegister
  package = self~loadTestPackage
  db = self~namesDB
  self~assertEquals(0, package~register(db), "register should return OK")
  self~assertEquals(2.5, self~queryValue(db, "SELECT half(5) AS v;"), -
    "register makes the functions available")
  self~assertEquals("cba", self~orderedNames(db, "reverse"), -
    "register makes the collations available")
  db~close

::Method testPackageGetFunction
  package = self~loadTestPackage
  function = package~getFunction("half")
  self~assertTrue(function~isA(.ooSQLFunction), -
    "getFunction should return an ooSQLFunction")
  db = self~openMemoryDB
  self~assertEquals(0, db~createFunction("half", function), -
    "createFunction with an ooSQLFunction should return OK")
  self~assertEquals(3.5, self~queryValue(db, "SELECT half(7) AS v;"), -
    "the package function should work")
  db~close

::Method testPackageFunctionOwnName
  -- createFunction registers a package function under the name it is given,
  -- as it does for Rexx methods and library handles
  package = self~loadTestPackage
  function = package~getFunction("half")
  db = self~openMemoryDB
  self~assertEquals(0, db~createFunction("mitad", function), -
    "createFunction with an ooSQLFunction should return OK")
  self~assertEquals(3.5, self~queryValue(db, "SELECT mitad(7) AS v;"), -
    "the function should be registered under the name given")
  self~assertNull(self~queryValue(db, "SELECT mitad(7, 8) AS v;"), -
    "without countArgs, the number of arguments of the package is used")
  self~assertEquals(0, db~createFunction("mitadv", function, -1), -
    "createFunction with an ooSQLFunction and countArgs should return OK")
  self~assertEquals(2, self~queryValue(db, "SELECT mitadv(4, 5) AS v;"), -
    "countArgs, when given, is used instead")
  db~close

::Method testPackageGetCollation
  package = self~loadTestPackage
  collation = package~getCollation("reverse")
  self~assertTrue(collation~isA(.ooSQLCollation), -
    "getCollation should return an ooSQLCollation")
  db = self~namesDB
  self~assertEquals(0, db~createCollation("reverse", collation), -
    "createCollation with an ooSQLCollation should return OK")
  self~assertEquals("cba", self~orderedNames(db, "reverse"), -
    "the package collation should sort in reverse")
  db~close

::Method testPackageCollationOwnName
  package = self~loadTestPackage
  collation = package~getCollation("reverse")
  db = self~namesDB
  self~assertEquals(0, db~createCollation("RV", collation), -
    "createCollation with an ooSQLCollation should return OK")
  self~assertEquals("cba", self~orderedNames(db, "RV"), -
    "the collation should be registered under the name given")
  db~close

::Method testPackageGetCollationNeeded
  package = self~loadTestPackage
  collNeeded = package~getCollationNeeded
  self~assertTrue(collNeeded~isA(.ooSQLCollationNeeded), -
    "getCollationNeeded should return an ooSQLCollationNeeded")
  db = self~namesDB
  self~assertEquals(0, db~collationNeeded(collNeeded), -
    "collationNeeded with an ooSQLCollationNeeded should return OK")
  self~assertEquals("cba", self~orderedNames(db, "reverseOrder"), -
    "the collation needed callback should register reverseOrder on demand")
  db~close
  db = self~namesDB
  self~assertEquals(0, db~collationNeeded(package), -
    "collationNeeded with the package itself should return OK")
  self~assertEquals("cba", self~orderedNames(db, "reverseOrder"), -
    "the package's collation needed callback should work")
  db~close

::Method testCollationNeededPackageWithoutCallback
  -- examplePackage has no collation needed callback: collationNeeded used to
  -- crash (SIGSEGV) with it
  success = .ooSQLExtensions~loadPackage(userExtLib("examplepackage"))
  self~assertTrue(success, "loadPackage of examplePackage should succeed")
  package = .ooSQLExtensions~getPackage("examplePackage")
  db = self~openMemoryDB
  self~assertEquals(.ooSQLite~MISUSE, db~collationNeeded(package), -
    "collationNeeded with a package that has no callback should return MISUSE")
  db~close

--------------------------------------------------------------------------------
-- autoPackage / autoFunction / autoCollation / autoCollationNeeded            --
--------------------------------------------------------------------------------

::Method testAutoPackage
  self~loadTestPackage
  on  = .ooSQLExtensions~autoPackage("testPackage")
  db1 = self~openMemoryDB
  half1 = self~queryValue(db1, "SELECT half(1) AS v;")
  off = .ooSQLExtensions~autoPackage("testPackage", .false)
  db2 = self~openMemoryDB
  half2 = self~queryValue(db2, "SELECT half(1) AS v;")
  db1~close
  db2~close
  self~assertTrue(on, "autoPackage should succeed")
  self~assertEquals(0.5, half1, "a new connection gets the package")
  self~assertTrue(off, "autoPackage(.., .false) should succeed")
  self~assertNull(half2, "after turning it off, new connections do not")

::Method testLoadPackageMakeAuto
  success = .ooSQLExtensions~loadPackage(userExtLib("testpackage"), , .true)
  db1 = self~openMemoryDB
  half1 = self~queryValue(db1, "SELECT half(1) AS v;")
  off = .ooSQLExtensions~autoPackage("testPackage", .false)
  db1~close
  self~assertTrue(success, "loadPackage(.., , .true) should succeed")
  self~assertEquals(0.5, half1, "makeAuto registers the package automatically")
  self~assertTrue(off, "autoPackage(.., .false) should succeed")

::Method testAutoFunction
  self~loadTestPackage
  on  = .ooSQLExtensions~autoFunction("testPackage", "half")
  db1 = self~openMemoryDB
  half1 = self~queryValue(db1, "SELECT half(1) AS v;")
  off = .ooSQLExtensions~autoFunction("testPackage", "half", .false)
  db2 = self~openMemoryDB
  half2 = self~queryValue(db2, "SELECT half(1) AS v;")
  db1~close
  db2~close
  self~assertTrue(on, "autoFunction should succeed")
  self~assertEquals(0.5, half1, "a new connection gets the function")
  self~assertTrue(off, "autoFunction(.., .., .false) should succeed")
  self~assertNull(half2, "after turning it off, new connections do not")

::Method testAutoCollation
  self~loadTestPackage
  on  = .ooSQLExtensions~autoCollation("testPackage", "reverse")
  db1 = self~namesDB
  names1 = self~orderedNames(db1, "reverse")
  off = .ooSQLExtensions~autoCollation("testPackage", "reverse", .false)
  db2 = self~namesDB
  names2 = self~orderedNames(db2, "reverse")
  db1~close
  db2~close
  self~assertTrue(on, "autoCollation should succeed")
  self~assertEquals("cba", names1, "a new connection gets the collation")
  self~assertTrue(off, "autoCollation(.., .., .false) should succeed")
  self~assertTrue(names2~pos("no such collation") > 0, -
    "after turning it off, new connections do not:" names2)

::Method testAutoCollationNeeded
  self~loadTestPackage
  on  = .ooSQLExtensions~autoCollationNeeded("testPackage")
  db1 = self~namesDB
  names1 = self~orderedNames(db1, "reverseOrder")
  off = .ooSQLExtensions~autoCollationNeeded("testPackage", .false)
  db2 = self~namesDB
  names2 = self~orderedNames(db2, "reverseOrder")
  db1~close
  db2~close
  self~assertTrue(on, "autoCollationNeeded should succeed")
  self~assertEquals("cba", names1, -
    "a new connection gets the collation needed callback")
  self~assertTrue(off, "autoCollationNeeded(.., .false) should succeed")
  self~assertTrue(names2~pos("no such collation") > 0, -
    "after turning it off, new connections do not:" names2)

::Method testAutoPackageNotLoaded
  self~assertFalse(.ooSQLExtensions~autoPackage("noSuchPackage"), -
    "autoPackage of an unknown package should fail")
  self~assertEquals(1007, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be OO_NO_SUCH_PACKAGE (1007)")

--------------------------------------------------------------------------------
-- The tables of loaded libraries and packages must survive garbage           --
-- collection: they used to be kept only in the C structures, so the          --
-- collector freed them and the next loadPackage crashed (SIGSEGV).           --
--------------------------------------------------------------------------------

::Method testExtensionTablesSurviveGC
  .ooSQLExtensions~loadLibrary(userExtLib("testlibrary"))
  package = self~loadTestPackage
  package~getFunction("half")
  .ooSQLExtensions~getLibrary("testlibrary")~getHandle("reverse")
  Do i = 1 To 3
    self~churnMemory
    self~assertTrue(.ooSQLExtensions~getPackage("testPackage")~isA(.ooSQLPackage), -
      "getPackage after garbage collection, round" i)
    lib = .ooSQLExtensions~getLibrary("testlibrary")
    self~assertTrue(lib~isA(.ooSQLLibrary), -
      "getLibrary after garbage collection, round" i)
    self~assertTrue(lib~getHandle("reverse")~isA(.Pointer), -
      "getHandle after garbage collection, round" i)
    package = .ooSQLExtensions~getPackage("testPackage")
    self~assertTrue(package~getFunction("half")~isA(.ooSQLFunction), -
      "getFunction after garbage collection, round" i)
    self~assertTrue(.ooSQLExtensions~loadPackage(userExtLib("testpackage")), -
      "loadPackage after garbage collection, round" i)
  End

--------------------------------------------------------------------------------
-- The collations and the aggregate of the example libraries                  --
--                                                                            --
-- ebcdic: "i < min, ..." in its loop discarded the bound, so equal strings   --
-- ran past their end (SIGSEGV). reverse: compared only the common prefix, so --
-- "ab" and "abc" were equal. strAggregate over no rows: "out of memory".     --
--------------------------------------------------------------------------------

::Method checkExampleCollations
  Use Strict Arg db, what
  self~assertEquals(1, self~queryValue(db, "SELECT 'ab' = 'ab' COLLATE ebcdic AS v;"), -
    what": ebcdic, equal strings")
  self~assertEquals(1, self~queryValue(db, "SELECT 'ab' < 'abc' COLLATE ebcdic AS v;"), -
    what": ebcdic, a prefix sorts first")
  self~assertEquals(0, self~queryValue(db, "SELECT 'ab' = 'abc' COLLATE reverse AS v;"), -
    what": reverse, a prefix is not equal")
  self~assertEquals(1, self~queryValue(db, "SELECT 'abc' < 'ab' COLLATE reverse AS v;"), -
    what": reverse, a prefix sorts last")
  self~assertEquals(1, self~queryValue(db, -
    "SELECT strAggregate(x) IS NULL AS v FROM (SELECT 'a' AS x) WHERE 0;"), -
    what": strAggregate over no rows is NULL")

::Method testExamplePackageCollations
  db = self~openMemoryDB
  .ooSQLExtensions~loadPackage(userExtLib("testpackage"), db)
  self~checkExampleCollations(db, "testPackage")
  db~close

::Method testExampleExtensionCollations
  db = self~openMemoryDB
  db~enableLoadExtension(.true)
  db~loadExtension(userExtLib("simpleextension"))
  self~checkExampleCollations(db, "simpleExtension")
  db~close

--------------------------------------------------------------------------------
-- A name that is not in the package sets lastErrCode and lastErrMsg          --
--------------------------------------------------------------------------------

::Method testPackageGetFunctionNoSuch
  package = self~loadTestPackage
  self~assertNull(package~getFunction("noSuchFunction"), -
    "getFunction of an unknown name should return .nil")
  self~assertEquals(.ooSQLite~MISUSE, package~lastErrCode, -
    "lastErrCode should be MISUSE")
  self~assertTrue(package~lastErrMsg~pos("noSuchFunction") > 0, -
    "lastErrMsg should name the function:" package~lastErrMsg)

::Method testPackageGetCollationNoSuch
  package = self~loadTestPackage
  self~assertNull(package~getCollation("noSuchCollation"), -
    "getCollation of an unknown name should return .nil")
  self~assertEquals(.ooSQLite~MISUSE, package~lastErrCode, -
    "lastErrCode should be MISUSE")
  self~assertTrue(package~lastErrMsg~pos("noSuchCollation") > 0, -
    "lastErrMsg should name the collation:" package~lastErrMsg)

::Method testAutoFunctionNoSuch
  self~loadTestPackage
  self~assertFalse(.ooSQLExtensions~autoFunction("testPackage", "noSuchFunction"), -
    "autoFunction of an unknown name should fail")
  self~assertEquals(.ooSQLite~MISUSE, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be MISUSE")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~pos("noSuchFunction") > 0, -
    "lastErrMsg should name the function:" .ooSQLExtensions~lastErrMsg)

::Method testAutoCollationNoSuch
  self~loadTestPackage
  self~assertFalse(.ooSQLExtensions~autoCollation("testPackage", "noSuchCollation"), -
    "autoCollation of an unknown name should fail")
  self~assertEquals(.ooSQLite~MISUSE, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be MISUSE")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~pos("noSuchCollation") > 0, -
    "lastErrMsg should name the collation:" .ooSQLExtensions~lastErrMsg)

--------------------------------------------------------------------------------
-- Found while documenting the ooSQLExtensions and ooSQLPackage classes (v27) --
--------------------------------------------------------------------------------

::Method syntaxErrorOf
  -- Sends msgName with args to receiver; returns the code and message of the
  -- syntax error, or "no error"
  Use Arg receiver, msgName, ...
  Signal On Syntax
  receiver~sendWith(msgName, Arg(3, "A"))
  Return "no error"
Syntax:
  co = Condition("O")
  Return co~code co~message

::Method testPackageRegisterClosedConnection
  -- register with a closed connection crashed (SIGSEGV)
  package = self~loadTestPackage
  db = self~openMemoryDB
  db~close
  err = self~syntaxErrorOf(package, "REGISTER", db)
  self~assertEquals("98.900", err~word(1), -
    "register with a closed connection should raise error 98.900:" err)
  self~assertTrue(err~pos("is not open") > 0, -
    "the message should say the connection is not open:" err)

::Method testPackageRegisterNotAConnection
  -- register with an object that is not a connection raised the error, but
  -- went on and used it as a connection (SIGSEGV)
  package = self~loadTestPackage
  err = self~syntaxErrorOf(package, "REGISTER", .Object~new)
  self~assertEquals("88", err~word(1)~left(2), -
    "register with a non-connection should raise error 88:" err)
  self~assertTrue(err~pos("ooSQLiteConnection") > 0, -
    "the message should name the class:" err)

::Method testAutoCollationNeededNoCallback
  -- the error was set where lastErrCode / lastErrMsg do not look, so they
  -- said "no error"
  success = .ooSQLExtensions~loadPackage(userExtLib("examplepackage"))
  self~assertTrue(success, "loadPackage of examplePackage should succeed")
  self~assertFalse(.ooSQLExtensions~autoCollationNeeded("examplePackage"), -
    "autoCollationNeeded with a package without a callback should fail")
  self~assertEquals(.ooSQLite~MISUSE, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be MISUSE")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~pos("no collation needed") > 0, -
    "lastErrMsg should say why:" .ooSQLExtensions~lastErrMsg)

::Method testLoadLibraryResetsLastErr
  -- a successful loadLibrary left the error of the previous call
  self~assertFalse(.ooSQLExtensions~loadLibrary(userExtLib("nosuchlibrary")), -
    "loadLibrary of a missing file should fail")
  self~assertTrue(.ooSQLExtensions~loadLibrary(userExtLib("testlibrary")), -
    "loadLibrary should succeed")
  self~assertEquals(0, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be 0 after a successful loadLibrary")

::Method testResetAutoBuiltinResetsLastErr
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "noExiste")
  db~close
  self~assertEquals(0, .ooSQLExtensions~resetAutoBuiltin, -
    "resetAutoBuiltin should return OK")
  self~assertEquals(0, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be 0 after resetAutoBuiltin")

::Method testCancelAutoBuiltinAll
  -- cancelling ALL returned MISUSE, with a wrong message, when some builtin
  -- was not automatic
  Signal On Syntax Name TestCancelAllCleanup
  .ooSQLExtensions~resetAutoBuiltin
  self~assertEquals(0, .ooSQLExtensions~cancelAutoBuiltin, -
    "cancelAutoBuiltin() with nothing automatic should return OK")
  .ooSQLExtensions~autoBuiltin("rot13")
  self~assertEquals(0, .ooSQLExtensions~cancelAutoBuiltin("ALL"), -
    "cancelAutoBuiltin('ALL') should return OK")
  self~assertEquals(0, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be 0 after cancelAutoBuiltin('ALL')")
  db = .ooSQLiteConnection~new(":memory:")
  rc = db~exec("SELECT rot13('test');")
  db~close
  self~assertEquals(1, rc, "rot13 should not be automatic any more")
  .ooSQLExtensions~resetAutoBuiltin
  Return
TestCancelAllCleanup:
  .ooSQLExtensions~resetAutoBuiltin
  Raise Propagate

::Method testAutoMarkedTwice
  -- marking an automatic function, collation or package again added it again,
  -- and unmarking it once left it automatic
  self~loadTestPackage
  e = .ooSQLExtensions
  self~assertTrue(e~autoFunction("testPackage", "half"), "autoFunction")
  self~assertTrue(e~autoFunction("testPackage", "half"), "autoFunction again")
  self~assertTrue(e~autoCollation("testPackage", "reverse"), "autoCollation")
  self~assertTrue(e~autoCollation("testPackage", "reverse"), "autoCollation again")
  self~assertTrue(e~autoFunction("testPackage", "half", .false), "unmark the function")
  self~assertTrue(e~autoCollation("testPackage", "reverse", .false), "unmark the collation")
  db = self~namesDB
  half = self~queryValue(db, "SELECT half(1) AS v;")
  names = self~orderedNames(db, "reverse")
  db~close
  self~assertNull(half, "the function should not be automatic any more")
  self~assertTrue(names~pos("no such collation") > 0, -
    "the collation should not be automatic any more:" names)
  self~assertFalse(e~autoFunction("testPackage", "half", .false), -
    "unmarking a function that is not automatic should fail")
  self~assertTrue(e~autoPackage("testPackage"), "autoPackage")
  self~assertTrue(e~autoPackage("testPackage"), "autoPackage again")
  self~assertTrue(e~autoPackage("testPackage", .false), "unmark the package")
  db = self~openMemoryDB
  half = self~queryValue(db, "SELECT half(1) AS v;")
  db~close
  self~assertNull(half, "the package should not be automatic any more")
  self~assertFalse(e~autoPackage("testPackage", .false), -
    "unmarking a package that is not automatic should fail")

::Method testExtensionResultCodeConstants
  -- the codes 1005 to 1011 had no constants
  codes = .Array~of("OO_NO_CSELF", "OO_PACKAGE_NOT_VALID", "OO_NO_SUCH_PACKAGE", -
    "OO_NO_SUCH_LIBRARY", "OO_PACKAGE_NOT_AUTOMATIC", "OO_COLLATION_NOT_AUTOMATIC", -
    "OO_FUNCTION_NOT_AUTOMATIC")
  Do i = 1 To codes~items
    self~assertEquals(1004 + i, .ooSQLite~send(codes[i]), -
      "the constant" codes[i])
  End
  .ooSQLExtensions~getPackage("noSuchPackage")
  self~assertEquals(.ooSQLite~OO_NO_SUCH_PACKAGE, .ooSQLExtensions~lastErrCode, -
    "getPackage of an unknown package gives OO_NO_SUCH_PACKAGE")

::Method testExtensionResultCodeErrStr
  -- errStr returned "unknown error" for the codes 1005 to 1011
  Do code = 1005 To 1011
    self~assertTrue(.ooSQLite~errStr(code) \== "unknown error", -
      "errStr should describe" code":" .ooSQLite~errStr(code))
    self~assertEquals("[".ooSQLite~errStr(code)"]", "["oosqlErrStr(code)"]", -
      "oosqlErrStr should give the same description for" code)
  End
  self~assertEquals("[unknown error]", "[".ooSQLite~errStr(1012)"]", -
    "errStr of a code after the last one")

::Method testLoadPackageTooNew
  -- tooNewPackage needs ooSQLite 99.0.0: the package was refused, but the
  -- error was recorded where lastErrCode / lastErrMsg do not look
  self~assertFalse(.ooSQLExtensions~loadPackage(userExtLib("toonewpackage")), -
    "loadPackage of a package that needs a newer ooSQLite should fail")
  self~assertEquals(.ooSQLite~OO_PACKAGE_NOT_VALID, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be OO_PACKAGE_NOT_VALID")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~pos("requires ooSQLite version") > 0, -
    "lastErrMsg should say why:" .ooSQLExtensions~lastErrMsg)
  self~assertNull(.ooSQLExtensions~getPackage("tooNewPackage"), -
    "the package should not be kept")

::Method testPackageNewBadFile
  -- new with a file that does not load returned an invalid object, and any
  -- method sent to it crashed (SIGSEGV).  Now new raises the error.
  err = self~syntaxErrorOf(.ooSQLPackage, "NEW", userExtLib("nosuchpackage"))
  self~assertEquals("98.900", err~word(1), -
    "new of a missing file should raise error 98.900:" err)
  self~assertTrue(err~pos("nosuchpackage") > 0, -
    "the message should name the file:" err)

::Method testPackageNewNotAPackage
  -- a library that loads but is not an ooSQLite package
  err = self~syntaxErrorOf(.ooSQLPackage, "NEW", userExtLib("testlibrary"))
  self~assertEquals("98.900", err~word(1), -
    "new of a file that is not a package should raise error 98.900:" err)

::Method testPackageNewTooNew
  -- new did not check the version the package needs, as loadPackage does
  err = self~syntaxErrorOf(.ooSQLPackage, "NEW", userExtLib("toonewpackage"))
  self~assertEquals("98.900", err~word(1), -
    "new of a package that needs a newer ooSQLite should raise error 98.900:" err)
  self~assertTrue(err~pos("requires ooSQLite version: 99.0.0") > 0, -
    "the message should say why, with the versions as M.m.l:" err)

::Method testPackageNewIsNotManaged
  -- a package made with new works, but ooSQLExtensions does not know it
  package = .ooSQLPackage~new(userExtLib("examplepackage"))
  self~assertEquals(0, package~lastErrCode, "lastErrCode of a good package")
  self~assertTrue(.ooSQLExtensions~getPackage("examplePackage") \== package, -
    "getPackage should not return a package made with new")
  db = self~openMemoryDB
  self~assertEquals(0, package~register(db), "register should succeed")
  self~assertEquals(1.5, self~queryValue(db, "SELECT half(3) AS v;"), -
    "the package's functions should be registered")
  db~close

::Method testLibraryNewBadFile
  -- new with a file that does not load returned an invalid object, and
  -- getHandle on it crashed (SIGSEGV).  Now new raises the error.
  err = self~syntaxErrorOf(.ooSQLLibrary, "NEW", userExtLib("nosuchlibrary"))
  self~assertEquals("98.900", err~word(1), -
    "new of a missing file should raise error 98.900:" err)
  self~assertTrue(err~pos("nosuchlibrary") > 0, -
    "the message should name the file:" err)

::Method testLibraryNewNotALibrary
  -- a shared library that loads but is not an ooSQLite library
  err = self~syntaxErrorOf(.ooSQLLibrary, "NEW", userExtLib("simpleextension"))
  self~assertEquals("98.900", err~word(1), -
    "new of a file that is not an ooSQLite library should raise error 98.900:" err)

::Method testLibraryNewIsNotManaged
  -- a library made with new works, but ooSQLExtensions does not know it
  lib = .ooSQLLibrary~new(userExtLib("testlibrary"))
  self~assertEquals(0, lib~lastErrCode, "lastErrCode of a good library")
  self~assertTrue(.ooSQLExtensions~getLibrary("testlibrary") \== lib, -
    "getLibrary should not return a library made with new")
  self~assertTrue(lib~getHandle("reverse")~isA(.Pointer), -
    "getHandle should work")

::Method testPackageSubclassWithoutSuperInit
  -- a subclass whose init does not forward to ooSQLPackage's leaves an
  -- object without its C data: every method crashed (SIGSEGV)
  package = .PackageWithoutSuperInit~new
  calls = .array~of(.array~of("LASTERRCODE"), .array~of("LASTERRMSG"), -
    .array~of("GETCOLLATION", "reverse"), .array~of("GETCOLLATIONNEEDED"), -
    .array~of("GETFUNCTION", "half"), .array~of("REGISTER", self~openMemoryDB))
  Do call Over calls
    If call~items = 1 Then err = self~syntaxErrorOf(package, call[1])
    Else err = self~syntaxErrorOf(package, call[1], call[2])
    self~assertEquals("98.900", err~word(1), call[1] "should raise error 98.900:" err)
    self~assertTrue(err~pos("not initialized") > 0, -
      call[1] "should say the object was not initialized:" err)
  End

::Method testLibrarySubclassWithoutSuperInit
  -- the same for ooSQLLibrary
  lib = .LibraryWithoutSuperInit~new
  Do name Over .array~of("LASTERRCODE", "LASTERRMSG")
    err = self~syntaxErrorOf(lib, name)
    self~assertEquals("98.900", err~word(1), name "should raise error 98.900:" err)
  End
  err = self~syntaxErrorOf(lib, "GETHANDLE", "reverse")
  self~assertEquals("98.900", err~word(1), "GETHANDLE should raise error 98.900:" err)
  self~assertTrue(err~pos("not initialized") > 0, -
    "GETHANDLE should say the object was not initialized:" err)

::Method testAutoCollationNotAutomaticMessage
  -- the message said "collations X is not ..."
  self~loadTestPackage
  self~assertFalse(.ooSQLExtensions~autoCollation("testPackage", "reverse", .false), -
    "unmarking a collation that is not automatic should fail")
  self~assertEquals(.ooSQLite~OO_COLLATION_NOT_AUTOMATIC, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be OO_COLLATION_NOT_AUTOMATIC")
  self~assertEquals("[collation reverse is not an automatically registered collation]", -
    "[".ooSQLExtensions~lastErrMsg"]", "lastErrMsg")

/******************************************************************************/
/*                                                                            */
/* Section 34:ooSQLResult and ooSQLValue — the methods not used elsewhere    */
/*                                                                            */
/* The OO counterparts of the classic tests in Section C7, with UDFs from     */
/* ResultValueHandler: ooSQLResult blob, int64, zeroBlob, value, error,       */
/* errorCode, errorNoMem, errorTooBig; ooSQLValue blob, int64, numericType.   */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- Helper: register one ResultValueHandler method as a UDF                    --
--------------------------------------------------------------------------------

::Method resultValueUDF
  Use Strict Arg db, sqlName, countArgs, mthName
  rc = db~createFunction(sqlName, .ResultValueHandler~new, countArgs, mthName)
  self~assertEquals(0, rc, "createFunction for" sqlName "should return OK")

::Method testResultBlobValueBlob
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(d BLOB); INSERT INTO t VALUES(X'CAFEBABE');")
  self~resultValueUDF(db, "oo_blobthru", 1, "blobThru")
  stmt = .ooSQLiteStmt~new(db, "SELECT oo_blobthru(d) FROM t;")
  stmt~step
  self~assertEquals(.ooSQLite~BLOB, stmt~columnType(1), -
    "ooSQLResult~blob should produce a BLOB")
  self~assertEquals(4, stmt~columnBytes(1), "the blob should have 4 bytes")
  self~assertEquals("CAFEBABE", stmt~columnText(1)~c2x, -
    "ooSQLValue~blob and ooSQLResult~blob should keep the content")
  stmt~finalize
  db~close

::Method testResultBlobMutableBuffer
  db = self~openMemoryDB
  self~resultValueUDF(db, "oo_blobmb", 0, "blobMutableBuffer")
  self~resultValueUDF(db, "oo_blobpart", 0, "blobPartial")
  stmt = .ooSQLiteStmt~new(db, "SELECT oo_blobmb(), oo_blobpart();")
  stmt~step
  self~assertEquals(.ooSQLite~BLOB, stmt~columnType(1), -
    "ooSQLResult~blob with a MutableBuffer should produce a BLOB")
  self~assertEquals("00FF10", stmt~columnText(1)~c2x, -
    "the MutableBuffer content should be kept")
  self~assertEquals("AB", stmt~columnText(2), -
    "size limits the bytes taken from a String")
  stmt~finalize
  db~close

::Method testValueBlob
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(d BLOB); INSERT INTO t VALUES(X'CAFEBABE');")
  self~resultValueUDF(db, "oo_blobhex", 1, "blobHex")
  stmt = .ooSQLiteStmt~new(db, "SELECT oo_blobhex(d) FROM t;")
  stmt~step
  self~assertEquals("CAFEBABE", stmt~columnText(1), -
    "ooSQLValue~blob should return the bytes of the blob as a string")
  stmt~finalize
  db~close

::Method testValueBlobEmptyAndNull
  -- an empty blob is "", NULL is .nil, any other value its bytes
  db = self~openMemoryDB
  self~resultValueUDF(db, "oo_blobkind", 1, "blobKind")
  stmt = .ooSQLiteStmt~new(db, "SELECT oo_blobkind(X'CAFE'), oo_blobkind(X'')," -
    "oo_blobkind(NULL), oo_blobkind('ab'), oo_blobkind(12);")
  stmt~step
  self~assertEquals("[CAFE]", stmt~columnText(1), "ooSQLValue~blob of a blob")
  self~assertEquals("[]", stmt~columnText(2), "ooSQLValue~blob of an empty blob is the empty string")
  self~assertEquals("NIL", stmt~columnText(3), "ooSQLValue~blob of NULL is .nil")
  self~assertEquals("[6162]", stmt~columnText(4), "ooSQLValue~blob of a text")
  self~assertEquals("[3132]", stmt~columnText(5), "ooSQLValue~blob of an integer")
  stmt~finalize
  db~close

::Method testColumnDoublePrecision
  db = self~openMemoryDB
  Do case Over doubleCases()
    stmt = .ooSQLiteStmt~new(db, "SELECT" case[1]";")
    stmt~step
    self~assertEquals("["case[2]"]", "["stmt~columnDouble(1)"]", "columnDouble of" case[1])
    stmt~finalize
  End
  db~close

::Method testValueDoublePrecision
  db = self~openMemoryDB
  self~resultValueUDF(db, "oo_dbltext", 1, "doubleText")
  Do case Over doubleCases()
    stmt = .ooSQLiteStmt~new(db, "SELECT oo_dbltext("case[1]");")
    stmt~step
    self~assertEquals("["case[2]"]", "["stmt~columnText(1)"]", "ooSQLValue~double of" case[1])
    stmt~finalize
  End
  db~close

::Method testResultInt64ValueInt64
  db = self~openMemoryDB
  self~resultValueUDF(db, "oo_int64", 1, "int64Thru")
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT oo_int64(9223372036854775807), oo_int64(-9223372036854775808);")
  stmt~step
  self~assertEquals(.ooSQLite~INTEGER, stmt~columnType(1), -
    "ooSQLResult~int64 should produce an INTEGER")
  self~assertEquals("9223372036854775807", stmt~columnText(1), -
    "INT64_MAX should go through ooSQLValue~int64 and ooSQLResult~int64")
  self~assertEquals("-9223372036854775808", stmt~columnText(2), -
    "INT64_MIN should go through ooSQLValue~int64 and ooSQLResult~int64")
  stmt~finalize
  db~close

::Method testValueNumericType
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(val); INSERT INTO t VALUES('42'); INSERT INTO t VALUES('3.14');" -
    "INSERT INTO t VALUES('hello'); INSERT INTO t VALUES(42); INSERT INTO t VALUES(3.14);")
  self~resultValueUDF(db, "oo_numtype", 1, "numericType")
  stmt = .ooSQLiteStmt~new(db, "SELECT oo_numtype(val) FROM t ORDER BY rowid;")
  expected = .Array~of("3,1", "3,2", "3,3", "1,1", "2,2")
  Do i = 1 To expected~items
    stmt~step
    self~assertEquals(expected[i], stmt~columnText(1), -
      "type,numericType of row" i)
  End
  stmt~finalize
  db~close

::Method testResultZeroBlob
  db = self~openMemoryDB
  self~resultValueUDF(db, "oo_zeroblob", 1, "zeroBlob")
  stmt = .ooSQLiteStmt~new(db, "SELECT oo_zeroblob(10);")
  stmt~step
  self~assertEquals(.ooSQLite~BLOB, stmt~columnType(1), -
    "ooSQLResult~zeroBlob should produce a BLOB")
  self~assertEquals(10, stmt~columnBytes(1), "zeroBlob(10) should have 10 bytes")
  self~assertEquals(Copies("00", 10), stmt~columnText(1)~c2x, -
    "zeroBlob(10) should be 10 zero bytes")
  stmt~finalize
  db~close

::Method testResultValue
  db = self~openMemoryDB
  self~resultValueUDF(db, "oo_valthru", 1, "valueThru")
  stmt = .ooSQLiteStmt~new(db, "SELECT oo_valthru(42), oo_valthru('hello'), oo_valthru(NULL);")
  stmt~step
  self~assertEquals(.ooSQLite~INTEGER, stmt~columnType(1), "ooSQLResult~value keeps INTEGER")
  self~assertEquals(42, stmt~columnInt(1), "ooSQLResult~value keeps 42")
  self~assertEquals(.ooSQLite~TEXT, stmt~columnType(2), "ooSQLResult~value keeps TEXT")
  self~assertEquals("hello", stmt~columnText(2), "ooSQLResult~value keeps 'hello'")
  -- .ooSQLite~NULL is the null object attribute, so use the type value: 5
  self~assertEquals(5, stmt~columnType(3), "ooSQLResult~value keeps NULL")
  stmt~finalize
  db~close

::Method stepErrorUDF
  Use Strict Arg sqlName, mthName
  db = self~openMemoryDB
  self~resultValueUDF(db, sqlName, 0, mthName)
  stmt = .ooSQLiteStmt~new(db, "SELECT" sqlName"();")
  rc = stmt~step
  info = .Directory~new
  info~rc = rc; info~errCode = db~errCode; info~errMsg = db~errMsg
  stmt~finalize
  db~close
  Return info

::Method testResultError
  info = self~stepErrorUDF("oo_err", "error")
  self~assertEquals(.ooSQLite~ERROR, info~rc, "ooSQLResult~error makes step return ERROR")
  self~assertEquals("Custom OO UDF error", info~errMsg, -
    "ooSQLResult~error sets the message")

::Method testResultErrorCode
  info = self~stepErrorUDF("oo_errcode", "errorCode")
  self~assertEquals(.ooSQLite~FULL, info~rc, "ooSQLResult~errorCode(13) makes step return FULL")
  self~assertEquals(.ooSQLite~FULL, info~errCode, "errCode should be FULL")

::Method testResultErrorNoMem
  info = self~stepErrorUDF("oo_errnomem", "errorNoMem")
  self~assertEquals(.ooSQLite~NOMEM, info~rc, "ooSQLResult~errorNoMem makes step return NOMEM")
  self~assertEquals(.ooSQLite~NOMEM, info~errCode, "errCode should be NOMEM")

::Method testResultErrorTooBig
  info = self~stepErrorUDF("oo_errtoobig", "errorTooBig")
  self~assertEquals(.ooSQLite~TOOBIG, info~rc, "ooSQLResult~errorTooBig makes step return TOOBIG")
  self~assertEquals(.ooSQLite~TOOBIG, info~errCode, "errCode should be TOOBIG")

