--------------------------------------------------------------------------------

::Method testClassicCallbackCreateCollationUserData
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES('banana');"
  Call oosqlExec db, "INSERT INTO t VALUES('Apple');"
