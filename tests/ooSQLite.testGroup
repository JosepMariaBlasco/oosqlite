--------------------------------------------------------------------------------

::Method testClassicCallbackCreateFunctionScalarInt
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(5);"
  Call oosqlExec db, "INSERT INTO t VALUES(10);"
  ret = oosqlCreateFunction(db, "cl_double", 1, "classicScalarDoubleCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction scalar should return OK")
  rs = oosqlExec(db, -
    "SELECT cl_double(x) AS dbl FROM t ORDER BY x;", .true, 2)
  self~assertEquals(10, rs[1]["DBL"], -
    "cl_double(5) should return 10")
  self~assertEquals(20, rs[2]["DBL"], -
    "cl_double(10) should return 20")
  Call oosqlClose db

