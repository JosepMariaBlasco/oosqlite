/******************************************************************************/
/*                                                                            */
/* Section 23: Tier 2 — updateHook                                            */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- updateHook: INSERT operation                                               --
--------------------------------------------------------------------------------

::Method testUpdateHookInsert
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);", .true)
  handler = .UpdateHookHandler~new
  db~updateHook(handler)
  db~exec("INSERT INTO t VALUES(1, 'Alice');", .true)
  self~assertEquals(1, handler~callCount, -
    "updateHook should fire once for INSERT")
  ev = handler~events[1]
  self~assertEquals(.ooSQLite~INSERT, ev~entry("op"), -
    "updateHook op should be INSERT")
  self~assertEquals("main", ev~entry("dbName"), -
    "updateHook dbName should be 'main'")
  self~assertEquals("t", ev~entry("tableName"), -
    "updateHook tableName should be 't'")
  self~assertEquals(1, ev~entry("rowID"), -
    "updateHook rowID should be 1")
  db~close

--------------------------------------------------------------------------------
-- updateHook: UPDATE and DELETE operations                                   --
--------------------------------------------------------------------------------

::Method testUpdateHookUpdateDelete
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);", .true)
  db~exec("INSERT INTO t VALUES(1, 'Alice');", .true)
  handler = .UpdateHookHandler~new
  db~updateHook(handler)
  -- UPDATE
  db~exec("UPDATE t SET name='Bob' WHERE id=1;", .true)
  self~assertEquals(1, handler~callCount, -
    "updateHook should fire for UPDATE")
  ev = handler~events[1]
  self~assertEquals(.ooSQLite~UPDATE, ev~entry("op"), -
    "updateHook op should be UPDATE")
  -- DELETE
  db~exec("DELETE FROM t WHERE id=1;", .true)
  self~assertEquals(2, handler~callCount, -
    "updateHook should fire for DELETE")
  ev = handler~events[2]
  self~assertEquals(.ooSQLite~DELETE, ev~entry("op"), -
    "updateHook op should be DELETE")
  db~close

--------------------------------------------------------------------------------
-- updateHook: deregistration                                                 --
--------------------------------------------------------------------------------

::Method testUpdateHookDeregister
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);", .true)
  handler = .UpdateHookHandler~new
  db~updateHook(handler)
  db~exec("INSERT INTO t VALUES(1, 'Alice');", .true)
  self~assertTrue(handler~callCount > 0, -
    "updateHook should fire before deregister")
  -- Deregister
  db~updateHook(.nil)
  handler~reset
  db~exec("INSERT INTO t VALUES(2, 'Bob');", .true)
  self~assertEquals(0, handler~callCount, -
    "updateHook should not fire after deregister")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 24: Tier 2 — trace                                                 */
/*                                                                            */
/* NOTE: In SQLite 3.29, trace and profile share the same internal callback   */
/* slot. Registering one replaces the other. See testTraceMutuallyExclusive.  */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- trace: basic registration and invocation                                   --
--------------------------------------------------------------------------------

::Method testTrace
  db = self~openMemoryDB
  handler = .TraceHandler~new
  db~trace(handler)
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertEquals(2, handler~callCount, -
    "trace should fire for each SQL statement")
  -- Verify captured SQL text
  self~assertTrue(handler~statements[1]~caselessPos("CREATE TABLE") > 0, -
    "trace should capture CREATE TABLE SQL")
  self~assertTrue(handler~statements[2]~caselessPos("INSERT") > 0, -
    "trace should capture INSERT SQL")
  db~close

--------------------------------------------------------------------------------
-- trace: deregistration                                                      --
--------------------------------------------------------------------------------

::Method testTraceDeregister
  db = self~openMemoryDB
  handler = .TraceHandler~new
  db~trace(handler)
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  self~assertTrue(handler~callCount > 0, -
    "trace should fire before deregister")
  -- Deregister
  db~trace(.nil)
  handler~reset
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertEquals(0, handler~callCount, -
    "trace should not fire after deregister")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 25: Tier 2 — profile                                               */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- profile: basic registration and invocation                                 --
--------------------------------------------------------------------------------

::Method testProfile
  db = self~openMemoryDB
  handler = .ProfileHandler~new
  db~profile(handler)
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertEquals(2, handler~callCount, -
    "profile should fire for each SQL statement")
  -- Verify captured data
  entry = handler~entries[1]
  self~assertTrue(entry~entry("sql")~caselessPos("CREATE TABLE") > 0, -
    "profile should capture SQL text")
  self~assertTrue(entry~entry("nanoSeconds")~dataType("W"), -
    "profile nanoSeconds should be a whole number")
  db~close

--------------------------------------------------------------------------------
-- profile: deregistration                                                    --
--------------------------------------------------------------------------------

::Method testProfileDeregister
  db = self~openMemoryDB
  handler = .ProfileHandler~new
  db~profile(handler)
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  self~assertTrue(handler~callCount > 0, -
    "profile should fire before deregister")
  -- Deregister
  db~profile(.nil)
  handler~reset
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertEquals(0, handler~callCount, -
    "profile should not fire after deregister")
  db~close

--------------------------------------------------------------------------------
-- trace and profile are mutually exclusive in SQLite 3.29                    --
-- Registering one replaces the other (they share the same internal slot).    --
--------------------------------------------------------------------------------

::Method testTraceMutuallyExclusiveWithProfile
  db = self~openMemoryDB
  traceH = .TraceHandler~new
  profileH = .ProfileHandler~new
  -- Register trace first, then profile
  db~trace(traceH)
  db~profile(profileH)
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  -- Only profile should fire; trace should have been replaced
  self~assertEquals(0, traceH~callCount, -
    "trace should not fire when profile was registered last")
  self~assertTrue(profileH~callCount > 0, -
    "profile should fire when registered after trace")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 26: Tier 2 — progressHandler                                       */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- progressHandler: basic registration and invocation                         --
--------------------------------------------------------------------------------

::Method testProgressHandler
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, val TEXT);", .true)
  db~exec("BEGIN;")
  Do i = 1 To 100
    db~exec("INSERT INTO t VALUES("i", 'row_"i"');", .true)
  End
  db~exec("COMMIT;")
  -- Register progress handler: callback every 10 VM instructions
  handler = .ProgressHandler~new
  db~progressHandler(handler, 10)
  -- A sorted query over 100 rows should generate many VM instructions
  db~exec("SELECT * FROM t ORDER BY val;", .true)
  self~assertTrue(handler~callCount > 0, -
    "progressHandler should be invoked during query")
  db~progressHandler(.nil, 0)
  db~close

--------------------------------------------------------------------------------
-- progressHandler: interruption via InterruptingProgressHandler              --
--------------------------------------------------------------------------------

::Method testProgressHandlerInterrupt
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, val TEXT);", .true)
  db~exec("BEGIN;")
  Do i = 1 To 100
    db~exec("INSERT INTO t VALUES("i", 'row_"i"');", .true)
  End
  db~exec("COMMIT;")
  -- Interrupt after 5 progress invocations
  handler = .InterruptingProgressHandler~new(5)
  db~progressHandler(handler, 10)
  db~exec("SELECT * FROM t ORDER BY val;", .true)
  -- The query should have been interrupted
  self~assertEquals(.ooSQLite~INTERRUPT, db~errCode, -
    "errCode should be INTERRUPT after progress interruption")
  self~assertTrue(handler~callCount >= 5, -
    "InterruptingProgressHandler should have been called at least 5 times")
  db~progressHandler(.nil, 0)
  db~close

--------------------------------------------------------------------------------
-- progressHandler: deregistration                                            --
--------------------------------------------------------------------------------

::Method testProgressHandlerDeregister
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, val TEXT);", .true)
  db~exec("BEGIN;")
  Do i = 1 To 100
    db~exec("INSERT INTO t VALUES("i", 'row_"i"');", .true)
  End
  db~exec("COMMIT;")
  handler = .ProgressHandler~new
  db~progressHandler(handler, 10)
  db~exec("SELECT * FROM t ORDER BY val;", .true)
  self~assertTrue(handler~callCount > 0, -
    "progressHandler should fire before deregister")
  -- Deregister
  db~progressHandler(.nil, 0)
  handler~reset
  db~exec("SELECT * FROM t ORDER BY val;", .true)
  self~assertEquals(0, handler~callCount, -
    "progressHandler should not fire after deregister")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 27: Tier 2 — busyHandler                                           */
/*                                                                            */
/* busyHandler requires two connections to the same file-based database to    */
/* provoke SQLITE_BUSY via lock contention.                                   */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- busyHandler: basic registration and lock contention                        --
--------------------------------------------------------------------------------

::Method testBusyHandler
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_busy.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBusyCleanup
  Call SysFileDelete dbFile
  -- Create the database and a table
  db1 = .ooSQLiteConnection~new(dbFile)
  self~assertEquals(db1~OK, db1~initCode, "db1 should open OK")
  db1~exec("CREATE TABLE t(x INTEGER);", .true)
  db1~exec("INSERT INTO t VALUES(1);", .true)
  -- db1 holds an exclusive lock
  db1~exec("BEGIN IMMEDIATE;")
  -- db2 opens the same file
  db2 = .ooSQLiteConnection~new(dbFile)
  self~assertEquals(db2~OK, db2~initCode, "db2 should open OK")
  -- Register busy handler on db2
  handler = .BusyHandler~new(3)
  db2~busyHandler(handler)
  -- db2 tries to write — should invoke busy handler, then get BUSY
  rc = db2~exec("INSERT INTO t VALUES(2);")
  self~assertEquals(db2~BUSY, rc, -
    "db2 INSERT should return BUSY after handler gives up")
  self~assertTrue(handler~callCount > 0, -
    "busyHandler should have been invoked at least once")
  -- Clean up
  db1~exec("ROLLBACK;")
  db1~close
  db2~close
  Call SysFileDelete dbFile
  Return

TestBusyCleanup:
  db1~close
  db2~close
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- busyHandler: userData propagation                                          --
--------------------------------------------------------------------------------

::Method testBusyHandlerUserData
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_busy_ud.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBusyUDCleanup
  Call SysFileDelete dbFile
  db1 = .ooSQLiteConnection~new(dbFile)
  db1~exec("CREATE TABLE t(x INTEGER);", .true)
  db1~exec("INSERT INTO t VALUES(1);", .true)
  db1~exec("BEGIN IMMEDIATE;")
  db2 = .ooSQLiteConnection~new(dbFile)
  -- Register with userData
  handler = .BusyHandler~new(2)
  myData = "busy_user_data"
  db2~busyHandler(handler,, myData)
  db2~exec("INSERT INTO t VALUES(2);")
  -- BusyHandler doesn't store userData, but we can verify it was called
  self~assertTrue(handler~callCount > 0, -
    "busyHandler should be invoked with userData")
  -- Clean up
  db1~exec("ROLLBACK;")
  db1~close
  db2~close
  Call SysFileDelete dbFile
  Return

TestBusyUDCleanup:
  db1~close
  db2~close
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- busyHandler: deregistration                                                --
--------------------------------------------------------------------------------

::Method testBusyHandlerDeregister
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_busy_dereg.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBusyDeregCleanup
  Call SysFileDelete dbFile
  db1 = .ooSQLiteConnection~new(dbFile)
  db1~exec("CREATE TABLE t(x INTEGER);", .true)
  db1~exec("INSERT INTO t VALUES(1);", .true)
  db2 = .ooSQLiteConnection~new(dbFile)
  -- Register then deregister
  handler = .BusyHandler~new(3)
  db2~busyHandler(handler)
  db2~busyHandler(.nil)
  -- Lock and try write — handler should NOT be invoked
  db1~exec("BEGIN IMMEDIATE;")
  rc = db2~exec("INSERT INTO t VALUES(2);")
  self~assertEquals(db2~BUSY, rc, -
    "db2 INSERT should return BUSY immediately after deregister")
  self~assertEquals(0, handler~callCount, -
    "busyHandler should not be invoked after deregister")
  -- Clean up
  db1~exec("ROLLBACK;")
  db1~close
  db2~close
  Call SysFileDelete dbFile
  Return

TestBusyDeregCleanup:
  db1~close
  db2~close
  Call SysFileDelete dbFile

/******************************************************************************/
/*                                                                            */
/* Section 28: Tier 2 — setAuthorizer                                         */
/*                                                                            */
/* setAuthorizer used to cause SIGSEGV as soon as any SQL was compiled:       */
/* authorizerCallback() converted the four detail strings without checking    */
/* for NULL, which SQLite passes when a string does not apply (technical      */
/* note #16). Those arguments are now the empty string, as documented.        */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- setAuthorizer: registration and deregistration                             --
--------------------------------------------------------------------------------

::Method testSetAuthorizerRegistration
  db = self~openMemoryDB
  handler = .AuthorizerHandler~new
  rc = db~setAuthorizer(handler)
  self~assertEquals(db~OK, rc, -
    "setAuthorizer registration should return OK")
  rc = db~setAuthorizer(.nil)
  self~assertEquals(db~OK, rc, -
    "setAuthorizer(.nil) deregistration should return OK")
  db~close

--------------------------------------------------------------------------------
-- setAuthorizer: the callback runs and gets its arguments (note #16)         --
--------------------------------------------------------------------------------

::Method testSetAuthorizerCallback
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x TEXT);")
  handler = .AuthorizerHandler~new
  db~setAuthorizer(handler)
  db~exec("SELECT x FROM t;", .true)
  db~setAuthorizer(.nil)
  self~assertEquals(2, handler~callCount, -
    "SELECT x FROM t should be authorized twice: SELECT and READ")
  -- SELECT: SQLite passes NULL for all four strings
  e = handler~events[1]
  self~assertEquals(db~SELECT, e~code, "First action should be SELECT")
  self~assertEquals("", e~str1, "SELECT: str1 should be the empty string")
  self~assertEquals("", e~str2, "SELECT: str2 should be the empty string")
  self~assertEquals("", e~str3, "SELECT: str3 should be the empty string")
  self~assertEquals("", e~str4, "SELECT: str4 should be the empty string")
  -- READ: table, column, database; no trigger or view
  e = handler~events[2]
  self~assertEquals(db~READ, e~code, "Second action should be READ")
  self~assertEquals("t", e~str1, "READ: str1 should be the table name")
  self~assertEquals("x", e~str2, "READ: str2 should be the column name")
  self~assertEquals("main", e~str3, "READ: str3 should be the database name")
  self~assertEquals("", e~str4, "READ: str4 should be the empty string")
  db~close

--------------------------------------------------------------------------------
-- setAuthorizer: DENY rejects the statement                                  --
--------------------------------------------------------------------------------

::Method testSetAuthorizerDeny
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x TEXT);")
  handler = .AuthorizerHandler~new
  handler~denyAction = db~INSERT
  db~setAuthorizer(handler)
  rc = db~exec("INSERT INTO t VALUES('a');")
  self~assertEquals(db~AUTH, rc, -
    "A denied INSERT should fail with AUTH")
  self~assertEquals("not authorized", db~errMsg, -
    "A denied INSERT should report 'not authorized'")
  db~setAuthorizer(.nil)
  rows = db~exec("SELECT x FROM t;", .true)
  self~assertEquals(0, rows~items, "The denied INSERT should not add a row")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 29: Tier 3 — ooSQLExtensions: builtin extensions                   */
/*                                                                            */
/* The ooSQLExtensions class manages SQLite extensions that are statically     */
/* linked into liboosqlite.so. These tests cover listBuiltins,                */
/* registerBuiltin, autoBuiltin, cancelAutoBuiltin, and resetAutoBuiltin.      */
/*                                                                            */
/* All ten builtins are available (with SQLite 3.29.0 only eight were, base64 */
/* and csv were missing).                                                     */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- listBuiltins: returns an Array with 10 entries, each a Directory           --
--------------------------------------------------------------------------------

::Method testListBuiltins
  builtins = .ooSQLExtensions~listBuiltins
  self~assertTrue(builtins~isA(.Array), -
    "listBuiltins should return an Array")
  self~assertEquals(10, builtins~items, -
    "listBuiltins should return 10 entries")
  -- Verify each entry is a Directory with NAME and DESCRIPTION
  entry = builtins[1]
  self~assertTrue(entry~isA(.Directory), -
    "each entry should be a Directory")
  self~assertTrue(entry["NAME"]~length > 0, -
    "each entry should have a NAME")
  self~assertTrue(entry["DESCRIPTION"]~length > 0, -
    "each entry should have a DESCRIPTION")

--------------------------------------------------------------------------------
-- listBuiltins: verify expected names                                        --
--------------------------------------------------------------------------------

::Method testListBuiltinsNames
  builtins = .ooSQLExtensions~listBuiltins
  names = .Set~new
  Do i = 1 To builtins~items
    names~put(builtins[i]["NAME"])
  End
  expected = .Array~of("base64", "csv", "ieee754", "nextChar", -
    "percentile", "regExp", "rot13", "spellFix", "toType", "wholeNumber")
  Do name Over expected
    self~assertTrue(names~hasIndex(name), -
      "listBuiltins should include" name)
  End

--------------------------------------------------------------------------------
-- registerBuiltin: register a single extension by name                       --
--------------------------------------------------------------------------------

::Method testRegisterBuiltinSingle
  db = self~openMemoryDB
  rc = .ooSQLExtensions~registerBuiltin(db, "rot13")
  self~assertEquals(0, rc, -
    "registerBuiltin('rot13') should return SQLITE_OK")
  rows = db~exec("SELECT rot13('hello') AS val;", .true)
  self~assertEquals("uryyb", rows[1]["VAL"], -
    "rot13('hello') should return 'uryyb'")
  db~close

--------------------------------------------------------------------------------
-- registerBuiltin: register all extensions (no argument)                     --
--------------------------------------------------------------------------------

::Method testRegisterBuiltinAll
  db = self~openMemoryDB
  rc = .ooSQLExtensions~registerBuiltin(db)
  self~assertEquals(0, rc, -
    "registerBuiltin(db) should return SQLITE_OK")
  -- Verify rot13 works
  rows = db~exec("SELECT rot13('abc') AS val;", .true)
  self~assertEquals("nop", rows[1]["VAL"], -
    "rot13('abc') should return 'nop'")
  -- Verify ieee754 works
  rows2 = db~exec("SELECT typeof(ieee754(3.14)) AS val;", .true)
  self~assertEquals("text", rows2[1]["VAL"], -
    "ieee754(3.14) should return a text value")
  -- Verify toType works
  rows3 = db~exec("SELECT tointeger(42) AS val;", .true)
  self~assertEquals(42, rows3[1]["VAL"], -
    "tointeger(42) should return 42")
  db~close

--------------------------------------------------------------------------------
-- registerBuiltin: register with 'ALL' keyword                              --
--------------------------------------------------------------------------------

::Method testRegisterBuiltinAllKeyword
  db = self~openMemoryDB
  rc = .ooSQLExtensions~registerBuiltin(db, "ALL")
  self~assertEquals(0, rc, -
    "registerBuiltin(db, 'ALL') should return SQLITE_OK")
  rows = db~exec("SELECT rot13('test') AS val;", .true)
  self~assertEquals("grfg", rows[1]["VAL"], -
    "rot13 should be available after 'ALL'")
  db~close

--------------------------------------------------------------------------------
-- registerBuiltin: register an array of extensions                           --
--------------------------------------------------------------------------------

::Method testRegisterBuiltinArray
  db = self~openMemoryDB
  names = .Array~of("rot13", "ieee754")
  rc = .ooSQLExtensions~registerBuiltin(db, names)
  self~assertEquals(0, rc, -
    "registerBuiltin(db, array) should return SQLITE_OK")
  -- rot13 should work
  rows = db~exec("SELECT rot13('xyz') AS val;", .true)
  self~assertEquals("klm", rows[1]["VAL"], -
    "rot13('xyz') should return 'klm' after array registration")
  -- ieee754 should work
  rows2 = db~exec("SELECT ieee754(1.0) AS val;", .true)
  self~assertTrue(rows2[1]["VAL"]~length > 0, -
    "ieee754(1.0) should return a non-empty string after array registration")
  db~close

--------------------------------------------------------------------------------
-- registerBuiltin: invalid name returns SQLITE_MISUSE                        --
--------------------------------------------------------------------------------

::Method testRegisterBuiltinInvalidName
  db = self~openMemoryDB
  rc = .ooSQLExtensions~registerBuiltin(db, "noExiste")
  self~assertEquals(21, rc, -
    "registerBuiltin with invalid name should return SQLITE_MISUSE (21)")
  self~assertEquals(21, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be SQLITE_MISUSE")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~length > 0, -
    "lastErrMsg should be non-empty after error")
  db~close

--------------------------------------------------------------------------------
-- registerBuiltin: verify function not available before registration         --
--------------------------------------------------------------------------------

::Method testRegisterBuiltinNotAvailableBefore
  db = self~openMemoryDB
  -- rot13 should NOT be available in a fresh connection
  rc = db~exec("SELECT rot13('test');")
  self~assertEquals(1, rc, -
    "rot13 should not be available before registerBuiltin")
  -- Now register and verify it works
  .ooSQLExtensions~registerBuiltin(db, "rot13")
  rows = db~exec("SELECT rot13('test') AS val;", .true)
  self~assertEquals("grfg", rows[1]["VAL"], -
    "rot13 should work after registerBuiltin")
  db~close

--------------------------------------------------------------------------------
-- registerBuiltin: regExp extension provides REGEXP operator                 --
--------------------------------------------------------------------------------

::Method testRegisterBuiltinRegExp
  db = self~openMemoryDB
  .ooSQLExtensions~registerBuiltin(db, "regExp")
  rows = db~exec("SELECT 'hello world' REGEXP 'hello' AS val;", .true)
  self~assertEquals(1, rows[1]["VAL"], -
    "REGEXP match should return 1")
  rows2 = db~exec("SELECT 'hello world' REGEXP '^world' AS val;", .true)
  self~assertEquals(0, rows2[1]["VAL"], -
    "REGEXP non-match should return 0")
  db~close

--------------------------------------------------------------------------------
-- autoBuiltin: single extension is available in new connections              --
--------------------------------------------------------------------------------

::Method testAutoBuiltinSingle
  Signal On Syntax Name TestAutoSingleCleanup
  -- Ensure clean state
  .ooSQLExtensions~resetAutoBuiltin
  -- Auto-register rot13
  rc = .ooSQLExtensions~autoBuiltin("rot13")
  self~assertEquals(0, rc, -
    "autoBuiltin('rot13') should return SQLITE_OK")
  -- New connection should have rot13 available
  db = .ooSQLiteConnection~new(":memory:")
  rows = db~exec("SELECT rot13('auto') AS val;", .true)
  self~assertEquals("nhgb", rows[1]["VAL"], -
    "rot13 should be auto-available in new connection")
  -- ieee754 should NOT be available
  rc2 = db~exec("SELECT ieee754(1.0);")
  self~assertEquals(1, rc2, -
    "ieee754 should NOT be auto-available")
  db~close
  .ooSQLExtensions~resetAutoBuiltin
  Return

TestAutoSingleCleanup:
  .ooSQLExtensions~resetAutoBuiltin

--------------------------------------------------------------------------------
-- autoBuiltin: all extensions available in new connections                    --
--------------------------------------------------------------------------------

::Method testAutoBuiltinAll
  Signal On Syntax Name TestAutoAllCleanup
  .ooSQLExtensions~resetAutoBuiltin
  rc = .ooSQLExtensions~autoBuiltin
  self~assertEquals(0, rc, -
    "autoBuiltin() should return SQLITE_OK")
  db = .ooSQLiteConnection~new(":memory:")
  -- rot13 should work
  rows = db~exec("SELECT rot13('all') AS val;", .true)
  self~assertEquals("nyy", rows[1]["VAL"], -
    "rot13 should be auto-available after autoBuiltin()")
  -- ieee754 should also work
  rows2 = db~exec("SELECT typeof(ieee754(1.0)) AS val;", .true)
  self~assertEquals("text", rows2[1]["VAL"], -
    "ieee754 should be auto-available after autoBuiltin()")
  db~close
  .ooSQLExtensions~resetAutoBuiltin
  Return

TestAutoAllCleanup:
  .ooSQLExtensions~resetAutoBuiltin

--------------------------------------------------------------------------------
-- cancelAutoBuiltin: cancels auto-registration of a single extension         --
--------------------------------------------------------------------------------

::Method testCancelAutoBuiltin
  Signal On Syntax Name TestCancelAutoCleanup
  .ooSQLExtensions~resetAutoBuiltin
  -- Auto-register rot13, then cancel it
  .ooSQLExtensions~autoBuiltin("rot13")
  rc = .ooSQLExtensions~cancelAutoBuiltin("rot13")
  self~assertEquals(0, rc, -
    "cancelAutoBuiltin('rot13') should return SQLITE_OK")
  -- New connection should NOT have rot13
  db = .ooSQLiteConnection~new(":memory:")
  rc2 = db~exec("SELECT rot13('test');")
  self~assertEquals(1, rc2, -
    "rot13 should NOT be available after cancelAutoBuiltin")
  db~close
  .ooSQLExtensions~resetAutoBuiltin
  Return

TestCancelAutoCleanup:
  .ooSQLExtensions~resetAutoBuiltin

--------------------------------------------------------------------------------
-- cancelAutoBuiltin: returns SQLITE_MISUSE when not auto-registered          --
--------------------------------------------------------------------------------

::Method testCancelAutoBuiltinNotRegistered
  Signal On Syntax Name TestCancelNotRegCleanup
  .ooSQLExtensions~resetAutoBuiltin
  rc = .ooSQLExtensions~cancelAutoBuiltin("rot13")
  self~assertEquals(21, rc, -
    "cancelAutoBuiltin should return SQLITE_MISUSE when not auto-registered")
  self~assertEquals(21, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be SQLITE_MISUSE")
  .ooSQLExtensions~resetAutoBuiltin
  Return

TestCancelNotRegCleanup:
  .ooSQLExtensions~resetAutoBuiltin

--------------------------------------------------------------------------------
-- resetAutoBuiltin: clears all auto-registrations                            --
--------------------------------------------------------------------------------

::Method testResetAutoBuiltin
  Signal On Syntax Name TestResetCleanup
  -- Auto-register all, then reset
  .ooSQLExtensions~autoBuiltin
  rc = .ooSQLExtensions~resetAutoBuiltin
  self~assertEquals(0, rc, -
    "resetAutoBuiltin should return SQLITE_OK")
  -- New connection should have nothing auto-registered
  db = .ooSQLiteConnection~new(":memory:")
  rc2 = db~exec("SELECT rot13('test');")
  self~assertEquals(1, rc2, -
    "rot13 should NOT be available after resetAutoBuiltin")
  rc3 = db~exec("SELECT ieee754(1.0);")
  self~assertEquals(1, rc3, -
    "ieee754 should NOT be available after resetAutoBuiltin")
  db~close
  Return

TestResetCleanup:
  .ooSQLExtensions~resetAutoBuiltin

--------------------------------------------------------------------------------
-- lastErrCode / lastErrMsg: updated on error, reset on success               --
--------------------------------------------------------------------------------

::Method testExtensionsLastErrCodeLastErrMsg
  db = self~openMemoryDB
  -- Trigger an error
  .ooSQLExtensions~registerBuiltin(db, "noExiste")
  self~assertEquals(21, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be SQLITE_MISUSE after error")
  self~assertTrue(.ooSQLExtensions~lastErrMsg~pos("noExiste") > 0, -
    "lastErrMsg should mention the invalid name")
  -- Successful operation should reset the error
  .ooSQLExtensions~registerBuiltin(db, "rot13")
  self~assertEquals(0, .ooSQLExtensions~lastErrCode, -
    "lastErrCode should be 0 after successful operation")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 30: Tier 3B — createFunction: user-defined functions in Rexx       */
/*                                                                            */
/* Tests cover scalar UDFs (int, text, double, null results), variable args,  */
/* userData, aggregate UDFs, ooSQLValue methods (type, text, int, double,     */
/* bytes), and deregistration. Handler classes are in                         */
/* ooSQLite-TestSuite-Callbacks.cls.                                          */
/*                                                                            */
/* Aggregate UDFs over no rows used to cause SIGSEGV (technical note #20);    */
/* fixed, see testCreateFunctionAggregateEmpty.                               */
/*                                                                            */
/* Deregistration with createFunction(name, .nil) used to leave the function  */
/* in place: SQLite only removes a function when the number of arguments      */
/* matches, and the C++ passed 0 (technical note #21). Fixed; see the         */
/* testCreateFunctionDeregister tests.                                        */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- createFunction: deregistration with .nil (technical note #21)              --
--------------------------------------------------------------------------------

::Method testCreateFunctionDeregister
  db = self~openMemoryDB
  handler = .ScalarIntDoubleHandler~new
  db~createFunction("my_double", handler, 1, "xFunc")
  rows = db~exec("SELECT my_double(21) AS val;", .true)
  self~assertEquals(42, rows[1]["VAL"], -
    "my_double should work before it is removed")
  -- The number of arguments is the one the function was registered with
  rc = db~createFunction("my_double", .nil)
  self~assertEquals(0, rc, -
    "createFunction(name, .nil) should return SQLITE_OK")
  db~exec("SELECT my_double(21) AS val;", .true)
  self~assertTrue(db~errMsg~caselessPos("no such function") > 0, -
    "A removed function should no longer exist:" db~errMsg)
  -- It can be registered again
  rc = db~createFunction("my_double", handler, 1, "xFunc")
  self~assertEquals(0, rc, "A removed function can be registered again")
  rows = db~exec("SELECT my_double(5) AS val;", .true)
  self~assertEquals(10, rows[1]["VAL"], -
    "my_double should work again after registering it again")
  db~close

--------------------------------------------------------------------------------
-- createFunction: deregistration with an explicit number of arguments        --
--------------------------------------------------------------------------------

::Method testCreateFunctionDeregisterCountArgs
  db = self~openMemoryDB
  handler = .ScalarIntDoubleHandler~new
  db~createFunction("my_double", handler, 1, "xFunc")
  rc = db~createFunction("my_double", .nil, 1)
  self~assertEquals(0, rc, -
    "createFunction(name, .nil, 1) should return SQLITE_OK")
  db~exec("SELECT my_double(21) AS val;", .true)
  self~assertTrue(db~errMsg~caselessPos("no such function") > 0, -
    "A removed function should no longer exist:" db~errMsg)
  db~close

--------------------------------------------------------------------------------
-- createFunction: deregistration with a number of arguments that does not    --
-- match leaves the registered function alone                                 --
--------------------------------------------------------------------------------

::Method testCreateFunctionDeregisterOtherCountArgs
  db = self~openMemoryDB
  handler = .ScalarIntDoubleHandler~new
  db~createFunction("my_double", handler, 1, "xFunc")
  -- There is no my_double with 2 arguments: the one with 1 must survive
  rc = db~createFunction("my_double", .nil, 2)
  self~assertEquals(0, rc, -
    "Removing a function that does not exist still returns SQLITE_OK")
  rows = db~exec("SELECT my_double(21) AS val;", .true)
  self~assertEquals(42, rows[1]["VAL"], -
    "my_double with 1 argument should still work")
  rc = db~createFunction("my_double", .nil)
  db~exec("SELECT my_double(21) AS val;", .true)
  self~assertTrue(db~errMsg~caselessPos("no such function") > 0, -
    "my_double should be gone once removed with its own count:" db~errMsg)
  db~close

--------------------------------------------------------------------------------
-- createFunction: two functions with the same name and a different number   --
-- of arguments                                                               --
--------------------------------------------------------------------------------

::Method testCreateFunctionSameNameTwoCounts
  db = self~openMemoryDB
  -- The handlers are not referenced anywhere else on purpose
  db~createFunction("f", .ScalarIntDoubleHandler~new, 1, "xFunc")
  db~createFunction("f", .ScalarConcatHandler~new, 2, "xFunc")
  self~churnMemory
  rows = db~exec("SELECT f(21) AS a, f('x', 'y') AS b;", .true)
  self~assertEquals(42, rows[1]["A"], "f with 1 argument should still work")
  self~assertEquals("xy", rows[1]["B"], "f with 2 arguments should work")
  -- Removing one of them leaves the other one alone
  rc = db~createFunction("f", .nil, 2)
  self~assertEquals(0, rc, "createFunction(f, .nil, 2) should return OK")
  self~churnMemory
  rows = db~exec("SELECT f(21) AS a;", .true)
  self~assertEquals(42, rows[1]["A"], -
    "f with 1 argument should survive the removal of f with 2")
  db~exec("SELECT f('x', 'y') AS b;", .true)
  self~assertTrue(db~errMsg~caselessPos("wrong number of arguments") > 0, -
    "f with 2 arguments should be gone:" db~errMsg)
  db~close

--------------------------------------------------------------------------------
-- createFunction: removal without a number of arguments removes them all     --
--------------------------------------------------------------------------------

::Method testCreateFunctionSameNameRemoveAll
  db = self~openMemoryDB
  db~createFunction("f", .ScalarIntDoubleHandler~new, 1, "xFunc")
  db~createFunction("F", .ScalarConcatHandler~new, 2, "xFunc")
  rc = db~createFunction("f", .nil)
  self~assertEquals(0, rc, "createFunction(f, .nil) should return OK")
  db~exec("SELECT f(21) AS a;", .true)
  self~assertTrue(db~errMsg~caselessPos("no such function") > 0, -
    "f with 1 argument should be gone:" db~errMsg)
  db~exec("SELECT f('x', 'y') AS b;", .true)
  self~assertTrue(db~errMsg~caselessPos("no such function") > 0, -
    "f with 2 arguments should be gone:" db~errMsg)
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF returning integer                               --
--------------------------------------------------------------------------------

::Method testCreateFunctionScalarInt
  db = self~openMemoryDB
  handler = .ScalarIntDoubleHandler~new
  rc = db~createFunction("my_double", handler, 1, "xFunc")
  self~assertEquals(0, rc, -
    "createFunction should return SQLITE_OK")
  rows = db~exec("SELECT my_double(21) AS val;", .true)
  self~assertEquals(42, rows[1]["VAL"], -
    "my_double(21) should return 42")
  rows2 = db~exec("SELECT my_double(0) AS val;", .true)
  self~assertEquals(0, rows2[1]["VAL"], -
    "my_double(0) should return 0")
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF handler is invoked (callCount)                  --
--------------------------------------------------------------------------------

::Method testCreateFunctionScalarInvocation
  db = self~openMemoryDB
  handler = .ScalarIntDoubleHandler~new
  db~createFunction("my_double", handler, 1, "xFunc")
  self~assertEquals(0, handler~callCount, -
    "callCount should be 0 before any query")
  db~exec("SELECT my_double(1);", .true)
  self~assertEquals(1, handler~callCount, -
    "callCount should be 1 after one query")
  db~exec("SELECT my_double(1);", .true)
  db~exec("SELECT my_double(1);", .true)
  self~assertEquals(3, handler~callCount, -
    "callCount should be 3 after three queries")
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF returning text (two arguments)                  --
--------------------------------------------------------------------------------

::Method testCreateFunctionScalarText
  db = self~openMemoryDB
  handler = .ScalarConcatHandler~new
  rc = db~createFunction("my_concat", handler, 2, "xFunc")
  self~assertEquals(0, rc, -
    "createFunction should return SQLITE_OK")
  rows = db~exec("SELECT my_concat('hello', ' world') AS val;", .true)
  self~assertEquals("hello world", rows[1]["VAL"], -
    "my_concat should concatenate two strings")
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF with userData                                   --
--------------------------------------------------------------------------------

::Method testCreateFunctionUserData
  db = self~openMemoryDB
  handler = .ScalarUserDataHandler~new
  -- userData is arg 7: (name, obj, nArgs, methodName, , , userData)
  rc = db~createFunction("prefixed", handler, 1, "xFunc",,, ">>")
  self~assertEquals(0, rc, -
    "createFunction with userData should return SQLITE_OK")
  rows = db~exec("SELECT prefixed('hello') AS val;", .true)
  self~assertEquals(">>hello", rows[1]["VAL"], -
    "prefixed should prepend userData to argument")
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF returning double                                --
--------------------------------------------------------------------------------

::Method testCreateFunctionScalarDouble
  db = self~openMemoryDB
  handler = .ScalarHalfHandler~new
  rc = db~createFunction("my_half", handler, 1, "xFunc")
  self~assertEquals(0, rc, -
    "createFunction should return SQLITE_OK")
  rows = db~exec("SELECT my_half(7.0) AS val;", .true)
  self~assertEquals("3.5", rows[1]["VAL"], -
    "my_half(7.0) should return 3.5")
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF returning NULL                                  --
--------------------------------------------------------------------------------

::Method testCreateFunctionScalarNull
  db = self~openMemoryDB
  handler = .ScalarNullHandler~new
  rc = db~createFunction("always_null", handler, 0, "xFunc")
  self~assertEquals(0, rc, -
    "createFunction should return SQLITE_OK")
  rows = db~exec("SELECT always_null() IS NULL AS val;", .true)
  self~assertEquals(1, rows[1]["VAL"], -
    "always_null() should return NULL")
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF with variable arguments (-1)                    --
--------------------------------------------------------------------------------

::Method testCreateFunctionVariableArgs
  db = self~openMemoryDB
  handler = .ScalarCountArgsHandler~new
  rc = db~createFunction("count_args", handler, -1, "xFunc")
  self~assertEquals(0, rc, -
    "createFunction with -1 args should return SQLITE_OK")
  rows = db~exec("SELECT count_args(1,2,3) AS val;", .true)
  self~assertEquals(3, rows[1]["VAL"], -
    "count_args(1,2,3) should return 3")
  rows2 = db~exec("SELECT count_args() AS val;", .true)
  self~assertEquals(0, rows2[1]["VAL"], -
    "count_args() should return 0")
  rows3 = db~exec("SELECT count_args('a','b','c','d','e') AS val;", .true)
  self~assertEquals(5, rows3[1]["VAL"], -
    "count_args with 5 args should return 5")
  db~close

--------------------------------------------------------------------------------
-- createFunction: ooSQLValue~type reports correct SQLite types                --
--------------------------------------------------------------------------------

::Method testCreateFunctionValueType
  db = self~openMemoryDB
  handler = .ScalarTypeHandler~new
  db~createFunction("val_type", handler, 1, "xFunc")
  db~exec("CREATE TABLE types(a INTEGER, b REAL, c TEXT, d BLOB, e);")
  db~exec("INSERT INTO types VALUES(42, 3.14, 'hello', X'CAFE', NULL);")
  rows = db~exec("SELECT val_type(a) AS val FROM types;", .true)
  self~assertEquals(1, rows[1]["VAL"], -
    "type of INTEGER should be 1 (SQLITE_INTEGER)")
  rows2 = db~exec("SELECT val_type(b) AS val FROM types;", .true)
  self~assertEquals(2, rows2[1]["VAL"], -
    "type of REAL should be 2 (SQLITE_FLOAT)")
  rows3 = db~exec("SELECT val_type(c) AS val FROM types;", .true)
  self~assertEquals(3, rows3[1]["VAL"], -
    "type of TEXT should be 3 (SQLITE_TEXT)")
  rows4 = db~exec("SELECT val_type(d) AS val FROM types;", .true)
  self~assertEquals(4, rows4[1]["VAL"], -
    "type of BLOB should be 4 (SQLITE_BLOB)")
  rows5 = db~exec("SELECT val_type(e) AS val FROM types;", .true)
  self~assertEquals(5, rows5[1]["VAL"], -
    "type of NULL should be 5 (SQLITE_NULL)")
  db~close

--------------------------------------------------------------------------------
-- createFunction: ooSQLValue~bytes reports correct byte count                --
--------------------------------------------------------------------------------

::Method testCreateFunctionValueBytes
  db = self~openMemoryDB
  handler = .ScalarBytesHandler~new
  db~createFunction("byte_count", handler, 1, "xFunc")
  rows = db~exec("SELECT byte_count('hello') AS val;", .true)
  self~assertEquals(5, rows[1]["VAL"], -
    "byte_count('hello') should return 5")
  rows2 = db~exec("SELECT byte_count(X'DEADBEEF') AS val;", .true)
  self~assertEquals(4, rows2[1]["VAL"], -
    "byte_count(X'DEADBEEF') should return 4")
  db~close

--------------------------------------------------------------------------------
-- createFunction: aggregate UDF (sum)                                        --
--------------------------------------------------------------------------------

::Method testCreateFunctionAggregateSum
  db = self~openMemoryDB
  db~exec("CREATE TABLE nums(x INTEGER);")
  db~exec("INSERT INTO nums VALUES(1);")
  db~exec("INSERT INTO nums VALUES(2);")
  db~exec("INSERT INTO nums VALUES(3);")
  db~exec("INSERT INTO nums VALUES(4);")
  handler = .AggregateSumHandler~new
  rc = db~createFunction("my_sum", handler, 1,, "xStep", "xFinal")
  self~assertEquals(0, rc, -
    "createFunction aggregate should return SQLITE_OK")
  rows = db~exec("SELECT my_sum(x) AS val FROM nums;", .true)
  self~assertEquals(10, rows[1]["VAL"], -
    "my_sum(1,2,3,4) should return 10")
  db~close

--------------------------------------------------------------------------------
-- createFunction: aggregate UDF over no rows (technical note #20)            --
--------------------------------------------------------------------------------

::Method testCreateFunctionAggregateEmpty
  db = self~openMemoryDB
  db~exec("CREATE TABLE nums(x INTEGER);")
  db~exec("INSERT INTO nums VALUES(1);")
  handler = .AggregateSumHandler~new
  db~createFunction("my_sum", handler, 1,, "xStep", "xFinal")
  -- xStep never runs, so xFinal gets .nil as the aggregate object
  rows = db~exec("SELECT my_sum(x) AS val FROM nums WHERE 0;", .true)
  self~assertEquals(1, rows~items, -
    "An aggregate over no rows should still return one row")
  self~assertEquals(0, rows[1]["VAL"], -
    "my_sum over no rows should return what xFinal sets for .nil")
  db~close

--------------------------------------------------------------------------------
-- createFunction: a bad xFinal reply raises an error that names xFinal       --
--------------------------------------------------------------------------------

::Method testCreateFunctionAggregateFinalNoReply
  db = self~openMemoryDB
  db~exec("CREATE TABLE nums(x INTEGER);")
  db~exec("INSERT INTO nums VALUES(1);")
  db~createFunction("agg_none", .AggregateFinalNoReplyHandler~new, 1,, -
    "xStep", "xFinal")
  msg = self~aggregateErrorMessage(db, "SELECT agg_none(x) FROM nums;")
  self~assertTrue(msg~pos("xFinal") > 0, -
    "Error for an xFinal with no reply should name xFinal:" msg)
  self~assertEquals(0, msg~pos("xStep"), -
    "Error for an xFinal with no reply should not name xStep:" msg)
  db~close

::Method testCreateFunctionAggregateFinalBadReply
  db = self~openMemoryDB
  db~exec("CREATE TABLE nums(x INTEGER);")
  db~exec("INSERT INTO nums VALUES(1);")
  db~createFunction("agg_bad", .AggregateFinalBadReplyHandler~new, 1,, -
    "xStep", "xFinal")
  msg = self~aggregateErrorMessage(db, "SELECT agg_bad(x) FROM nums;")
  self~assertTrue(msg~pos("xFinal") > 0, -
    "Error for a non-numeric xFinal reply should name xFinal:" msg)
  self~assertEquals(0, msg~pos("xStep"), -
    "Error for a non-numeric xFinal reply should not name xStep:" msg)
  db~close

-- Runs sql and returns the message of the SYNTAX condition it raises,
-- or "" if it raises none.
::Method aggregateErrorMessage
  Use Strict Arg db, sql
  Signal On Syntax Name AggregateErrorTrapped
  db~exec(sql, .true)
  Return ""
AggregateErrorTrapped:
  Return Condition("O")~message

--------------------------------------------------------------------------------
-- createFunction: aggregate UDF (average, double result)                     --
--------------------------------------------------------------------------------

::Method testCreateFunctionAggregateAvg
  db = self~openMemoryDB
  db~exec("CREATE TABLE scores(val REAL);")
  db~exec("INSERT INTO scores VALUES(10.0);")
  db~exec("INSERT INTO scores VALUES(20.0);")
  db~exec("INSERT INTO scores VALUES(30.0);")
  handler = .AggregateAvgHandler~new
  rc = db~createFunction("my_avg", handler, 1,, "xStep", "xFinal")
  self~assertEquals(0, rc, -
    "createFunction aggregate should return SQLITE_OK")
  rows = db~exec("SELECT my_avg(val) AS val FROM scores;", .true)
  self~assertEquals("20.0", rows[1]["VAL"], -
    "my_avg(10,20,30) should return 20.0")
  db~close

--------------------------------------------------------------------------------
-- createFunction: scalar UDF used in WHERE clause                            --
--------------------------------------------------------------------------------

::Method testCreateFunctionInWhereClause
  db = self~openMemoryDB
  handler = .ScalarIntDoubleHandler~new
  db~createFunction("my_double", handler, 1, "xFunc")
  db~exec("CREATE TABLE t(x INTEGER);")
  db~exec("INSERT INTO t VALUES(3);")
  db~exec("INSERT INTO t VALUES(5);")
  db~exec("INSERT INTO t VALUES(10);")
  rows = db~exec("SELECT x FROM t WHERE my_double(x) > 8;", .true)
  self~assertEquals(2, rows~items, -
    "WHERE my_double(x) > 8 should match x=5 and x=10")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 31: Tier 3C — createCollation: user-defined collations in Rexx     */
/*                                                                            */
/* Tests cover registration, sorting via ORDER BY COLLATE, COLLATE in column  */
/* definitions and WHERE clauses, DISTINCT with custom collation, userData,    */
/* custom method name, collation replacement, deregistration, and             */
/* collationNeeded for on-demand dynamic registration.                        */
/*                                                                            */
/* collationNeeded(.nil) deregistration used to cause SIGSEGV: the C++ layer  */
/* passed callback type 'collation' instead of 'collationNeeded' in the .nil  */
/* branch (technical note #22). Fixed; see testCollationNeededDeregister.     */
/*                                                                            */
/* NOTE: Collation names are case-insensitive in SQLite. Registering          */
/* 'MyColl' and 'MYCOLL' refers to the same collation (see note #23).         */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- createCollation: basic registration and use with ORDER BY                  --
--------------------------------------------------------------------------------

::Method testCreateCollationBasic
  db = self~openMemoryDB
  handler = .CollationCaseInsensitiveHandler~new
  rc = db~createCollation("NOCASE_REXX", handler)
  self~assertEquals(0, rc, -
    "createCollation should return SQLITE_OK")
  db~exec("CREATE TABLE words(w TEXT);")
  db~exec("INSERT INTO words VALUES('banana');")
  db~exec("INSERT INTO words VALUES('Apple');")
  db~exec("INSERT INTO words VALUES('cherry');")
  rows = db~exec("SELECT w FROM words ORDER BY w COLLATE NOCASE_REXX;", .true)
  self~assertEquals(3, rows~items, -
    "ORDER BY with custom collation should return all rows")
  self~assertEquals("Apple", rows[1]["W"], -
    "Case-insensitive sort: Apple should come first")
  self~assertTrue(handler~callCount > 0, -
    "Collation handler should be invoked during sorting")
  db~close

--------------------------------------------------------------------------------
-- createCollation: userData propagation                                       --
--------------------------------------------------------------------------------

::Method testCreateCollationUserData
  db = self~openMemoryDB
  handler = .CollationCaseInsensitiveHandler~new
  rc = db~createCollation("CI_UD", handler,, "myUserData")
  self~assertEquals(0, rc, -
    "createCollation with userData should return SQLITE_OK")
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('b');")
  db~exec("INSERT INTO t VALUES('a');")
  db~exec("SELECT x FROM t ORDER BY x COLLATE CI_UD;", .true)
  self~assertEquals("myUserData", handler~lastUserData, -
    "userData should be propagated to collation callback")
  db~close

--------------------------------------------------------------------------------
-- createCollation: custom method name                                         --
--------------------------------------------------------------------------------

::Method testCreateCollationCustomMethod
  db = self~openMemoryDB
  handler = .CollationReverseHandler~new
  -- CollationReverseHandler uses the default method 'collationCallBack',
  -- but we verify that passing a method name explicitly works too.
  rc = db~createCollation("CUSTOM_MTH", handler, "collationCallBack")
  self~assertEquals(0, rc, -
    "createCollation with explicit method name should return SQLITE_OK")
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('a');")
  db~exec("INSERT INTO t VALUES('b');")
  db~exec("INSERT INTO t VALUES('c');")
  rows = db~exec("SELECT x FROM t ORDER BY x COLLATE CUSTOM_MTH;", .true)
  self~assertEquals("c", rows[1]["X"], -
    "Reverse collation with explicit method: 'c' should come first")
  self~assertTrue(handler~callCount > 0, -
    "Handler should be invoked when using explicit method name")
  db~close

--------------------------------------------------------------------------------
-- createCollation: reverse sort order                                         --
--------------------------------------------------------------------------------

::Method testCreateCollationReverse
  db = self~openMemoryDB
  handler = .CollationReverseHandler~new
  db~createCollation("REVERSE", handler)
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('a');")
  db~exec("INSERT INTO t VALUES('b');")
  db~exec("INSERT INTO t VALUES('c');")
  rows = db~exec("SELECT x FROM t ORDER BY x COLLATE REVERSE;", .true)
  self~assertEquals("c", rows[1]["X"], -
    "Reverse collation: first row should be 'c'")
  self~assertEquals("b", rows[2]["X"], -
    "Reverse collation: second row should be 'b'")
  self~assertEquals("a", rows[3]["X"], -
    "Reverse collation: third row should be 'a'")
  db~close

--------------------------------------------------------------------------------
-- createCollation: COLLATE in column definition (ORDER BY uses it            --
-- automatically)                                                              --
--------------------------------------------------------------------------------

::Method testCreateCollationColumnDefinition
  db = self~openMemoryDB
  handler = .CollationCaseInsensitiveHandler~new
  db~createCollation("CI_COL", handler)
  db~exec("CREATE TABLE people(name TEXT COLLATE CI_COL);")
  db~exec("INSERT INTO people VALUES('Zara');")
  db~exec("INSERT INTO people VALUES('alice');")
  db~exec("INSERT INTO people VALUES('Bob');")
  -- ORDER BY without explicit COLLATE — should use column's collation
  rows = db~exec("SELECT name FROM people ORDER BY name;", .true)
  self~assertEquals("alice", rows[1]["NAME"], -
    "Column collation: 'alice' should sort before 'Bob'")
  self~assertEquals("Bob", rows[2]["NAME"], -
    "Column collation: 'Bob' should sort before 'Zara'")
  self~assertTrue(handler~callCount > 0, -
    "Column collation handler should be invoked during implicit ORDER BY")
  db~close

--------------------------------------------------------------------------------
-- createCollation: COLLATE in WHERE clause for case-insensitive matching      --
--------------------------------------------------------------------------------

::Method testCreateCollationInWhere
  db = self~openMemoryDB
  handler = .CollationCaseInsensitiveHandler~new
  db~createCollation("CI_WHERE", handler)
  db~exec("CREATE TABLE t(name TEXT);")
  db~exec("INSERT INTO t VALUES('Alice');")
  db~exec("INSERT INTO t VALUES('BOB');")
  db~exec("INSERT INTO t VALUES('charlie');")
  rows = db~exec( -
    "SELECT name FROM t WHERE name = 'alice' COLLATE CI_WHERE;", .true)
  self~assertEquals(1, rows~items, -
    "COLLATE in WHERE should find case-insensitive match")
  self~assertEquals("Alice", rows[1]["NAME"], -
    "COLLATE in WHERE: 'alice' should match 'Alice'")
  db~close

--------------------------------------------------------------------------------
-- createCollation: DISTINCT uses column collation                             --
--------------------------------------------------------------------------------

::Method testCreateCollationDistinct
  db = self~openMemoryDB
  handler = .CollationCaseInsensitiveHandler~new
  db~createCollation("CI_DIST", handler)
  db~exec("CREATE TABLE t(val TEXT COLLATE CI_DIST);")
  db~exec("INSERT INTO t VALUES('apple');")
  db~exec("INSERT INTO t VALUES('Apple');")
  db~exec("INSERT INTO t VALUES('APPLE');")
  db~exec("INSERT INTO t VALUES('banana');")
  rows = db~exec("SELECT DISTINCT val FROM t;", .true)
  self~assertEquals(2, rows~items, -
    "DISTINCT with CI collation should collapse case variants to 2 groups")
  db~close

--------------------------------------------------------------------------------
-- createCollation: replace existing collation with a different handler        --
--------------------------------------------------------------------------------

::Method testCreateCollationReplace
  db = self~openMemoryDB
  ciHandler = .CollationCaseInsensitiveHandler~new
  revHandler = .CollationReverseHandler~new
  db~createCollation("REPLACEABLE", ciHandler)
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('a');")
  db~exec("INSERT INTO t VALUES('b');")
  -- First: CI sort -> a, b
  rows1 = db~exec("SELECT x FROM t ORDER BY x COLLATE REPLACEABLE;", .true)
  self~assertEquals("a", rows1[1]["X"], -
    "Before replacement: CI should sort 'a' first")
  -- Replace with reverse
  rc = db~createCollation("REPLACEABLE", revHandler)
  self~assertEquals(0, rc, -
    "Replacing existing collation should return SQLITE_OK")
  rows2 = db~exec("SELECT x FROM t ORDER BY x COLLATE REPLACEABLE;", .true)
  self~assertEquals("b", rows2[1]["X"], -
    "After replacement: reverse should sort 'b' first")
  db~close

--------------------------------------------------------------------------------
-- createCollation: deregistration with .nil                                   --
--------------------------------------------------------------------------------

::Method testCreateCollationDeregister
  db = self~openMemoryDB
  handler = .CollationCaseInsensitiveHandler~new
  db~createCollation("TEMP_COLL", handler)
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('a');")
  -- Verify it works
  rows = db~exec("SELECT x FROM t ORDER BY x COLLATE TEMP_COLL;", .true)
  self~assertEquals(1, rows~items, -
    "Collation should work before deregistration")
  -- Deregister
  rc = db~createCollation("TEMP_COLL", .nil)
  self~assertEquals(0, rc, -
    "Deregistration should return SQLITE_OK")
  -- After deregistration: exec returns empty result set, errCode = 257
  rows2 = db~exec("SELECT x FROM t ORDER BY x COLLATE TEMP_COLL;", .true)
  self~assertEquals(0, rows2~items, -
    "After deregistration query should return empty result set")
  self~assertEquals(257, db~errCode, -
    "errCode should be 257 (no such collation sequence)")
  db~close

--------------------------------------------------------------------------------
-- createCollation: collation names are case-insensitive in SQLite             --
--------------------------------------------------------------------------------

::Method testCreateCollationNameCaseInsensitive
  db = self~openMemoryDB
  ciHandler = .CollationCaseInsensitiveHandler~new
  revHandler = .CollationReverseHandler~new
  db~createCollation("MyColl", ciHandler)
  -- Register 'MYCOLL' — should replace 'MyColl' (same name)
  db~createCollation("MYCOLL", revHandler)
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('a');")
  db~exec("INSERT INTO t VALUES('b');")
  db~exec("INSERT INTO t VALUES('c');")
  rows = db~exec("SELECT x FROM t ORDER BY x COLLATE MyColl;", .true)
  self~assertEquals("c", rows[1]["X"], -
    "Collation names are case-insensitive: MYCOLL should replace MyColl")
  self~assertEquals(0, ciHandler~callCount, -
    "Original CI handler should not be invoked after replacement")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 32: Tier 3C — collationNeeded: on-demand collation registration    */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- collationNeeded: dynamic registration on demand                             --
--------------------------------------------------------------------------------

::Method testCollationNeeded
  db = self~openMemoryDB
  cnHandler = .CollationNeededHandler~new
  rc = db~collationNeeded(cnHandler)
  self~assertEquals(0, rc, -
    "collationNeeded should return SQLITE_OK")
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('b');")
  db~exec("INSERT INTO t VALUES('a');")
  -- Use an undefined collation — triggers the callback
  rows = db~exec("SELECT x FROM t ORDER BY x COLLATE ON_DEMAND;", .true)
  self~assertEquals(1, cnHandler~callCount, -
    "collationNeeded handler should be invoked once")
  self~assertEquals("ON_DEMAND", cnHandler~lastCollationName, -
    "collationNeeded should receive the requested collation name")
  self~assertEquals(2, rows~items, -
    "Query should succeed after dynamic registration")
  db~close

--------------------------------------------------------------------------------
-- collationNeeded: userData propagation                                       --
--------------------------------------------------------------------------------

::Method testCollationNeededUserData
  db = self~openMemoryDB
  cnHandler = .CollationNeededHandler~new
  rc = db~collationNeeded(cnHandler,, "cnUserData!")
  self~assertEquals(0, rc, -
    "collationNeeded with userData should return SQLITE_OK")
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('a');")
  db~exec("SELECT x FROM t ORDER BY x COLLATE DYNAMIC_UD;", .true)
  self~assertEquals("cnUserData!", cnHandler~lastUserData, -
    "userData should be propagated to collationNeeded callback")
  db~close

--------------------------------------------------------------------------------
-- collationNeeded: multiple different collation names                         --
--------------------------------------------------------------------------------

::Method testCollationNeededMultipleNames
  db = self~openMemoryDB
  cnHandler = .CollationNeededHandler~new
  db~collationNeeded(cnHandler)
  db~exec("CREATE TABLE t(x TEXT, y TEXT);")
  db~exec("INSERT INTO t VALUES('b', 'z');")
  db~exec("INSERT INTO t VALUES('a', 'y');")
  -- First undefined collation
  db~exec("SELECT x FROM t ORDER BY x COLLATE DYN_A;", .true)
  self~assertEquals(1, cnHandler~callCount, -
    "First collation request should invoke handler once")
  self~assertEquals("DYN_A", cnHandler~lastCollationName, -
    "First request should be for DYN_A")
  -- Second undefined collation
  db~exec("SELECT y FROM t ORDER BY y COLLATE DYN_B;", .true)
  self~assertEquals(2, cnHandler~callCount, -
    "Second collation request should invoke handler again")
  self~assertEquals("DYN_B", cnHandler~lastCollationName, -
    "Second request should be for DYN_B")
  -- Re-use DYN_A — already registered, should NOT trigger callback
  oldCount = cnHandler~callCount
  db~exec("SELECT x FROM t ORDER BY x COLLATE DYN_A;", .true)
  self~assertEquals(oldCount, cnHandler~callCount, -
    "Already-registered collation should not trigger collationNeeded again")
  db~close

--------------------------------------------------------------------------------
-- collationNeeded: deregistration with .nil (technical note #22)             --
--------------------------------------------------------------------------------

::Method testCollationNeededDeregister
  db = self~openMemoryDB
  cnHandler = .CollationNeededHandler~new
  db~collationNeeded(cnHandler)
  rc = db~collationNeeded(.nil)
  self~assertEquals(0, rc, -
    "collationNeeded(.nil) should return SQLITE_OK")
  db~exec("CREATE TABLE t(x TEXT);")
  db~exec("INSERT INTO t VALUES('a');")
  db~exec("SELECT x FROM t ORDER BY x COLLATE NOT_REGISTERED;", .true)
  self~assertEquals(0, cnHandler~callCount, -
    "A deregistered collationNeeded handler should not be invoked")
  self~assertTrue(db~errMsg~caselessPos("no such collation sequence") > 0, -
    "An unknown collation should fail once the handler is removed")
  db~close

/******************************************************************************/
/*                                                                            */
/* Tier 5 — SQLite 3.52.0 new features                                       */
/*                                                                            */
/* Tests for features enabled in the new build:                               */
/*   - SQLITE_ENABLE_MATH_FUNCTIONS (sqrt, pi, ceil, floor, etc.)            */
/*   - base64 builtin extension                                              */
/*   - csv builtin extension (virtual table)                                 */
/*   - SQLITE_ENABLE_RTREE (spatial indexing)                                */
/*   - SQLITE_ENABLE_GEOPOLY (polygon geometry)                              */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- Math functions: basic arithmetic (sqrt, pow, mod, sign)                    --
--------------------------------------------------------------------------------

::Method testMathSqrt
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT sqrt(4);")
  self~assertEquals(stmt~ROW, stmt~step, "step should return ROW")
  self~assertEquals(2.0, stmt~columnDouble(1), "sqrt(4) should be 2.0")
  stmt~finalize
  db~close

::Method testMathPow
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT pow(2, 10);")
  stmt~step
  self~assertEquals(1024.0, stmt~columnDouble(1), "pow(2,10) should be 1024.0")
  stmt~finalize
  db~close

::Method testMathMod
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT mod(17, 5);")
  stmt~step
  self~assertEquals(2.0, stmt~columnDouble(1), "mod(17,5) should be 2.0")
  stmt~finalize
  db~close

::Method testMathSign
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT sign(-5), sign(0), sign(5);")
  stmt~step
  self~assertEquals(-1, stmt~columnInt(1), "sign(-5) should be -1")
  self~assertEquals(0, stmt~columnInt(2), "sign(0) should be 0")
  self~assertEquals(1, stmt~columnInt(3), "sign(5) should be 1")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Math functions: rounding (ceil, floor)                                     --
--------------------------------------------------------------------------------

::Method testMathCeil
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT ceil(2.3);")
  stmt~step
  self~assertEquals(3.0, stmt~columnDouble(1), "ceil(2.3) should be 3.0")
  stmt~finalize
  db~close

::Method testMathFloor
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT floor(2.7);")
  stmt~step
  self~assertEquals(2.0, stmt~columnDouble(1), "floor(2.7) should be 2.0")
  stmt~finalize
  db~close

