--------------------------------------------------------------------------------
-- oosqlResultValue: pass-through preserves type and content                 --
--------------------------------------------------------------------------------

::Method testClassicResultValue
  db = self~classicOpenMemory
  ret = oosqlCreateFunction(db, "cl_valthru", 1, "classicResultValueCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_valthru should return OK")
  -- Integer pass-through
  rc = oosqlPrepare(db, -
    "SELECT cl_valthru(42);", "stmt")
  Call oosqlStep stmt
  self~assertEquals(1, oosqlColumnType(stmt, 1), -
    "oosqlResultValue should preserve INTEGER type (1)")
  self~assertEquals(42, oosqlColumnInt(stmt, 1), -
    "oosqlResultValue should preserve integer value 42")
  Call oosqlFinalize stmt
  -- Text pass-through
  rc = oosqlPrepare(db, -
    "SELECT cl_valthru('hello');", "stmt")
  Call oosqlStep stmt
  self~assertEquals(3, oosqlColumnType(stmt, 1), -
    "oosqlResultValue should preserve TEXT type (3)")
  self~assertEquals("hello", oosqlColumnText(stmt, 1), -
    "oosqlResultValue should preserve text value 'hello'")
  Call oosqlFinalize stmt
  -- NULL pass-through
  rc = oosqlPrepare(db, -
    "SELECT cl_valthru(NULL);", "stmt")
  Call oosqlStep stmt
  self~assertEquals(5, oosqlColumnType(stmt, 1), -
    "oosqlResultValue should preserve NULL type (5)")
  Call oosqlFinalize stmt
  Call oosqlClose db

