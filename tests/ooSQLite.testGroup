-- oosqlCreateFunction: aggregate UDF (sum)                                   --
--------------------------------------------------------------------------------

::Method testClassicCallbackCreateFunctionAggregateSum
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(10);"
  Call oosqlExec db, "INSERT INTO t VALUES(20);"
  Call oosqlExec db, "INSERT INTO t VALUES(30);"
  ret = oosqlCreateFunction(db, "cl_sum", 1,, -
    "classicAggregateSumStepCB", "classicAggregateSumFinalCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction aggregate should return OK")
  rs = oosqlExec(db, -
    "SELECT cl_sum(x) AS total FROM t;", .true, 2)
  self~assertEquals(60, rs[1]["TOTAL"], -
    "cl_sum(10,20,30) should return 60")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCreateFunction: aggregate UDF over no rows (technical note #20)       --
--------------------------------------------------------------------------------

::Method testClassicCallbackCreateFunctionAggregateEmpty
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(10);"
  Call oosqlCreateFunction db, "cl_sum", 1,, -
    "classicAggregateSumStepCB", "classicAggregateSumFinalCB"
  rs = oosqlExec(db, -
    "SELECT cl_sum(x) AS total FROM t WHERE 0;", .true, 2)
  self~assertEquals(1, rs~items, -
    "An aggregate over no rows should still return one row")
  self~assertEquals(0, rs[1]["TOTAL"], -
    "cl_sum over no rows should return what the final routine sets for .nil")
  Call oosqlClose db

