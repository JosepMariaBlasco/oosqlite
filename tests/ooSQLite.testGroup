::Method testClassicResultNull
  db = self~classicOpenMemory
  ret = oosqlCreateFunction(db, "cl_null", 0, "classicResultNullCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_null should return OK")
