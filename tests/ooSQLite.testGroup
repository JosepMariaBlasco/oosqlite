--------------------------------------------------------------------------------

::Method testClassicDbHandle
  db = self~classicOpenMemory
  Call oosqlPrepare db, "SELECT 1;", "stmt"
  dbH = oosqlDbHandle(stmt)
  self~assertFalse(oosqlIsHandleNull(dbH), -
    "oosqlDbHandle should return a non-null handle")
  Call oosqlFinalize stmt
  Call oosqlClose db

