--------------------------------------------------------------------------------
-- oosqlCreateFunction: deregistration (technical note #21)                   --
--------------------------------------------------------------------------------

::Method testClassicCallbackCreateFunctionDeregister
  db = self~classicOpenMemory
  Call oosqlCreateFunction db, "cl_double", 1, "classicScalarDoubleCB"
  rs = oosqlExec(db, "SELECT cl_double(21) AS dbl;", .true, 2)
  self~assertEquals(42, rs[1]["DBL"], -
    "cl_double should work before it is removed")
  -- The number of arguments is the one the function was registered with
  ret = oosqlCreateFunction(db, "cl_double")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction(db, name) should return OK")
  Call oosqlExec db, "SELECT cl_double(21) AS dbl;", .true, 2
  self~assertTrue(oosqlErrMsg(db)~caselessPos("no such function") > 0, -
    "A removed function should no longer exist:" oosqlErrMsg(db))
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCreateFunction: deregistration with an explicit number of arguments   --
--------------------------------------------------------------------------------

::Method testClassicCallbackCreateFunctionDeregisterCountArgs
  db = self~classicOpenMemory
  Call oosqlCreateFunction db, "cl_double", 1, "classicScalarDoubleCB"
  ret = oosqlCreateFunction(db, "cl_double", 1)
  self~assertEquals(0, ret, -
    "oosqlCreateFunction(db, name, 1) should return OK")
  Call oosqlExec db, "SELECT cl_double(21) AS dbl;", .true, 2
  self~assertTrue(oosqlErrMsg(db)~caselessPos("no such function") > 0, -
    "A removed function should no longer exist:" oosqlErrMsg(db))
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCreateFunction: two functions with the same name and a different      --
-- number of arguments                                                        --
--------------------------------------------------------------------------------

::Method testClassicCallbackCreateFunctionSameNameTwoCounts
  db = self~classicOpenMemory
  Call oosqlCreateFunction db, "f", 1, "classicScalarDoubleCB"
  Call oosqlCreateFunction db, "f", 2, "classicScalarConcatCB"
  self~churnMemory
  rs = oosqlExec(db, "SELECT f(21) AS a, f('x', 'y') AS b;", .true, 2)
  self~assertEquals(42, rs[1]["A"], "f with 1 argument should still work")
  self~assertEquals("x y", rs[1]["B"], "f with 2 arguments should work")
  ret = oosqlCreateFunction(db, "f", 2)
  self~assertEquals(0, ret, "oosqlCreateFunction(db, f, 2) should return OK")
  self~churnMemory
  rs = oosqlExec(db, "SELECT f(21) AS a;", .true, 2)
  self~assertEquals(42, rs[1]["A"], -
    "f with 1 argument should survive the removal of f with 2")
  ret = oosqlCreateFunction(db, "f")
  self~assertEquals(0, ret, "oosqlCreateFunction(db, f) should return OK")
  Call oosqlExec db, "SELECT f(21) AS a;", .true, 2
  self~assertTrue(oosqlErrMsg(db)~caselessPos("no such function") > 0, -
    "f should be gone:" oosqlErrMsg(db))
  Call oosqlClose db

