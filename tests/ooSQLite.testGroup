-- oosqlStmtReadonly                                                          --
--------------------------------------------------------------------------------

::Method testClassicStmtReadonly
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER);"
  Call oosqlPrepare db, "SELECT 1;", "stmtR"
  self~assertTrue(oosqlStmtReadonly(stmtR), -
    "SELECT statement should be read-only")
  Call oosqlFinalize stmtR
  Call oosqlPrepare db, "INSERT INTO t VALUES(1);", "stmtW"
  self~assertFalse(oosqlStmtReadonly(stmtW), -
    "INSERT statement should not be read-only")
  Call oosqlFinalize stmtW
  Call oosqlClose db

