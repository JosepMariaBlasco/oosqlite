-- oosqlCreateFunction: scalar UDF with text result and two arguments         --
--------------------------------------------------------------------------------

::Method testClassicCallbackCreateFunctionScalarText
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(first TEXT, last TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES('John', 'Doe');"
  ret = oosqlCreateFunction(db, "cl_concat", 2, "classicScalarConcatCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction text should return OK")
  rs = oosqlExec(db, -
    "SELECT cl_concat(first, last) AS fullname FROM t;", .true, 2)
  self~assertEquals("John Doe", rs[1]["FULLNAME"], -
    "cl_concat('John','Doe') should return 'John Doe'")
  Call oosqlClose db

