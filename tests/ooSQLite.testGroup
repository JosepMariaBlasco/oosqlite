/******************************************************************************/
/*                                                                            */
/* Section C7: Classic result/value routines                                  */
/*                                                                            */
/* These routines are only usable inside UDF callbacks registered via         */
/* oosqlCreateFunction. Each test registers a scalar UDF that exercises one   */
/* or more result/value routines, then verifies the output via SQL.           */
/*                                                                            */
/* Value routines tested: oosqlValueDouble, oosqlValueBlob,                  */
/*   oosqlValueNumericType, oosqlValueInt64.                                 */
/* Result routines tested: oosqlResultInt64, oosqlResultBlob,                */
/*   oosqlResultNull, oosqlResultZeroBlob, oosqlResultValue,                */
/*   oosqlResultError, oosqlResultErrorCode, oosqlResultErrorNoMem,         */
/*   oosqlResultErrorTooBig.                                                 */
/*                                                                            */
/* Note: oosqlValueInt64 did not exist as a classic routine before 1.1,      */
/* while the OO ooSQLValue~int64 did (note #26).                             */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- oosqlValueDouble: coercion from all five SQLite types                      --
--------------------------------------------------------------------------------

::Method testClassicValueDouble
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(a INTEGER, b REAL, c TEXT, d BLOB, e);"
  Call oosqlExec db, "INSERT INTO t VALUES(42, 3.14, '99.5', X'CAFE', NULL);"
  ret = oosqlCreateFunction(db, "cl_valdbl", 1, "classicValueDoubleCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_valdbl should return OK")
  -- INTEGER -> double
  rc = oosqlPrepare(db, -
    "SELECT cl_valdbl(a) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals("42", oosqlColumnText(stmt, 1), -
    "oosqlValueDouble(INTEGER 42) should return 42")
  Call oosqlFinalize stmt
  -- REAL -> double
  rc = oosqlPrepare(db, -
    "SELECT cl_valdbl(b) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals("3.14", oosqlColumnText(stmt, 1), -
    "oosqlValueDouble(REAL 3.14) should return 3.14")
  Call oosqlFinalize stmt
  -- TEXT numeric -> double
  rc = oosqlPrepare(db, -
    "SELECT cl_valdbl(c) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals("99.5", oosqlColumnText(stmt, 1), -
    "oosqlValueDouble(TEXT '99.5') should coerce to 99.5")
  Call oosqlFinalize stmt
  -- BLOB -> double (0)
  rc = oosqlPrepare(db, -
    "SELECT cl_valdbl(d) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals("0", oosqlColumnText(stmt, 1), -
    "oosqlValueDouble(BLOB) should return 0")
  Call oosqlFinalize stmt
  -- NULL -> .nil (callback returns "NIL" sentinel)
  rc = oosqlPrepare(db, -
    "SELECT cl_valdbl(e) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals("NIL", oosqlColumnText(stmt, 1), -
    "oosqlValueDouble(NULL) should return .nil")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlValueBlob: pass through via oosqlResultBlob                          --
--------------------------------------------------------------------------------

::Method testClassicValueBlob
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(d BLOB);"
  Call oosqlExec db, "INSERT INTO t VALUES(X'DEADBEEF');"
  ret = oosqlCreateFunction(db, "cl_valblob", 1, "classicValueBlobCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_valblob should return OK")
  rc = oosqlPrepare(db, -
    "SELECT cl_valblob(d) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals(4, oosqlColumnType(stmt, 1), -
    "oosqlValueBlob pass-through should produce BLOB type (4)")
  self~assertEquals(4, oosqlColumnBytes(stmt, 1), -
    "Blob pass-through should preserve 4 bytes")
  self~assertEquals("DEADBEEF", oosqlColumnText(stmt, 1)~c2x, -
    "Blob pass-through should preserve content DEADBEEF")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlValueBlob: NULL returns .nil                                         --
--------------------------------------------------------------------------------

::Method testClassicValueBlobNull
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(d BLOB);"
  Call oosqlExec db, "INSERT INTO t VALUES(NULL);"
  ret = oosqlCreateFunction(db, "cl_valblobnull", 1, "classicValueBlobNullCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_valblobnull should return OK")
  rc = oosqlPrepare(db, -
    "SELECT cl_valblobnull(d) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals("NIL", oosqlColumnText(stmt, 1), -
    "oosqlValueBlob(NULL) should return .nil")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlValueBlob: empty blob, NULL and other types                           --
--------------------------------------------------------------------------------

::Method testClassicValueBlobEmptyAndNull
  -- an empty blob is "", NULL is .nil, any other value its bytes
  db = self~classicOpenMemory
  ret = oosqlCreateFunction(db, "cl_blobkind", 1, "classicValueBlobKindCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_blobkind should return OK")
  rc = oosqlPrepare(db, "SELECT cl_blobkind(X'CAFE'), cl_blobkind(X'')," -
    "cl_blobkind(NULL), cl_blobkind('ab'), cl_blobkind(12);", "stmt")
  Call oosqlStep stmt
  self~assertEquals("[CAFE]", oosqlColumnText(stmt, 1), "oosqlValueBlob of a blob")
  self~assertEquals("[]", oosqlColumnText(stmt, 2), "oosqlValueBlob of an empty blob is the empty string")
  self~assertEquals("NIL", oosqlColumnText(stmt, 3), "oosqlValueBlob of NULL is .nil")
  self~assertEquals("[6162]", oosqlColumnText(stmt, 4), "oosqlValueBlob of a text")
  self~assertEquals("[3132]", oosqlColumnText(stmt, 5), "oosqlValueBlob of an integer")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlColumnDouble / oosqlValueDouble: full precision (see doubleCases)     --
--------------------------------------------------------------------------------

::Method testClassicColumnDoublePrecision
  db = self~classicOpenMemory
  Do case Over doubleCases()
    rc = oosqlPrepare(db, "SELECT" case[1]";", "stmt")
    Call oosqlStep stmt
    self~assertEquals("["case[2]"]", "["oosqlColumnDouble(stmt, 1)"]", "oosqlColumnDouble of" case[1])
    Call oosqlFinalize stmt
  End
  Call oosqlClose db

::Method testClassicValueDoublePrecision
  db = self~classicOpenMemory
  ret = oosqlCreateFunction(db, "cl_dbltext", 1, "classicValueDoubleCB")
  Do case Over doubleCases()
    rc = oosqlPrepare(db, "SELECT cl_dbltext("case[1]");", "stmt")
    Call oosqlStep stmt
    self~assertEquals("["case[2]"]", "["oosqlColumnText(stmt, 1)"]", "oosqlValueDouble of" case[1])
    Call oosqlFinalize stmt
  End
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlValueNumericType: coercion differs from oosqlValueType for text      --
--------------------------------------------------------------------------------

::Method testClassicValueNumericType
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(val);"
  Call oosqlExec db, "INSERT INTO t VALUES('42');"
  Call oosqlExec db, "INSERT INTO t VALUES('3.14');"
  Call oosqlExec db, "INSERT INTO t VALUES('hello');"
  Call oosqlExec db, "INSERT INTO t VALUES(42);"
  Call oosqlExec db, "INSERT INTO t VALUES(3.14);"
  ret = oosqlCreateFunction(db, "cl_numtype", 1, "classicValueNumTypeCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_numtype should return OK")
  rc = oosqlPrepare(db, -
    "SELECT val, cl_numtype(val) FROM t ORDER BY rowid;", "stmt")
  -- Row 1: TEXT '42' -> type=3, numericType=1 (INTEGER)
  Call oosqlStep stmt
  self~assertEquals("3,1", oosqlColumnText(stmt, 2), -
    "TEXT '42': type=3(TEXT) but numericType=1(INTEGER)")
  -- Row 2: TEXT '3.14' -> type=3, numericType=2 (FLOAT)
  Call oosqlStep stmt
  self~assertEquals("3,2", oosqlColumnText(stmt, 2), -
    "TEXT '3.14': type=3(TEXT) but numericType=2(FLOAT)")
  -- Row 3: TEXT 'hello' -> type=3, numericType=3 (TEXT, no coercion)
  Call oosqlStep stmt
  self~assertEquals("3,3", oosqlColumnText(stmt, 2), -
    "TEXT 'hello': type=3(TEXT) and numericType=3(TEXT)")
  -- Row 4: INTEGER 42 -> type=1, numericType=1
  Call oosqlStep stmt
  self~assertEquals("1,1", oosqlColumnText(stmt, 2), -
    "INTEGER 42: type=1 and numericType=1")
  -- Row 5: REAL 3.14 -> type=2, numericType=2
  Call oosqlStep stmt
  self~assertEquals("2,2", oosqlColumnText(stmt, 2), -
    "REAL 3.14: type=2 and numericType=2")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlValueInt64: full 64-bit range, coercion, NULL (note #26)              --
--------------------------------------------------------------------------------

::Method testClassicValueInt64
  db = self~classicOpenMemory
  ret = oosqlCreateFunction(db, "cl_valint64", 1, "classicValueInt64CB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_valint64 should return OK")
  rc = oosqlPrepare(db, "SELECT cl_valint64(9223372036854775807)," -
    "cl_valint64(-9223372036854775808), cl_valint64(123456789012)," -
    "cl_valint64('77'), cl_valint64(3.9), cl_valint64(NULL);", "stmt")
  Call oosqlStep stmt
  self~assertEquals(.ooSQLite~INTEGER, oosqlColumnType(stmt, 1), -
    "oosqlValueInt64 through oosqlResultInt64 should give an INTEGER")
  self~assertEquals("9223372036854775807", oosqlColumnText(stmt, 1), -
    "oosqlValueInt64(INT64_MAX)")
  self~assertEquals("-9223372036854775808", oosqlColumnText(stmt, 2), -
    "oosqlValueInt64(INT64_MIN)")
  self~assertEquals("123456789012", oosqlColumnText(stmt, 3), -
    "oosqlValueInt64 of a value that does not fit in 32 bits")
  self~assertEquals("77", oosqlColumnText(stmt, 4), -
    "oosqlValueInt64(TEXT '77') should coerce to 77")
  self~assertEquals("3", oosqlColumnText(stmt, 5), -
    "oosqlValueInt64(REAL 3.9) should truncate to 3")
  self~assertEquals("NIL", oosqlColumnText(stmt, 6), -
    "oosqlValueInt64(NULL) should return .nil")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlResultInt64: preserves full 64-bit range                             --
--------------------------------------------------------------------------------

::Method testClassicResultInt64
  db = self~classicOpenMemory
  ret = oosqlCreateFunction(db, "cl_int64", 1, "classicResultInt64CB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_int64 should return OK")
  -- INT64_MAX
  rc = oosqlPrepare(db, -
    "SELECT cl_int64(9223372036854775807);", "stmt")
  Call oosqlStep stmt
  self~assertEquals("9223372036854775807", oosqlColumnText(stmt, 1), -
    "oosqlResultInt64 should preserve INT64_MAX")
  self~assertEquals(1, oosqlColumnType(stmt, 1), -
    "oosqlResultInt64 should produce INTEGER type (1)")
  Call oosqlFinalize stmt
  -- INT64_MIN
  rc = oosqlPrepare(db, -
    "SELECT cl_int64(-9223372036854775808);", "stmt")
  Call oosqlStep stmt
  self~assertEquals("-9223372036854775808", oosqlColumnText(stmt, 1), -
    "oosqlResultInt64 should preserve INT64_MIN")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlResultBlob: binary data via Pointer and length                       --
--------------------------------------------------------------------------------

::Method testClassicResultBlob
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(d BLOB);"
  Call oosqlExec db, "INSERT INTO t VALUES(X'CAFEBABE');"
  ret = oosqlCreateFunction(db, "cl_blobthru", 1, "classicValueBlobCB")
  self~assertEquals(0, ret, -
    "oosqlCreateFunction for cl_blobthru should return OK")
  rc = oosqlPrepare(db, -
    "SELECT cl_blobthru(d) FROM t;", "stmt")
  Call oosqlStep stmt
  self~assertEquals(4, oosqlColumnType(stmt, 1), -
    "oosqlResultBlob should produce BLOB type (4)")
  self~assertEquals(4, oosqlColumnBytes(stmt, 1), -
    "oosqlResultBlob should preserve 4 bytes")
  self~assertEquals("CAFEBABE", oosqlColumnText(stmt, 1)~c2x, -
    "oosqlResultBlob should preserve content CAFEBABE")
  Call oosqlFinalize stmt
  Call oosqlClose db

