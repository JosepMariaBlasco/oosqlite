/* TO, PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA,        */
/* OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY     */
/* OF LIABILITY, WHETHER IN CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING    */
/* NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE OF THIS         */
/* SOFTWARE, EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.               */
/*                                                                            */
/* Version history:                                                           */
/*                                                                            */
/* Date     Version Details                                                   */
/* -------- ------- --------------------------------------------------------- */
/* 20260330    0.1  First version — standalone ooSQLiteTestCase.cls +          */
/*                  runTests.rex                                               */
/* 20260330    0.2  Converted to .testGroup format                             */
/* 20260330    0.3  Tier 1 expansion — 30 new tests, ~70 new assertions        */
/* 20260331    0.4  Fixed 5 bugs in v0.3: recordFormat tests now create        */
/*                  connections after changing process format and use           */
/*                  Signal On Syntax for safe restore; fixed db→srcDB          */
/*                  typo in testBackupPageCountRemaining.                      */
/*                  Final: 130 tests, 314 assertions, all green.              */
/* 20260331    0.5  Tier 2 — callback tests: commitHook (basic, veto,         */
/*                  deregister, userData), rollbackHook (basic, deregister,    */
/*                  userData), updateHook (INSERT/UPDATE/DELETE, deregister),  */
/*                  trace (basic, deregister), profile (basic, deregister),    */
/*                  trace/profile mutual exclusion, progressHandler (basic,    */
/*                  interrupt, deregister), busyHandler (basic, deregister,    */
/*                  userData). setAuthorizer skipped: segfault in C++ layer.   */
/* 20260331    0.6  Tier 3A — ooSQLExtensions builtin tests: listBuiltins,    */
/*                  registerBuiltin (single, all, ALL keyword, array,         */
/*                  invalid name, not-available-before, regExp), autoBuiltin   */
/*                  (single, all), cancelAutoBuiltin (basic, not-registered),  */
/*                  resetAutoBuiltin, lastErrCode/lastErrMsg verification.     */
/*                  Tier 3B — createFunction UDF tests: scalar (int, text,    */
/*                  double, null results), invocation count, two-argument,    */
/*                  userData, variable args (-1), ooSQLValue~type for all 5   */
/*                  SQLite types, ooSQLValue~bytes, aggregate sum+average,    */
/*                  UDF in WHERE clause.                                       */
/*                  Handler classes in ooSQLite-TestSuite-Callbacks.cls:      */
/*                  ScalarIntDoubleHandler, ScalarConcatHandler,              */
/*                  ScalarUserDataHandler, ScalarHalfHandler,                 */
/*                  ScalarNullHandler, ScalarTypeHandler,                     */
/*                  ScalarCountArgsHandler, ScalarBytesHandler,               */
/*                  AggregateSumHandler, AggregateAvgHandler.                 */
/* 20260331    0.7  Tier 3C — createCollation: basic registration with        */
/*                  ORDER BY, userData propagation, custom method name,        */
/*                  reverse collation, COLLATE in column definition,           */
/*                  COLLATE in WHERE clause, DISTINCT with column collation,   */
/*                  replace existing collation, deregistration with .nil,      */
/*                  collation names are case-insensitive.                      */
/*                  collationNeeded: dynamic registration on demand,           */
/*                  userData propagation, multiple collation names.            */
/*                  Handler classes in ooSQLite-TestSuite-Callbacks.cls:      */
/*                  CollationCaseInsensitiveHandler,                          */
/*                  CollationReverseHandler, CollationNeededHandler.           */
/* 20260331    0.8  Tier 4 — Classic Rexx routines (oosqlXxx).                */
/*                  Static: oosqlVersion, oosqlLibVersion,                    */
/*                  oosqlLibVersionNumber, oosqlSourceID,                     */
/*                  oosqlThreadSafe, oosqlComplete,                           */
/*                  oosqlCompileOptionGet/Used, oosqlErrStr,                  */
/*                  oosqlMemoryUsed/HighWater, oosqlReleaseMemory,            */
/*                  oosqlSoftHeapLimit64, oosqlStrGlob.                       */
/*                  Connection: oosqlOpen/Close, oosqlExec (4 formats),       */
/*                  oosqlErrCode/Msg, oosqlChanges/TotalChanges,              */
/*                  oosqlLastInsertRowID, oosqlGetAutocommit,                 */
/*                  oosqlDbFileName, oosqlDbReadOnly,                         */
/*                  oosqlDbReleaseMemory, oosqlDbStatus, oosqlBusyTimeOut,    */
/*                  oosqlLimit, oosqlInterrupt, oosqlExtendedResultCodes,     */
/*                  oosqlDbMutex, oosqlTableColumnMetadata,                   */
/*                  oosqlIsHandleNull, oosqlNextStmt.                         */
/*                  Statement: oosqlPrepare, oosqlStep, oosqlFinalize,        */
/*                  oosqlReset, oosqlClearBindings, oosqlBind(Int/Text/        */
/*                  Double/Int64/Null), oosqlColumn(Int/Text/Double/Int64/     */
/*                  Name/Type/DeclType/Bytes/Index/Blob/DatabaseName/          */
/*                  TableName/OriginName), oosqlDataCount, oosqlDbHandle,     */
/*                  oosqlStmtReadonly, oosqlStmtBusy, oosqlSql,               */
/*                  oosqlBindParameterCount/Name/Index, oosqlStmtStatus.      */
/*                  Backup: oosqlBackupInit/Step/Finish/PageCount/             */
/*                  Remaining (documents swapped mapping bug).                */
/*                  Mutex: oosqlMutexAlloc/Enter/Leave/Try/Free.              */
/* 20260331    0.9  Tier 4 — Classic callback routines.                       */
/*                  Section C6: oosqlCommitHook (basic, userData, explicit,   */
/*                  veto, deregister, prev-userData), oosqlRollbackHook       */
/*                  (basic, userData, deregister), oosqlUpdateHook (INSERT,   */
/*                  UPDATE/DELETE, userData, deregister), oosqlTrace (basic,  */
/*                  deregister), oosqlProfile (basic, deregister),            */
/*                  trace/profile mutual exclusion, oosqlProgressHandler      */
/*                  (basic, interrupt, deregister), oosqlBusyHandler (basic,  */
/*                  userData, deregister), oosqlSetAuthorizer (register/      */
/*                  deregister only — execution SIGSEGV),                     */
/*                  oosqlCreateCollation (basic, userData, reverse,           */
/*                  deregister), oosqlCollationNeeded (basic, userData,       */
/*                  deregister), oosqlCreateFunction scalar (int, text,       */
/*                  userData) and aggregate (sum, avg).                       */
/*                  Callback routines defined as ::Routine using              */
/*                  .environment for state communication.                    */
/* 20260331    1.0  Tier 4 — Classic result/value routines.                   */
/*                  Section C7: oosqlValueDouble (coercion from all 5        */
/*                  types), oosqlValueBlob (Pointer, NULL), oosqlValue-      */
/*                  NumericType (TEXT coercion to INT/FLOAT),                */
/*                  oosqlResultInt64 (INT64_MAX/MIN), oosqlResultBlob        */
/*                  (binary data via Pointer+length), oosqlResultNull,       */
/*                  oosqlResultZeroBlob, oosqlResultValue (pass-through),   */
/*                  oosqlResultError (custom message), oosqlResultError-     */
/*                  Code (SQLITE_FULL), oosqlResultErrorNoMem,              */
/*                  oosqlResultErrorTooBig.                                  */
/*                  Discovery: oosqlValueInt64 does not exist as a           */
/*                  classic routine (note #26).                              */
/*                                                                            */
/******************************************************************************/

  Parse Source . . fileSpec

  group = .TestGroup~new(fileSpec)
  group~add(.ooSQLite.testGroup)
  group~add(.ooSQLiteClassic.testGroup)

  If group~isAutomatedTest Then Return group

  testResult = group~suite~execute~~print

Return testResult
-- End of entry point.

::Requires 'ooTest.frm'
::Requires 'ooSQLite.cls'
::Requires 'ooSQLite-TestSuite-Callbacks.cls'

/******************************************************************************/
/*                                                                            */
/* ooSQLite.testGroup — comprehensive regression tests for ooSQLite           */
/*                                                                            */
/******************************************************************************/

::Class "ooSQLite.testGroup" Subclass ooTestCase Public

--------------------------------------------------------------------------------
-- Helper: open an in-memory database, check initCode                         --
--------------------------------------------------------------------------------

::Method churnMemory
  -- Makes the garbage collector run, so that memory that is no longer
  -- referenced gets reused.  Callback buffers released too early show up then.
  Do 100
    junk = .Array~new(10000)~fill(Copies("x", 100))
  End

::Method openMemoryDB
  db = .ooSQLiteConnection~new(":memory:")
  self~assertEquals(db~OK, db~initCode, "openMemoryDB: initCode should be OK")
  Return db

--------------------------------------------------------------------------------
-- Helper: open a file database                                               --
--------------------------------------------------------------------------------

::Method openFileDB
  Use Strict Arg fileName
  db = .ooSQLiteConnection~new(fileName)
  self~assertEquals(db~OK, db~initCode, "openFileDB: initCode should be OK for" fileName)
  Return db

--------------------------------------------------------------------------------
-- Helper: create a standard test table with sample data                      --
--------------------------------------------------------------------------------

::Method createTestTable
  Use Strict Arg db
  db~exec("CREATE TABLE foods(id INTEGER PRIMARY KEY, name TEXT, type_id INTEGER);", .true)
  db~exec("INSERT INTO foods VALUES(1, 'Bagels', 1);", .true)
  db~exec("INSERT INTO foods VALUES(2, 'Waffles', 1);", .true)
  db~exec("INSERT INTO foods VALUES(3, 'Sushi', 2);", .true)
  db~exec("INSERT INTO foods VALUES(4, 'Pizza', 3);", .true)
  db~exec("INSERT INTO foods VALUES(5, 'Ice Cream', 4);", .true)
  Return

/******************************************************************************/
/*                                                                            */
/* Section 1: ooSQLite class — static / process-wide methods                  */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- version                                                                    --
--------------------------------------------------------------------------------

::Method testVersionCompact
  v = .ooSQLite~version("C")
  self~assertTrue(v~words = 1, "version(C) should be a single word:" v)
  self~assertTrue(v~pos(".") > 0, "version(C) should contain a dot:" v)

::Method testVersionFull
  v = .ooSQLite~version("F")
  self~assertTrue(v~pos("ooSQLite") > 0, "version(F) should mention ooSQLite")
  self~assertTrue(v~pos("Rexx") > 0, "version(F) should mention Rexx")
  self~assertTrue(v~pos("SQLite") > 0, "version(F) should mention SQLite")

::Method testVersionOneLine
  v = .ooSQLite~version("O")
  self~assertTrue(v~pos("ooSQLite") > 0, "version(O) should mention ooSQLite")

::Method testVersionDefault
  v = .ooSQLite~version
  self~assertTrue(v~pos("ooSQLite") > 0, "version() default should be OneLine")

::Method testVersionLibVersion
  v = .ooSQLite~version("L")
  self~assertEquals(.ooSQLite~libVersion, v, "version(L) should match libVersion")

::Method testVersionNumber
  v = .ooSQLite~version("N")
  self~assertEquals(.ooSQLite~libVersionNumber, v, "version(N) should match libVersionNumber")

::Method testVersionSourceID
  v = .ooSQLite~version("S")
  self~assertEquals(.ooSQLite~sourceID, v, "version(S) should match sourceID")

--------------------------------------------------------------------------------
-- libVersion, libVersionNumber, sqlite3Version, sourceID                     --
--------------------------------------------------------------------------------

::Method testLibVersion
  v = .ooSQLite~libVersion
  self~assertTrue(v~pos(".") > 0, "libVersion should contain dots:" v)

::Method testLibVersionNumber
  n = .ooSQLite~libVersionNumber
  self~assertTrue(n~dataType("W"), "libVersionNumber should be a whole number:" n)
  self~assertTrue(n > 3000000, "libVersionNumber should be > 3000000:" n)

::Method testSqlite3Version
  v = .ooSQLite~sqlite3Version
  self~assertTrue(v~pos(".") > 0, "sqlite3Version should contain dots:" v)

::Method testSourceID
  sid = .ooSQLite~sourceID
  self~assertTrue(sid~length > 10, "sourceID should be a non-trivial string")

--------------------------------------------------------------------------------
-- threadSafe                                                                 --
--------------------------------------------------------------------------------

::Method testThreadSafe
  ts = .ooSQLite~threadSafe
  self~assertTrue(ts >= 0 & ts <= 2, "threadSafe should be 0, 1, or 2:" ts)

--------------------------------------------------------------------------------
-- memoryUsed, memoryHighWater                                                --
--------------------------------------------------------------------------------

::Method testMemoryUsed
  m = .ooSQLite~memoryUsed
  self~assertTrue(m~dataType("W"), "memoryUsed should be a whole number:" m)
  self~assertTrue(m >= 0, "memoryUsed should be >= 0:" m)

::Method testMemoryHighWater
  hw = .ooSQLite~memoryHighWater
  self~assertTrue(hw~dataType("W"), "memoryHighWater should be a whole number:" hw)
  self~assertTrue(hw >= .ooSQLite~memoryUsed, -
    "memoryHighWater should be >= memoryUsed")

::Method testMemoryHighWaterReset
  -- Reset the high water mark
  hwBefore = .ooSQLite~memoryHighWater(.true)
  self~assertTrue(hwBefore~dataType("W"), "memoryHighWater(.true) should return a number")
  -- After reset, high water should equal current usage
  hwAfter = .ooSQLite~memoryHighWater
  mu = .ooSQLite~memoryUsed
  self~assertTrue(hwAfter >= mu, -
    "After reset, highWater should be >= memoryUsed")

--------------------------------------------------------------------------------
-- compileOptionGet, compileOptionUsed                                        --
--------------------------------------------------------------------------------

::Method testCompileOptionGet
  -- Iterate until NULL
  options = .Array~new
  Do i = 1 While .true
    opt = .ooSQLite~compileOptionGet(i)
    If opt = "NULL" Then Leave
    options~append(opt)
  End
  self~assertTrue(options~items > 0, "Should have at least one compile option")

::Method testCompileOptionUsed
  -- THREADSAFE should be defined in our build
  ts = .ooSQLite~compileOptionUsed("THREADSAFE")
  self~assertTrue(ts = 1 | ts = 0, "compileOptionUsed(THREADSAFE) should return 0 or 1")
  -- Also test with SQLITE_ prefix
  ts2 = .ooSQLite~compileOptionUsed("SQLITE_THREADSAFE")
  self~assertEquals(ts, ts2, "THREADSAFE and SQLITE_THREADSAFE should give same result")

--------------------------------------------------------------------------------
-- complete                                                                   --
--------------------------------------------------------------------------------

::Method testCompleteSQL
  self~assertEquals(1, .ooSQLite~complete("SELECT * FROM foo;"), -
    "complete should return 1 for complete SQL")

::Method testIncompleteSQL
  self~assertEquals(0, .ooSQLite~complete("SELECT * FROM foo"), -
    "complete should return 0 for incomplete SQL (no semicolon)")

::Method testCompleteMultiStatement
  self~assertEquals(1, .ooSQLite~complete("SELECT 1; SELECT 2;"), -
    "complete should return 1 for multi-statement SQL")

--------------------------------------------------------------------------------
-- enquote                                                                    --
--------------------------------------------------------------------------------

::Method testEnquoteSimple
  eq = .ooSQLite~enquote("hello")
  self~assertEquals("'hello'", eq, "enquote should wrap in single quotes")

::Method testEnquoteWithQuote
  eq = .ooSQLite~enquote("it's")
  self~assertEquals("'it''s'", eq, "enquote should escape embedded single quotes")

::Method testEnquoteNil
  eq = .ooSQLite~enquote(.nil)
  self~assertEquals("NULL", eq, "enquote(.nil) should return NULL")

::Method testEnquoteEmpty
  eq = .ooSQLite~enquote("")
  self~assertEquals("''", eq, "enquote('') should return empty string literal")

::Method testEnquoteArray
  arr = .Array~of("a", "b", .nil)
  eq = .ooSQLite~enquote(arr)
  self~assertTrue(eq~pos("'a'") > 0, "enquote(array) should contain 'a'")
  self~assertTrue(eq~pos("'b'") > 0, "enquote(array) should contain 'b'")
  self~assertTrue(eq~pos("NULL") > 0, "enquote(array) should contain NULL")

::Method testEnquoteNoArg
  eq = .ooSQLite~enquote
  self~assertEquals("NULL", eq, "enquote() with no arg should return NULL")

::Method testEnquoteNoLimit
  -- The list has no length limit, whatever the number of items: before,
  -- an array of 7 or more items was cut at 4095 characters
  a = "a"~copies(3000); b = "b"~copies(3000)
  self~assertEquals("'" || a || "', '" || b || "'", .ooSQLite~enquote(.array~of(a, b)), "2 long items")
  expected = "'1', '2', '3', '4', '5', '6', '" || a || "', '" || b || "'"
  self~assertEquals(expected, .ooSQLite~enquote(.array~of(1, 2, 3, 4, 5, 6, a, b)), "8 items, long ones last")
  self~assertEquals("NULL", .ooSQLite~enquote(.array~new), "an empty array is NULL")
  self~assertEquals("'x', NULL, 'it''s'", .ooSQLite~enquote(.array~of("x", .nil, "it's")), "NULL and quotes")

--------------------------------------------------------------------------------
-- errStr                                                                     --
--------------------------------------------------------------------------------

::Method testErrStrOK
  s = .ooSQLite~errStr(.ooSQLite~OK)
  self~assertTrue(s~caselessPos("not an error") > 0, -
    "errStr(OK) should say 'not an error':" s)

::Method testErrStrError
  s = .ooSQLite~errStr(.ooSQLite~ERROR)
  self~assertTrue(s~length > 0, "errStr(ERROR) should return something:" s)

--------------------------------------------------------------------------------
-- status                                                                     --
--------------------------------------------------------------------------------

::Method testStatus
  ret = .Directory~new
  rc = .ooSQLite~status(.ooSQLite~STATUS_MEMORY_USED, ret)
  self~assertEquals(.ooSQLite~OK, rc, "status should return OK")
  self~assertTrue(ret~entry("CURRENT")~dataType("W"), -
    "status CURRENT should be a number:" ret~entry("CURRENT"))
  self~assertTrue(ret~entry("HIGHWATER")~dataType("W"), -
    "status HIGHWATER should be a number:" ret~entry("HIGHWATER"))

--------------------------------------------------------------------------------
-- releaseMemory                                                              --
--------------------------------------------------------------------------------

::Method testReleaseMemory
  rc = .ooSQLite~releaseMemory(0)
  self~assertTrue(rc~dataType("W"), "releaseMemory should return a number:" rc)

--------------------------------------------------------------------------------
-- softHeapLimit64                                                            --
--------------------------------------------------------------------------------

::Method testSoftHeapLimit64Query
  limit = .ooSQLite~softHeapLimit64(0)
  self~assertTrue(limit~dataType("W"), "softHeapLimit64(0) should return a number:" limit)

--------------------------------------------------------------------------------
-- null attribute (process-wide)                                              --
--------------------------------------------------------------------------------

::Method testNullAttributeDefault
  self~assertEquals(.nil, .ooSQLite~null, -
    "Default null attribute should be .nil")

::Method testNullAttributeSet
  origNull = .ooSQLite~null
  .ooSQLite~null = "N/A"
  self~assertEquals("N/A", .ooSQLite~null, "null attribute should be settable")
  -- Restore
  .ooSQLite~null = origNull

--------------------------------------------------------------------------------
-- recordFormat attribute (process-wide)                                      --
--------------------------------------------------------------------------------

::Method testRecordFormatDefault
  rf = .ooSQLite~recordFormat
  self~assertEquals(.ooSQLite~OO_ARRAY_OF_DIRECTORIES, rf, -
    "Default recordFormat should be OO_ARRAY_OF_DIRECTORIES")

/******************************************************************************/
/*                                                                            */
/* Section 2: ooSQLiteConnection — lifecycle                                  */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- new (in-memory)                                                            --
--------------------------------------------------------------------------------

::Method testConnectionMemory
  db = self~openMemoryDB
  self~assertFalse(db~closed, "New connection should not be closed")
  self~assertEquals(db~OK, db~initCode, "initCode should be OK")
  db~close

::Method testConnectionMemoryClosed
  db = self~openMemoryDB
  db~close
  self~assertTrue(db~closed, "Connection should be closed after close")

--------------------------------------------------------------------------------
-- new (file-based)                                                           --
--------------------------------------------------------------------------------

::Method testConnectionFile
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_conn.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestConnectionFileCleanup
  db = .ooSQLiteConnection~new(dbFile)
  self~assertEquals(db~OK, db~initCode, "File DB initCode should be OK")
  self~assertFalse(db~closed, "File DB should not be closed")
  db~close

TestConnectionFileCleanup:
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- fileName                                                                   --
--------------------------------------------------------------------------------

::Method testFileName
  db = self~openMemoryDB
  -- For :memory: databases, fileName might be empty or ":memory:"
  fn = db~fileName
  self~assertTrue(fn = "" | fn = ":memory:", -
    "fileName for :memory: should be empty or ':memory:':" fn)
  db~close

--------------------------------------------------------------------------------
-- errCode, errMsg                                                            --
--------------------------------------------------------------------------------

::Method testErrCodeOnSuccess
  db = self~openMemoryDB
  db~exec("SELECT 1;", .true)
  self~assertEquals(db~OK, db~errCode, "errCode after success should be OK")
  db~close

::Method testErrMsgOnSuccess
  db = self~openMemoryDB
  db~exec("SELECT 1;", .true)
  msg = db~errMsg
  self~assertTrue(msg~caselessPos("not an error") > 0, -
    "errMsg after success should say 'not an error':" msg)
  db~close

::Method testErrCodeOnError
  db = self~openMemoryDB
  db~exec("INVALID SQL BLAH;", .true)
  self~assertTrue(db~errCode \= db~OK, "errCode after bad SQL should not be OK")
  db~close

--------------------------------------------------------------------------------
-- lastErrCode, lastErrMsg                                                    --
--------------------------------------------------------------------------------

::Method testLastErrCode
  db = self~openMemoryDB
  self~assertEquals(db~OK, db~lastErrCode, "lastErrCode on new conn should be OK")
  db~close

::Method testLastErrMsg
  db = self~openMemoryDB
  msg = db~lastErrMsg
  self~assertTrue(msg~caselessPos("error") > 0 | msg~caselessPos("no error") > 0, -
    "lastErrMsg on new conn should mention error:" msg)
  db~close

--------------------------------------------------------------------------------
-- double close (should be harmless)                                          --
--------------------------------------------------------------------------------

::Method testDoubleClose
  db = self~openMemoryDB
  db~close
  -- Second close should be a harmless nop
  db~close
  self~assertTrue(db~closed, "Double close should leave connection closed")

--------------------------------------------------------------------------------
-- open with flags                                                            --
--------------------------------------------------------------------------------

::Method testOpenReadOnly
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_ro.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestOpenReadOnlyCleanup

  -- First create the database
  db = .ooSQLiteConnection~new(dbFile)
  db~exec("CREATE TABLE t(x);", .true)
  db~close

  -- Now open read-only
  dbRO = .ooSQLiteConnection~new(dbFile, .ooSQLite~OPEN_READONLY)
  self~assertEquals(dbRO~OK, dbRO~initCode, "Read-only open should succeed")
  self~assertEquals(1, dbRO~dbReadOnly("main"), "dbReadOnly should return 1")
  dbRO~close

TestOpenReadOnlyCleanup:
  Call SysFileDelete dbFile

/******************************************************************************/
/*                                                                            */
/* Section 3: exec + result set formats                                       */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- exec without callback                                                      --
--------------------------------------------------------------------------------

::Method testExecNoCallback
  db = self~openMemoryDB
  rc = db~exec("CREATE TABLE t(x INTEGER);")
  self~assertEquals(db~OK, rc, "exec without callback should return OK")
  db~close

--------------------------------------------------------------------------------
-- exec with internal callback — OO_ARRAY_OF_DIRECTORIES (default)            --
--------------------------------------------------------------------------------

::Method testExecArrayOfDirectories
  db = self~openMemoryDB
  self~createTestTable(db)
  rs = db~exec("SELECT * FROM foods ORDER BY id;", .true)
  self~assertIsA(rs, .Array, "Result set should be an Array")
  self~assertEquals(5, rs~items, "Should have 5 rows")

  row1 = rs[1]
  self~assertIsA(row1, .Directory, "Each row should be a Directory")
  self~assertEquals(1, row1~entry("id"), "First row id should be 1")
  self~assertEquals("Bagels", row1~entry("name"), "First row name should be Bagels")
  db~close

--------------------------------------------------------------------------------
-- exec with OO_ARRAY_OF_ARRAYS                                               --
--------------------------------------------------------------------------------

::Method testExecArrayOfArrays
  db = self~openMemoryDB
  self~createTestTable(db)
  rs = db~exec("SELECT id, name FROM foods ORDER BY id;", .true, -
    .ooSQLite~OO_ARRAY_OF_ARRAYS)
  self~assertIsA(rs, .Array, "Result set should be an Array")
  -- First item is column names array
  colNames = rs[1]
  self~assertIsA(colNames, .Array, "First item should be column names array")
  self~assertEquals("id", colNames[1], "First column name should be 'id'")
  self~assertEquals("name", colNames[2], "Second column name should be 'name'")
  -- Data starts at index 2
  self~assertEquals(1, rs[2][1], "First data row id should be 1")
  self~assertEquals("Bagels", rs[2][2], "First data row name should be Bagels")
  db~close

--------------------------------------------------------------------------------
-- exec with OO_STEM_OF_STEMS                                                 --
--------------------------------------------------------------------------------

::Method testExecStemOfStems
  db = self~openMemoryDB
  self~createTestTable(db)
  rs = db~exec("SELECT id, name FROM foods ORDER BY id;", .true, -
    .ooSQLite~OO_STEM_OF_STEMS)
  self~assertIsA(rs, .Stem, "Result set should be a Stem")
  self~assertEquals(5, rs[0], "stem[0] should be count of rows: 5")
  -- Rows in OO_STEM_OF_STEMS are Stem objects with UPPERCASE column tails
  row1 = rs[1]
  self~assertIsA(row1, .Stem, "Each row should be a Stem")
  self~assertEquals(1, row1["ID"], "First row ID should be 1")
  self~assertEquals("Bagels", row1["NAME"], "First row NAME should be Bagels")
  db~close

--------------------------------------------------------------------------------
-- exec with OO_CLASSIC_STEM                                                  --
--------------------------------------------------------------------------------

::Method testExecClassicStem
  db = self~openMemoryDB
  self~createTestTable(db)
  rs = db~exec("SELECT id, name FROM foods ORDER BY id;", .true, -
    .ooSQLite~OO_CLASSIC_STEM)
  self~assertIsA(rs, .Stem, "Result set should be a Stem")
  self~assertEquals(5, rs[0], "stem[0] should be count of rows: 5")
  -- OO_CLASSIC_STEM uses compound tails like rs["1.ID"], rs["1.NAME"]
  self~assertEquals(1, rs["1.ID"], "Row 1 ID should be 1")
  self~assertEquals("Bagels", rs["1.NAME"], "Row 1 NAME should be Bagels")
  self~assertEquals("Sushi", rs["3.NAME"], "Row 3 NAME should be Sushi")
  db~close

--------------------------------------------------------------------------------
-- exec with empty result set                                                 --
--------------------------------------------------------------------------------

::Method testExecEmptyResultSet
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x);", .true)
  rs = db~exec("SELECT * FROM t;", .true)
  self~assertIsA(rs, .Array, "Empty result set should be an Array")
  self~assertEquals(0, rs~items, "Empty result set should have 0 items")
  db~close

--------------------------------------------------------------------------------
-- exec multi-statement                                                       --
--------------------------------------------------------------------------------

::Method testExecMultiStatement
  db = self~openMemoryDB
  db~exec("CREATE TABLE a(x); CREATE TABLE b(y);", .true)
  -- Both tables should exist
  rs = db~exec("SELECT name FROM sqlite_master WHERE type='table' ORDER BY name;", .true)
  self~assertEquals(2, rs~items, "Should have 2 tables")
  self~assertEquals("a", rs[1]~entry("name"), "First table should be 'a'")
  self~assertEquals("b", rs[2]~entry("name"), "Second table should be 'b'")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 4: DDL + DML — changes, totalChanges, lastInsertRowID              */
/*                                                                            */
/******************************************************************************/

::Method testChanges
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertEquals(1, db~changes, "changes after INSERT should be 1")
  db~exec("INSERT INTO t VALUES(2); INSERT INTO t VALUES(3);", .true)
  self~assertEquals(1, db~changes, "changes reflects last INSERT only")
  db~close

::Method testTotalChanges
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x);", .true)
  db~exec("INSERT INTO t VALUES(1);", .true)
  db~exec("INSERT INTO t VALUES(2);", .true)
  tc = db~totalChanges
  self~assertTrue(tc >= 2, "totalChanges should be >= 2:" tc)
  db~close

::Method testLastInsertRowID
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);", .true)
  db~exec("INSERT INTO t(name) VALUES('first');", .true)
  self~assertEquals(1, db~lastInsertRowID, "First auto-id should be 1")
  db~exec("INSERT INTO t(name) VALUES('second');", .true)
  self~assertEquals(2, db~lastInsertRowID, "Second auto-id should be 2")
  db~close

::Method testUpdateRows
  db = self~openMemoryDB
  self~createTestTable(db)
  db~exec("UPDATE foods SET name='Donuts' WHERE id=1;", .true)
  self~assertEquals(1, db~changes, "changes after UPDATE should be 1")
  rs = db~exec("SELECT name FROM foods WHERE id=1;", .true)
  self~assertEquals("Donuts", rs[1]~entry("name"), "Updated name should be Donuts")
  db~close

::Method testDeleteRows
  db = self~openMemoryDB
  self~createTestTable(db)
  db~exec("DELETE FROM foods WHERE type_id=1;", .true)
  self~assertEquals(2, db~changes, "changes after DELETE should be 2")
  rs = db~exec("SELECT COUNT(*) AS cnt FROM foods;", .true)
  self~assertEquals(3, rs[1]~entry("cnt"), "Should have 3 rows left after DELETE")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 5: Prepared statements (ooSQLiteStmt)                              */
/*                                                                            */
/******************************************************************************/

::Method testPreparedStmtBasic
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods ORDER BY id;")
  self~assertEquals(stmt~OK, stmt~initCode, "Stmt initCode should be OK")
  self~assertFalse(stmt~finalized, "Stmt should not be finalized")
  self~assertEquals(3, stmt~columnCount, "Column count should be 3")
  stmt~finalize
  db~close

::Method testPreparedStmtStep
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name FROM foods ORDER BY id;")
  -- First step should return ROW
  rc = stmt~step
  self~assertEquals(stmt~ROW, rc, "First step should return ROW")
  self~assertEquals(1, stmt~columnInt(1), "First row id should be 1")
  self~assertEquals("Bagels", stmt~columnText(2), "First row name should be Bagels")

  -- Step through remaining rows
  count = 1
  Do While stmt~step = stmt~ROW
    count += 1
  End
  self~assertEquals(5, count, "Should have stepped through 5 rows")

  stmt~finalize
  db~close

::Method testPreparedStmtColumnNames
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name, type_id FROM foods;")
  self~assertEquals("id", stmt~columnName(1), "Column 1 name should be 'id'")
  self~assertEquals("name", stmt~columnName(2), "Column 2 name should be 'name'")
  self~assertEquals("type_id", stmt~columnName(3), "Column 3 name should be 'type_id'")
  stmt~finalize
  db~close

::Method testPreparedStmtBindText
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods WHERE name = ?;")
  stmt~bindText(1, "Sushi")
  rc = stmt~step
  self~assertEquals(stmt~ROW, rc, "Should find Sushi")
  self~assertEquals(3, stmt~columnInt(1), "Sushi id should be 3")
  stmt~finalize
  db~close

::Method testPreparedStmtBindInt
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods WHERE id = ?;")
  stmt~bindInt(1, 4)
  rc = stmt~step
  self~assertEquals(stmt~ROW, rc, "Should find row with id=4")
  self~assertEquals("Pizza", stmt~columnText(2), "Row 4 should be Pizza")
  stmt~finalize
  db~close

::Method testPreparedStmtBindNull
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER, val TEXT);", .true)
  stmt = .ooSQLiteStmt~new(db, "INSERT INTO t VALUES(?, ?);")
  stmt~bindInt(1, 1)
  stmt~bindNull(2)
  stmt~step
  stmt~finalize

  rs = db~exec("SELECT val FROM t WHERE id=1;", .true)
  self~assertEquals(.nil, rs[1]~entry("val"), "NULL value should come back as .nil")
  db~close

::Method testPreparedStmtReset
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods WHERE id = ?;")

  -- First query
  stmt~bindInt(1, 1)
  stmt~step
  self~assertEquals("Bagels", stmt~columnText(2), "First query: Bagels")

  -- Reset and rebind
  stmt~reset
  stmt~clearBindings
  stmt~bindInt(1, 3)
  stmt~step
  self~assertEquals("Sushi", stmt~columnText(2), "After reset: Sushi")

  stmt~finalize
  db~close

::Method testPreparedStmtBindParameterCount
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT ? + ? + ?;")
  self~assertEquals(3, stmt~bindParameterCount, "Should have 3 bind parameters")
  stmt~finalize
  db~close

::Method testPreparedStmtColumnTypes
  db = self~openMemoryDB
  db~exec("CREATE TABLE types(i INTEGER, r REAL, t TEXT, b BLOB);", .true)
  db~exec("INSERT INTO types VALUES(42, 3.14, 'hello', X'DEADBEEF');", .true)

  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM types;")
  stmt~step

  self~assertEquals(42, stmt~columnInt(1), "Integer column value")
  self~assertTrue(stmt~columnDouble(2) > 3.13, "Real column should be ~3.14")
  self~assertTrue(stmt~columnDouble(2) < 3.15, "Real column should be ~3.14")
  self~assertEquals("hello", stmt~columnText(3), "Text column value")
  -- BLOB: verify columnBlob returns something
  blob = stmt~columnBlob(4)
  self~assertTrue(blob~length > 0, "Blob should have length > 0")

  stmt~finalize
  db~close

::Method testPreparedStmtDataCount
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name FROM foods;")
  -- Before stepping, dataCount may be 0
  stmt~step
  self~assertEquals(2, stmt~dataCount, "dataCount should be 2 after step")
  stmt~finalize
  db~close

::Method testPreparedStmtReadonly
  db = self~openMemoryDB
  stmtR = .ooSQLiteStmt~new(db, "SELECT 1;")
  self~assertTrue(stmtR~stmtReadonly \= 0, "SELECT should be readonly")
  stmtR~finalize

  db~exec("CREATE TABLE t(x);", .true)
  stmtW = .ooSQLiteStmt~new(db, "INSERT INTO t VALUES(1);")
  self~assertEquals(0, stmtW~stmtReadonly, "INSERT should not be readonly")
  stmtW~finalize
  db~close

::Method testPreparedStmtDbHandle
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT 1;")
  -- dbHandle should return a valid handle (not null)
  handle = stmt~dbHandle
  self~assertTrue(handle \= .nil, "dbHandle should not be .nil")
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 6: NULL handling at different levels                                */
/*                                                                            */
/******************************************************************************/

::Method testNullAtConnectionLevel
  db = self~openMemoryDB
  db~null = "<NULL>"
  db~exec("CREATE TABLE t(x TEXT);", .true)
  db~exec("INSERT INTO t VALUES(NULL);", .true)
  rs = db~exec("SELECT x FROM t;", .true)
  self~assertEquals("<NULL>", rs[1]~entry("x"), -
    "NULL at connection level should return '<NULL>'")
  db~null = .nil  -- Restore
  db~close

::Method testNullAtStatementLevel
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x TEXT);", .true)
  db~exec("INSERT INTO t VALUES(NULL);", .true)

  stmt = .ooSQLiteStmt~new(db, "SELECT x FROM t;")
  stmt~null = "[empty]"
  stmt~step
  val = stmt~columnText(1)
  self~assertEquals("[empty]", val, -
    "NULL at statement level should return '[empty]'")
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 7: Pragmas                                                         */
/*                                                                            */
/******************************************************************************/

::Method testPragmaTableInfo
  db = self~openMemoryDB
  self~createTestTable(db)
  rs = db~pragma("table_info", "foods")
  self~assertIsA(rs, .Array, "pragma table_info should return an Array")
  self~assertEquals(3, rs~items, "foods table should have 3 columns")
  db~close

::Method testPragmaForeignKeys
  db = self~openMemoryDB
  -- ooSQLite enables foreign keys by default; pragma() returns the value
  rs = db~pragma("foreign_keys")
  -- rs could be a result set (Array) or a direct value depending on the pragma
  If rs~isA(.Array) Then
    self~assertTrue(rs~items > 0, "pragma foreign_keys should return a result")
  Else
    self~assertTrue(rs~dataType("W"), "pragma foreign_keys should return a number:" rs)
  db~close

::Method testPragmaJournalMode
  db = self~openMemoryDB
  rs = db~pragma("journal_mode")
  If rs~isA(.Array) Then
    self~assertTrue(rs~items > 0, "pragma journal_mode should return a result")
  Else
    self~assertTrue(rs~length > 0, "pragma journal_mode should return something:" rs)
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 8: Transactions                                                    */
/*                                                                            */
/******************************************************************************/

::Method testAutocommitDefault
  db = self~openMemoryDB
  self~assertTrue(db~getAutocommit \= 0, -
    "New connection should be in autocommit mode")
  db~close

::Method testExplicitTransaction
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)

  db~exec("BEGIN;")
  self~assertEquals(0, db~getAutocommit, -
    "After BEGIN, autocommit should be off")

  db~exec("INSERT INTO t VALUES(1);", .true)
  db~exec("INSERT INTO t VALUES(2);", .true)
  db~exec("COMMIT;")

  self~assertTrue(db~getAutocommit \= 0, -
    "After COMMIT, autocommit should be on")

  rs = db~exec("SELECT COUNT(*) AS cnt FROM t;", .true)
  self~assertEquals(2, rs[1]~entry("cnt"), "Should have 2 rows after COMMIT")
  db~close

::Method testRollback
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  db~exec("INSERT INTO t VALUES(1);", .true)

  db~exec("BEGIN;")
  db~exec("INSERT INTO t VALUES(2);", .true)
  db~exec("INSERT INTO t VALUES(3);", .true)
  db~exec("ROLLBACK;")

  rs = db~exec("SELECT COUNT(*) AS cnt FROM t;", .true)
  self~assertEquals(1, rs[1]~entry("cnt"), -
    "Should have only 1 row after ROLLBACK")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 9: Backup (ooSQLiteBackup)                                         */
/*                                                                            */
/******************************************************************************/

::Method testBackupMemoryToFile
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_backup.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBackupCleanup

  -- Create source in memory
  srcDB = self~openMemoryDB
  self~createTestTable(srcDB)

  -- Backup to file
  bu = .ooSQLiteBackup~new(srcDB, dbFile)
  self~assertEquals(bu~OK, bu~initCode, "Backup initCode should be OK")
  rc = bu~step(-1)
  self~assertEquals(bu~DONE, rc, "Backup step(-1) should return DONE")
  self~assertTrue(bu~finished, "Backup should be finished")
  srcDB~close

  -- Verify the backup
  dstDB = .ooSQLiteConnection~new(dbFile, .ooSQLite~OPEN_READONLY)
  self~assertEquals(dstDB~OK, dstDB~initCode, "Backup DB should open OK")
  rs = dstDB~exec("SELECT COUNT(*) AS cnt FROM foods;", .true)
  self~assertEquals(5, rs[1]~entry("cnt"), "Backup should contain 5 rows")
  dstDB~close

TestBackupCleanup:
  Call SysFileDelete dbFile

/******************************************************************************/
/*                                                                            */
/* Section 10: Mutex (ooSQLiteMutex)                                          */
/*                                                                            */
/******************************************************************************/

::Method testMutexBasic
  mtx = .ooSQLiteMutex~new
  self~assertFalse(mtx~closed, "New mutex should not be closed")
  mtx~enter
  mtx~leave
  mtx~free
  self~assertTrue(mtx~closed, "Freed mutex should be closed")

::Method testDbMutex
  db = self~openMemoryDB
  mtx = db~dbMutex
  self~assertFalse(mtx~isNull, "DB mutex should not be null")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 11: Callbacks and hooks                                            */
/*                                                                            */
/******************************************************************************/

::Method testBusyTimeOut
  db = self~openMemoryDB
  rc = db~busyTimeOut(3000)
  self~assertEquals(db~OK, rc, "busyTimeOut should return OK")
  -- Reset busy handler
  rc = db~busyTimeOut(0)
  self~assertEquals(db~OK, rc, "busyTimeOut(0) should return OK")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 12: Limits and metadata                                            */
/*                                                                            */
/******************************************************************************/

::Method testLimit
  db = self~openMemoryDB
  -- Query the current SQL length limit
  curLimit = db~limit(.ooSQLite~LIMIT_SQL_LENGTH, -1)
  self~assertTrue(curLimit > 0, "SQL length limit should be > 0:" curLimit)
  db~close

::Method testTableColumnMetadata
  db = self~openMemoryDB
  self~createTestTable(db)
  ret = .Directory~new
  rc = db~tableColumnMetadata("foods", "name", ret)
  self~assertEquals(db~OK, rc, "tableColumnMetadata should return OK")
  self~assertTrue(ret~hasEntry("DATATYPE"), "Should have DATATYPE entry")
  self~assertEquals("TEXT", ret~entry("DATATYPE"), "name column type should be TEXT")
  self~assertTrue(ret~hasEntry("PRIMARYKEY"), "Should have PRIMARYKEY entry")
  db~close

::Method testNextStmt
  db = self~openMemoryDB
  -- With no prepared statements, nextStmt should return .nil
  ns = db~nextStmt
  self~assertEquals(.nil, ns, "nextStmt with no stmts should return .nil")

  stmt1 = .ooSQLiteStmt~new(db, "SELECT 1;")
  ns = db~nextStmt
  self~assertTrue(ns \= .nil, "nextStmt should find stmt1")
  stmt1~finalize
  db~close

::Method testDbStatus
  db = self~openMemoryDB
  self~createTestTable(db)
  ret = .Directory~new
  rc = db~dbStatus(.ooSQLite~DBSTATUS_CACHE_USED, ret)
  self~assertEquals(db~OK, rc, "dbStatus should return OK")
  self~assertTrue(ret~entry("CURRENT")~dataType("W"), -
    "dbStatus CURRENT should be a number")
  db~close

::Method testExtendedResultCodes
  db = self~openMemoryDB
  -- extendedResultCodes is a nop in ooSQLite, should return OK
  rc = db~extendedResultCodes(.true)
  self~assertEquals(db~OK, rc, "extendedResultCodes should return OK")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 13: Edge cases and regressions                                     */
/*                                                                            */
/******************************************************************************/

::Method testEmptyString
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x TEXT);", .true)
  db~exec("INSERT INTO t VALUES('');", .true)
  rs = db~exec("SELECT x FROM t;", .true)
  self~assertEquals("", rs[1]~entry("x"), "Empty string should be preserved")
  db~close

::Method testUnicodeText
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x TEXT);", .true)
  -- Insert some accented characters
  db~exec("INSERT INTO t VALUES('café résumé naïve');", .true)
  rs = db~exec("SELECT x FROM t;", .true)
  self~assertEquals("café résumé naïve", rs[1]~entry("x"), -
    "Unicode text should round-trip")
  db~close

::Method testLargeInsert
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER PRIMARY KEY, val TEXT);", .true)
  db~exec("BEGIN;")
  Do i = 1 To 1000
    db~exec("INSERT INTO t VALUES("i", 'row_"i"');", .true)
  End
  db~exec("COMMIT;")
  rs = db~exec("SELECT COUNT(*) AS cnt FROM t;", .true)
  self~assertEquals(1000, rs[1]~entry("cnt"), "Should have 1000 rows")
  db~close

::Method testInvalidSQL
  db = self~openMemoryDB
  rc = db~exec("THIS IS NOT SQL;")
  self~assertTrue(rc \= db~OK, "Invalid SQL should return an error code")
  db~close

::Method testDropTableAndRecreate
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x);", .true)
  db~exec("INSERT INTO t VALUES(1);", .true)
  db~exec("DROP TABLE t;", .true)
  db~exec("CREATE TABLE t(y TEXT);", .true)
  db~exec("INSERT INTO t VALUES('new');", .true)
  rs = db~exec("SELECT y FROM t;", .true)
  self~assertEquals("new", rs[1]~entry("y"), "Recreated table should work")
  db~close

::Method testMultipleConnections
  db1 = self~openMemoryDB
  db2 = self~openMemoryDB
  db1~exec("CREATE TABLE t1(x);", .true)
  db2~exec("CREATE TABLE t2(y);", .true)
  -- Each :memory: DB is independent
  rs1 = db1~exec("SELECT name FROM sqlite_master WHERE type='table';", .true)
  rs2 = db2~exec("SELECT name FROM sqlite_master WHERE type='table';", .true)
  self~assertEquals(1, rs1~items, "db1 should have 1 table")
  self~assertEquals(1, rs2~items, "db2 should have 1 table")
  self~assertEquals("t1", rs1[1]~entry("name"), "db1 table should be t1")
  self~assertEquals("t2", rs2[1]~entry("name"), "db2 table should be t2")
  db1~close
  db2~close

/******************************************************************************/
/*                                                                            */
/* Section 14: FTS (Full-Text Search) smoke test                              */
/*                                                                            */
/******************************************************************************/

::Method testFTS5
  db = self~openMemoryDB
  Signal On Syntax Name FTS5NotAvailable

  db~exec("CREATE VIRTUAL TABLE docs USING fts5(title, body);", .true)
  db~exec("INSERT INTO docs VALUES('First', 'The quick brown fox');", .true)
  db~exec("INSERT INTO docs VALUES('Second', 'Jumped over the lazy dog');", .true)
  rs = db~exec("SELECT title FROM docs WHERE docs MATCH 'fox';", .true)
  self~assertEquals(1, rs~items, "FTS5 search should find 1 result")
  self~assertEquals("First", rs[1]~entry("title"), "FTS5 should find 'First'")
  db~close
  Return

FTS5NotAvailable:
  -- FTS5 might not be compiled in — skip gracefully
  self~assertTrue(.true, "FTS5 not available — test skipped")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 15: Foreign keys                                                   */
/*                                                                            */
/******************************************************************************/

::Method testForeignKeyEnforcement
  db = self~openMemoryDB
  db~exec("CREATE TABLE parent(id INTEGER PRIMARY KEY);", .true)
  db~exec("CREATE TABLE child(id INTEGER, pid INTEGER REFERENCES parent(id));", .true)
  db~exec("INSERT INTO parent VALUES(1);", .true)

  -- This should succeed (valid foreign key)
  db~exec("INSERT INTO child VALUES(1, 1);", .true)
  self~assertEquals(db~OK, db~errCode, "Valid FK insert should succeed")

  -- This should fail (invalid foreign key) — ooSQLite enables FK by default
  rc = db~exec("INSERT INTO child VALUES(2, 999);")
  self~assertTrue(rc \= db~OK, "Invalid FK insert should fail")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 16: Tier 1 — ooSQLite class: strGlob, encryptionAvailable,         */
/*             recordFormat set                                               */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- strGlob                                                                    --
--------------------------------------------------------------------------------

::Method testStrGlobMatch
  -- strGlob wraps sqlite3_strglob: returns 0 on match, non-zero on mismatch
  rc = .ooSQLite~strGlob("*.txt", "readme.txt")
  self~assertEquals(0, rc, "strGlob: '*.txt' should match 'readme.txt'")

::Method testStrGlobNoMatch
  rc = .ooSQLite~strGlob("*.txt", "readme.doc")
  self~assertTrue(rc \= 0, "strGlob: '*.txt' should not match 'readme.doc'")

::Method testStrGlobQuestionMark
  rc = .ooSQLite~strGlob("test?.dat", "test1.dat")
  self~assertEquals(0, rc, "strGlob: 'test?.dat' should match 'test1.dat'")

::Method testStrGlobCharacterClass
  rc = .ooSQLite~strGlob("[abc]*.txt", "banana.txt")
  self~assertEquals(0, rc, "strGlob: '[abc]*.txt' should match 'banana.txt'")

--------------------------------------------------------------------------------
-- encryptionAvailable                                                        --
--------------------------------------------------------------------------------

::Method testEncryptionAvailable
  ea = .ooSQLite~encryptionAvailable
  -- Our build does not have SEE, so this should be .false (0)
  self~assertTrue(ea = 0 | ea = 1, -
    "encryptionAvailable should return 0 or 1:" ea)

--------------------------------------------------------------------------------
-- recordFormat set (process-wide)                                            --
--------------------------------------------------------------------------------

::Method testRecordFormatSet
  origFmt = .ooSQLite~recordFormat
  Signal On Syntax Name RecFmtSetCleanup
  -- Change to OO_STEM_OF_STEMS
  .ooSQLite~recordFormat = .ooSQLite~OO_STEM_OF_STEMS
  self~assertEquals(.ooSQLite~OO_STEM_OF_STEMS, .ooSQLite~recordFormat, -
    "recordFormat should be OO_STEM_OF_STEMS after set")
  .ooSQLite~recordFormat = origFmt
  Return

RecFmtSetCleanup:
  .ooSQLite~recordFormat = origFmt

::Method testRecordFormatSetAffectsExec
  origFmt = .ooSQLite~recordFormat
  Signal On Syntax Name RecFmtExecCleanup
  -- Set process-wide format BEFORE creating the connection,
  -- because new() snapshots the class recordFormat at init time.
  .ooSQLite~recordFormat = .ooSQLite~OO_STEM_OF_STEMS
  db = .ooSQLiteConnection~new(":memory:")
  self~assertEquals(db~OK, db~initCode, "openMemoryDB: initCode should be OK")
  self~createTestTable(db)
  rs = db~exec("SELECT id, name FROM foods ORDER BY id;", .true)
  self~assertIsA(rs, .Stem, "Result with OO_STEM_OF_STEMS should be a Stem")
  self~assertEquals(5, rs[0], "Stem[0] should be 5")
  db~close
  .ooSQLite~recordFormat = origFmt
  Return

RecFmtExecCleanup:
  .ooSQLite~recordFormat = origFmt

/******************************************************************************/
/*                                                                            */
/* Section 17: Tier 1 — ooSQLiteConnection: dbFileName, dbReleaseMemory,      */
/*             interrupt, extendedErrCode, backupDestination,                  */
/*             recordFormat set                                               */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- dbFileName                                                                 --
--------------------------------------------------------------------------------

::Method testDbFileName
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_dbfn.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestDbFileNameCleanup
  db = self~openFileDB(dbFile)
  fn = db~dbFileName("main")
  self~assertTrue(fn~pos("oosqlite_test_dbfn.db") > 0, -
    "dbFileName('main') should contain the file name:" fn)
  db~close

TestDbFileNameCleanup:
  Call SysFileDelete dbFile

::Method testDbFileNameMemory
  db = self~openMemoryDB
  fn = db~dbFileName("main")
  -- For :memory: databases, dbFileName returns "" (empty string)
  self~assertEquals("", fn, -
    "dbFileName('main') for :memory: should be empty:" fn)
  db~close

--------------------------------------------------------------------------------
-- dbReleaseMemory                                                            --
--------------------------------------------------------------------------------

::Method testDbReleaseMemory
  db = self~openMemoryDB
  self~createTestTable(db)
  rc = db~dbReleaseMemory
  self~assertEquals(db~OK, rc, "dbReleaseMemory should return OK")
  db~close

--------------------------------------------------------------------------------
-- interrupt                                                                  --
--------------------------------------------------------------------------------

::Method testInterrupt
  db = self~openMemoryDB
  -- interrupt on an idle connection is a harmless nop
  db~interrupt
  -- If we get here without error, the test passes
  self~assertTrue(.true, "interrupt on idle connection should not raise error")
  db~close

--------------------------------------------------------------------------------
-- extendedErrCode                                                            --
--------------------------------------------------------------------------------

::Method testExtendedErrCode
  db = self~openMemoryDB
  -- On a fresh connection, extendedErrCode should be OK (0)
  ec = db~extendedErrCode
  self~assertEquals(db~OK, ec, "extendedErrCode on new conn should be OK")
  db~close

::Method testExtendedErrCodeAfterError
  db = self~openMemoryDB
  db~exec("INVALID SQL BLAH;", .true)
  ec = db~extendedErrCode
  self~assertTrue(ec \= db~OK, "extendedErrCode after bad SQL should not be OK")
  db~close

--------------------------------------------------------------------------------
-- backupDestination                                                          --
--------------------------------------------------------------------------------

::Method testBackupDestination
  db = self~openMemoryDB
  bd = db~backupDestination
  -- A normal connection should not be a backup destination
  self~assertFalse(bd, "backupDestination should be .false for normal conn")
  db~close

--------------------------------------------------------------------------------
-- recordFormat set (connection level)                                        --
--------------------------------------------------------------------------------

::Method testConnectionRecordFormatSet
  db = self~openMemoryDB
  self~createTestTable(db)
  -- Set connection-level format to OO_ARRAY_OF_ARRAYS
  db~recordFormat = .ooSQLite~OO_ARRAY_OF_ARRAYS
  self~assertEquals(.ooSQLite~OO_ARRAY_OF_ARRAYS, db~recordFormat, -
    "Connection recordFormat should be OO_ARRAY_OF_ARRAYS after set")
  rs = db~exec("SELECT id, name FROM foods ORDER BY id;", .true)
  self~assertIsA(rs, .Array, "Result with OO_ARRAY_OF_ARRAYS should be an Array")
  -- First item is column names, data starts at index 2
  colNames = rs[1]
  self~assertIsA(colNames, .Array, "First item should be column names array")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 18: Tier 1 — ooSQLiteStmt: bindDouble, bindBlob, bindInt64,        */
/*             columnBytes, columnDeclType, columnType, columnIndex,           */
/*             columnInt64, bindParameterIndex, bindParameterName,             */
/*             stmtBusy, stmtStatus, lastErrCode, lastErrMsg                  */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- bindDouble                                                                 --
--------------------------------------------------------------------------------

::Method testBindDouble
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER, val REAL);", .true)
  stmt = .ooSQLiteStmt~new(db, "INSERT INTO t VALUES(?, ?);")
  stmt~bindInt(1, 1)
  stmt~bindDouble(2, 3.14159)
  stmt~step
  stmt~finalize
  rs = db~exec("SELECT val FROM t WHERE id=1;", .true)
  val = rs[1]~entry("val")
  self~assertTrue(val > 3.14, "bindDouble: value should be > 3.14:" val)
  self~assertTrue(val < 3.15, "bindDouble: value should be < 3.15:" val)
  db~close

--------------------------------------------------------------------------------
-- bindBlob                                                                   --
--------------------------------------------------------------------------------

::Method testBindBlob
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER, data BLOB);", .true)
  blobData = "DEADBEEF"x
  stmt = .ooSQLiteStmt~new(db, "INSERT INTO t VALUES(?, ?);")
  stmt~bindInt(1, 1)
  stmt~bindBlob(2, blobData)
  stmt~step
  stmt~finalize
  -- Retrieve and verify
  stmt2 = .ooSQLiteStmt~new(db, "SELECT data FROM t WHERE id=1;")
  stmt2~step
  retrieved = stmt2~columnBlob(1)
  self~assertEquals(blobData, retrieved, "bindBlob: round-trip should preserve data")
  stmt2~finalize
  db~close

--------------------------------------------------------------------------------
-- bindInt64                                                                  --
--------------------------------------------------------------------------------

::Method testBindInt64
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(id INTEGER, big INTEGER);", .true)
  -- Use a value larger than 32-bit range
  bigVal = 9876543210
  stmt = .ooSQLiteStmt~new(db, "INSERT INTO t VALUES(1, ?);")
  stmt~bindInt64(1, bigVal)
  stmt~step
  stmt~finalize
  stmt2 = .ooSQLiteStmt~new(db, "SELECT big FROM t WHERE id=1;")
  stmt2~step
  retrieved = stmt2~columnInt64(1)
  self~assertEquals(bigVal, retrieved, "bindInt64/columnInt64 round-trip")
  stmt2~finalize
  db~close

--------------------------------------------------------------------------------
-- columnBytes                                                                --
--------------------------------------------------------------------------------

::Method testColumnBytes
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(val TEXT);", .true)
  db~exec("INSERT INTO t VALUES('hello');", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT val FROM t;")
  stmt~step
  bytes = stmt~columnBytes(1)
  self~assertTrue(bytes >= 5, "columnBytes for 'hello' should be >= 5:" bytes)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- columnDeclType                                                             --
--------------------------------------------------------------------------------

::Method testColumnDeclType
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(i INTEGER, r REAL, t TEXT, b BLOB);", .true)
  db~exec("INSERT INTO t VALUES(1, 1.0, 'x', X'FF');", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM t;")
  stmt~step
  self~assertEquals("INTEGER", stmt~columnDeclType(1), -
    "columnDeclType(1) should be INTEGER")
  self~assertEquals("REAL", stmt~columnDeclType(2), -
    "columnDeclType(2) should be REAL")
  self~assertEquals("TEXT", stmt~columnDeclType(3), -
    "columnDeclType(3) should be TEXT")
  self~assertEquals("BLOB", stmt~columnDeclType(4), -
    "columnDeclType(4) should be BLOB")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- columnType                                                                 --
--------------------------------------------------------------------------------

::Method testColumnType
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(i INTEGER, r REAL, t TEXT, b BLOB, n);", .true)
  db~exec("INSERT INTO t VALUES(42, 3.14, 'hello', X'FF', NULL);", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM t;")
  stmt~step
  self~assertEquals(.ooSQLite~INTEGER, stmt~columnType(1), -
    "columnType(1) should be INTEGER")
  self~assertEquals(.ooSQLite~FLOAT, stmt~columnType(2), -
    "columnType(2) should be FLOAT")
  self~assertEquals(.ooSQLite~TEXT, stmt~columnType(3), -
    "columnType(3) should be TEXT")
  self~assertEquals(.ooSQLite~BLOB, stmt~columnType(4), -
    "columnType(4) should be BLOB")
  self~assertEquals(.ooSQLite~SQLNULL, stmt~columnType(5), -
    "columnType(5) should be SQLNULL")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- columnIndex                                                                --
--------------------------------------------------------------------------------

::Method testColumnIndex
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name, type_id FROM foods;")
  -- columnIndex returns the 1-based index for a column name
  self~assertEquals(1, stmt~columnIndex("id"), "columnIndex('id') should be 1")
  self~assertEquals(2, stmt~columnIndex("name"), "columnIndex('name') should be 2")
  self~assertEquals(3, stmt~columnIndex("type_id"), -
    "columnIndex('type_id') should be 3")
  stmt~finalize
  db~close

::Method testColumnIndexNoLeak
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name, type_id FROM foods;")
  -- columnIndex makes upper case copies of the names with sqlite3_malloc;
  -- all of them must be freed, whether the name is found or not
  idx = stmt~columnIndex("type_id")
  idx = stmt~columnIndex("nosuchcolumn")
  before = .ooSQLite~memoryUsed
  Do 1000
    idx = stmt~columnIndex("type_id")
    idx = stmt~columnIndex("nosuchcolumn")
  End
  growth = .ooSQLite~memoryUsed - before
  self~assertTrue(growth < 1000, -
    "columnIndex should not leak SQLite memory; growth:" growth "bytes")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- columnInt64                                                                --
--------------------------------------------------------------------------------

::Method testColumnInt64
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(big INTEGER);", .true)
  bigVal = 9876543210
  db~exec("INSERT INTO t VALUES("bigVal");", .true)
  stmt = .ooSQLiteStmt~new(db, "SELECT big FROM t;")
  stmt~step
  retrieved = stmt~columnInt64(1)
  self~assertEquals(bigVal, retrieved, "columnInt64 should handle large values")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- bindParameterIndex                                                         --
--------------------------------------------------------------------------------

::Method testBindParameterIndex
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT :alpha + :beta + :gamma;")
  idx = stmt~bindParameterIndex(":alpha")
  self~assertEquals(1, idx, "bindParameterIndex(':alpha') should be 1")
  idx = stmt~bindParameterIndex(":beta")
  self~assertEquals(2, idx, "bindParameterIndex(':beta') should be 2")
  idx = stmt~bindParameterIndex(":gamma")
  self~assertEquals(3, idx, "bindParameterIndex(':gamma') should be 3")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- bindParameterName                                                          --
--------------------------------------------------------------------------------

::Method testBindParameterName
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT :alpha + :beta;")
  self~assertEquals(":alpha", stmt~bindParameterName(1), -
    "bindParameterName(1) should be ':alpha'")
  self~assertEquals(":beta", stmt~bindParameterName(2), -
    "bindParameterName(2) should be ':beta'")
  stmt~finalize
  db~close

::Method testBindParameterNamePositional
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT ? + ?;")
  -- Positional parameters have no name — should return .nil or empty
  n = stmt~bindParameterName(1)
  self~assertTrue(n = .nil | n = "", -
    "bindParameterName for ? should be .nil or empty:" n)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- stmtBusy                                                                   --
--------------------------------------------------------------------------------

::Method testStmtBusy
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods;")
  -- Before stepping, stmt should not be busy
  self~assertEquals(0, stmt~stmtBusy, "stmtBusy before step should be 0")
  -- After stepping, stmt should be busy (has a row)
  stmt~step
  self~assertTrue(stmt~stmtBusy \= 0, "stmtBusy after step should be non-zero")
  -- After reset, stmt should not be busy
  stmt~reset
  self~assertEquals(0, stmt~stmtBusy, "stmtBusy after reset should be 0")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- stmtStatus                                                                 --
--------------------------------------------------------------------------------

::Method testStmtStatus
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods ORDER BY id;")
  -- Step through all rows to accumulate VM steps
  Do While stmt~step = stmt~ROW
    Nop
  End
  -- STMTSTATUS_VM_STEP (0) should show some steps executed
  vmSteps = stmt~stmtStatus(.ooSQLite~STMTSTATUS_VM_STEP)
  self~assertTrue(vmSteps~dataType("W"), -
    "stmtStatus(VM_STEP) should be a number:" vmSteps)
  self~assertTrue(vmSteps > 0, "stmtStatus(VM_STEP) should be > 0:" vmSteps)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- lastErrCode, lastErrMsg (statement level)                                  --
--------------------------------------------------------------------------------

::Method testStmtLastErrCode
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods;")
  self~assertEquals(stmt~OK, stmt~lastErrCode, -
    "Stmt lastErrCode after init should be OK")
  stmt~finalize
  db~close

::Method testStmtLastErrMsg
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods;")
  msg = stmt~lastErrMsg
  self~assertTrue(msg~length > 0, -
    "Stmt lastErrMsg should return a non-empty string:" msg)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- recordFormat (statement level)                                             --
--------------------------------------------------------------------------------

::Method testStmtRecordFormatDefault
  db = self~openMemoryDB
  db~recordFormat = db~OO_STEM_OF_STEMS
  stmt = .ooSQLiteStmt~new(db, "SELECT 1;")
  self~assertEquals(db~OO_STEM_OF_STEMS, stmt~recordFormat, -
    "Stmt recordFormat should default to the connection's recordFormat")
  stmt~finalize
  db~close

::Method testStmtRecordFormatArg
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT 1;", db~OO_CLASSIC_STEM)
  self~assertEquals(db~OO_CLASSIC_STEM, stmt~recordFormat, -
    "Stmt recordFormat should be the format given to new")
  stmt~finalize
  db~close

::Method testStmtRecordFormatSet
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT 1;", db~OO_ARRAY_OF_ARRAYS)
  stmt~recordFormat = db~OO_CLASSIC_STEM
  self~assertEquals(db~OO_CLASSIC_STEM, stmt~recordFormat, -
    "Stmt recordFormat should be the format just set")
  -- Setting it must not touch anything else in the statement
  self~assertEquals(0, stmt~initCode, "Stmt initCode should still be 0")
  self~assertEquals(db~OO_ARRAY_OF_DIRECTORIES, db~recordFormat, -
    "Connection recordFormat should not change")
  stmt~finalize
  db~close

::Method testStmtRecordFormatSetInvalid
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT 1;")
  raised = .false
  Signal On Syntax Name StmtRecFmtInvalid
  stmt~recordFormat = 9
  Signal StmtRecFmtDone
StmtRecFmtInvalid:
  raised = .true
StmtRecFmtDone:
  Signal Off Syntax
  self~assertTrue(raised, "Setting recordFormat to 9 should raise a syntax error")
  self~assertEquals(0, stmt~initCode, "Stmt initCode should still be 0")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- sql                                                                        --
--------------------------------------------------------------------------------

::Method testStmtSql
  db = self~openMemoryDB
  self~createTestTable(db)
  sql = "SELECT name FROM foods WHERE id = ?;"
  stmt = .ooSQLiteStmt~new(db, sql)
  self~assertEquals(sql, stmt~sql, "Stmt sql should be the prepared SQL text")
  -- Binding values does not change the text
  stmt~bindInt(1, 1)
  self~assertEquals(sql, stmt~sql, "Stmt sql should not change after a bind")
  stmt~finalize
  db~close

::Method testStmtSqlFirstOnly
  db = self~openMemoryDB
  -- Only the first statement is prepared; sql returns just that one
  stmt = .ooSQLiteStmt~new(db, "SELECT 1; SELECT 2;")
  self~assertEquals("SELECT 1;", stmt~sql, -
    "Stmt sql should be the text of the first statement only")
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 18B: Tier 1 — ooSQLite: zeroPointer                                */
/*              ooSQLiteStmt: columnDataBaseName, columnOriginName,            */
/*              columnTableName, bindZeroBlob, value                           */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- zeroPointer                                                                --
--------------------------------------------------------------------------------

::Method testZeroPointer
  zp = .ooSQLite~zeroPointer
  self~assertTrue(zp~isA(.Pointer), -
    "zeroPointer should be a Pointer object")
  self~assertEquals("0x0", zp~string, -
    "zeroPointer string should be '0x0'")

--------------------------------------------------------------------------------
-- columnDataBaseName, columnOriginName, columnTableName                      --
--------------------------------------------------------------------------------

::Method testColumnDataBaseName
  db = self~openMemoryDB
  db~exec("CREATE TABLE t1 (id INTEGER PRIMARY KEY, name TEXT)")
  db~exec("INSERT INTO t1 VALUES (1, 'Alice')")
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name FROM t1")
  stmt~step
  self~assertEquals("main", stmt~columnDataBaseName(1), -
    "columnDataBaseName(1) should be 'main'")
  self~assertEquals("main", stmt~columnDataBaseName(2), -
    "columnDataBaseName(2) should be 'main'")
  stmt~finalize
  db~close

::Method testColumnOriginName
  db = self~openMemoryDB
  db~exec("CREATE TABLE t1 (id INTEGER PRIMARY KEY, name TEXT)")
  db~exec("INSERT INTO t1 VALUES (1, 'Alice')")
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name FROM t1")
  stmt~step
  self~assertEquals("id", stmt~columnOriginName(1), -
    "columnOriginName(1) should be 'id'")
  self~assertEquals("name", stmt~columnOriginName(2), -
    "columnOriginName(2) should be 'name'")
  stmt~finalize
  db~close

::Method testColumnOriginNameWithAlias
  db = self~openMemoryDB
  db~exec("CREATE TABLE t1 (id INTEGER PRIMARY KEY, name TEXT)")
  db~exec("INSERT INTO t1 VALUES (1, 'Alice')")
  stmt = .ooSQLiteStmt~new(db, "SELECT id AS person_id, name AS person_name FROM t1")
  stmt~step
  -- columnName returns the alias
  self~assertEquals("person_id", stmt~columnName(1), -
    "columnName(1) should be the alias 'person_id'")
  -- columnOriginName returns the original column name
  self~assertEquals("id", stmt~columnOriginName(1), -
    "columnOriginName(1) should be original 'id' even with alias")
  self~assertEquals("name", stmt~columnOriginName(2), -
    "columnOriginName(2) should be original 'name' even with alias")
  stmt~finalize
  db~close

::Method testColumnTableName
  db = self~openMemoryDB
  db~exec("CREATE TABLE t1 (id INTEGER PRIMARY KEY, name TEXT)")
  db~exec("INSERT INTO t1 VALUES (1, 'Alice')")
  stmt = .ooSQLiteStmt~new(db, "SELECT id, name FROM t1")
  stmt~step
  self~assertEquals("t1", stmt~columnTableName(1), -
    "columnTableName(1) should be 't1'")
  self~assertEquals("t1", stmt~columnTableName(2), -
    "columnTableName(2) should be 't1'")
  stmt~finalize
  db~close

::Method testColumnTableNameMultiTable
  db = self~openMemoryDB
  db~exec("CREATE TABLE authors (id INTEGER PRIMARY KEY, name TEXT)")
  db~exec("CREATE TABLE books (id INTEGER, title TEXT, author_id INTEGER)")
  db~exec("INSERT INTO authors VALUES (1, 'Tolkien')")
  db~exec("INSERT INTO books VALUES (1, 'The Hobbit', 1)")
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT b.title, a.name FROM books b JOIN authors a ON b.author_id = a.id")
  stmt~step
  self~assertEquals("books", stmt~columnTableName(1), -
    "columnTableName(1) should be 'books' for b.title")
  self~assertEquals("authors", stmt~columnTableName(2), -
    "columnTableName(2) should be 'authors' for a.name")
  self~assertEquals("title", stmt~columnOriginName(1), -
    "columnOriginName(1) should be 'title'")
  self~assertEquals("name", stmt~columnOriginName(2), -
    "columnOriginName(2) should be 'name'")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- bindZeroBlob                                                               --
--------------------------------------------------------------------------------

::Method testBindZeroBlob
  db = self~openMemoryDB
  db~exec("CREATE TABLE blobs (id INTEGER, data BLOB)")
  stmt = .ooSQLiteStmt~new(db, "INSERT INTO blobs VALUES (1, ?)")
  rc = stmt~bindZeroBlob(1, 100)
  self~assertEquals(stmt~OK, rc, -
    "bindZeroBlob should return OK")
  stmt~step
  stmt~finalize
  -- Verify the blob was stored with correct length
  stmt2 = .ooSQLiteStmt~new(db, "SELECT data FROM blobs WHERE id = 1")
  stmt2~step
  bytes = stmt2~columnBytes(1)
  self~assertEquals(100, bytes, -
    "zeroblob should have length 100")
  -- Verify all bytes are zero
  blob = stmt2~columnBlob(1)
  allZero = 1
  Do i = 1 To blob~length
    If blob[i] \== "00"x Then Do
      allZero = 0
      Leave
    End
  End
  self~assertTrue(allZero, -
    "All bytes in zeroblob should be zero")
  stmt2~finalize
  db~close

::Method testBindZeroBlobSmall
  db = self~openMemoryDB
  db~exec("CREATE TABLE blobs (id INTEGER, data BLOB)")
  stmt = .ooSQLiteStmt~new(db, "INSERT INTO blobs VALUES (1, ?)")
  rc = stmt~bindZeroBlob(1, 0)
  self~assertEquals(stmt~OK, rc, -
    "bindZeroBlob with length 0 should return OK")
  stmt~step
  stmt~finalize
  stmt2 = .ooSQLiteStmt~new(db, "SELECT data FROM blobs WHERE id = 1")
  stmt2~step
  bytes = stmt2~columnBytes(1)
  self~assertEquals(0, bytes, -
    "zeroblob with length 0 should have 0 bytes")
  stmt2~finalize
  db~close

--------------------------------------------------------------------------------
-- value (stmt pointer as hex string)                                         --
--------------------------------------------------------------------------------

::Method testStmtValue
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT 42")
  valStr = stmt~value
  self~assertTrue(valStr~length > 0, -
    "stmt value should return a non-empty string")
  -- The C++ uses snprintf("0x%p",...) and on Linux %p includes 0x prefix,
  -- so the result is "0x0x..." — a known cosmetic quirk
  self~assertTrue(valStr~left(2) = "0x", -
    "stmt value should start with '0x':" valStr)
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 19: Tier 1 — ooSQLiteBackup: pageCount, remaining, finish,         */
/*             getDestConn, lastErrCode, lastErrMsg                           */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- pageCount, remaining during backup                                         --
--------------------------------------------------------------------------------

::Method testBackupPageCountRemaining
  srcDB = self~openMemoryDB
  self~createTestTable(srcDB)
  -- Do a multi-step backup to observe pageCount/remaining
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_bu_pc.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBuPCCleanup

  bu = .ooSQLiteBackup~new(srcDB, dbFile)
  self~assertEquals(bu~OK, bu~initCode, "Backup initCode should be OK")

  pc = bu~pageCount
  self~assertTrue(pc~dataType("W"), "pageCount should be a number:" pc)
  self~assertTrue(pc > 0, "pageCount should be > 0:" pc)

  rem = bu~remaining
  self~assertTrue(rem~dataType("W"), "remaining should be a number:" rem)
  self~assertTrue(rem > 0, "remaining should be > 0:" rem)
  self~assertTrue(rem <= pc, "remaining should be <= pageCount")

  -- Finish the backup
  bu~step(-1)
  srcDB~close
  Call SysFileDelete dbFile
  Return

TestBuPCCleanup:
  srcDB~close
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- finish (explicit abandon)                                                  --
--------------------------------------------------------------------------------

::Method testBackupFinishExplicit
  srcDB = self~openMemoryDB
  self~createTestTable(srcDB)
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_bu_fin.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBuFinCleanup

  bu = .ooSQLiteBackup~new(srcDB, dbFile)
  self~assertEquals(bu~OK, bu~initCode, "Backup initCode should be OK")
  -- Abandon the backup via explicit finish
  rc = bu~finish
  self~assertEquals(bu~OK, rc, "finish should return OK")
  self~assertTrue(bu~finished, "Backup should be finished after finish")
  srcDB~close
  Call SysFileDelete dbFile
  Return

TestBuFinCleanup:
  srcDB~close
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- getDestConn with saveDestConn                                              --
--------------------------------------------------------------------------------

::Method testBackupGetDestConn
  srcDB = self~openMemoryDB
  self~createTestTable(srcDB)
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_bu_gdc.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBuGDCCleanup

  bu = .ooSQLiteBackup~new(srcDB, dbFile)
  self~assertEquals(bu~OK, bu~initCode, "Backup initCode should be OK")
  bu~saveDestConn = .true
  bu~step(-1)
  -- Now getDestConn should return a usable connection
  dstConn = bu~getDestConn
  self~assertTrue(dstConn \= .nil, "getDestConn should not be .nil")
  -- Verify we can query the backup
  rs = dstConn~exec("SELECT COUNT(*) AS cnt FROM foods;", .true)
  self~assertEquals(5, rs[1]~entry("cnt"), -
    "getDestConn DB should have 5 rows in foods")
  dstConn~close
  srcDB~close
  Call SysFileDelete dbFile
  Return

TestBuGDCCleanup:
  srcDB~close
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- lastErrCode, lastErrMsg (backup)                                           --
--------------------------------------------------------------------------------

::Method testBackupLastErrCode
  srcDB = self~openMemoryDB
  self~createTestTable(srcDB)
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_bu_ec.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBuECCleanup

  bu = .ooSQLiteBackup~new(srcDB, dbFile)
  self~assertEquals(bu~OK, bu~lastErrCode, -
    "Backup lastErrCode after init should be OK")
  bu~step(-1)
  srcDB~close
  Call SysFileDelete dbFile
  Return

TestBuECCleanup:
  srcDB~close
  Call SysFileDelete dbFile

::Method testBackupLastErrMsg
  srcDB = self~openMemoryDB
  self~createTestTable(srcDB)
  tempFile = .TemporaryTestFile~new(.nil, "oosqlite_test_bu_em.db")
  dbFile = tempFile~fullName
  Signal On Syntax Name TestBuEMCleanup

  bu = .ooSQLiteBackup~new(srcDB, dbFile)
  msg = bu~lastErrMsg
  self~assertTrue(msg~length > 0, -
    "Backup lastErrMsg should return a non-empty string:" msg)
  bu~step(-1)
  srcDB~close
  Call SysFileDelete dbFile
  Return

TestBuEMCleanup:
  srcDB~close
  Call SysFileDelete dbFile

/******************************************************************************/
/*                                                                            */
/* Section 20: Tier 1 — ooSQLiteMutex: try                                   */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- mutex try                                                                  --
--------------------------------------------------------------------------------

::Method testMutexAfterFree
  -- A freed mutex can not be used: enter, leave and try raise 98.900;
  -- freeing it again does nothing
  mtx = .ooSQLiteMutex~new
  self~assertEquals(0, mtx~free, "free")
  Do m Over .array~of("ENTER", "LEAVE", "TRY")
    self~assertEquals("98.900 The ooSQLite mutex is not valid, it has been closed.", -
      self~mutexError(mtx, m), m "of a freed mutex")
  End
  self~assertEquals(0, mtx~free, "freeing a freed mutex does nothing")

::Method testDbMutexAfterClose
  -- The mutex objects of a connection are closed when the connection is
  -- closed: SQLite frees the mutex, so they can not be used any more
  db = self~openMemoryDB
  m1 = db~dbMutex
  m2 = db~dbMutex
  self~assertEquals(0, m1~enter, "enter while the connection is open")
  self~assertEquals(0, m1~leave, "leave while the connection is open")
  self~assertEquals(0, db~close, "close")
  Do m Over .array~of(m1, m2)
    self~assertTrue(m~closed, "the mutex of a closed connection is closed")
    self~assertTrue(m~isNull, "the mutex of a closed connection is null")
    self~assertEquals("98.900 The ooSQLite mutex is not valid, it has been closed.", -
      self~mutexError(m, "ENTER"), "enter after the connection is closed")
  End

::Method mutexError
  -- Sends msgName to mtx, returns the code and message of the syntax error
  Use Strict Arg mtx, msgName
  Signal On Syntax
  mtx~send(msgName)
  Return "no error"
Syntax:
  co = Condition("O")
  Return co~code co~message

::Method testMutexTry
  mtx = .ooSQLiteMutex~new
  -- try should succeed on a free mutex (returns SQLITE_OK = 0)
  rc = mtx~try
  self~assertEquals(.ooSQLite~OK, rc, "try on free mutex should return OK")
  -- We acquired the mutex, so leave it
  mtx~leave
  mtx~free

/******************************************************************************/
/*                                                                            */
/* Section 21: Tier 2 — commitHook                                            */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- commitHook: basic registration and invocation                              --
--------------------------------------------------------------------------------

::Method testCommitHook
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  handler = .CommitHookHandler~new
  db~commitHook(handler)
  -- Autocommit INSERT triggers the commit hook
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertTrue(handler~callCount > 0, -
    "commitHook should be invoked on autocommit INSERT")
  db~close

--------------------------------------------------------------------------------
-- commitHook: userData propagation                                           --
--------------------------------------------------------------------------------

::Method testCommitHookUserData
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  handler = .CommitHookHandler~new
  myData = "commit_user_data"
  db~commitHook(handler,, myData)
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertEquals(myData, handler~lastUserData, -
    "commitHook should receive userData")
  db~close

--------------------------------------------------------------------------------
-- commitHook: explicit transaction fires hook once                           --
--------------------------------------------------------------------------------

::Method testCommitHookExplicitTransaction
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  handler = .CommitHookHandler~new
  db~commitHook(handler)
  db~exec("BEGIN;")
  db~exec("INSERT INTO t VALUES(1);", .true)
  db~exec("INSERT INTO t VALUES(2);", .true)
  db~exec("COMMIT;")
  self~assertEquals(1, handler~callCount, -
    "commitHook should fire once for explicit COMMIT")
  db~close

--------------------------------------------------------------------------------
-- commitHook: veto converts COMMIT into ROLLBACK                             --
--------------------------------------------------------------------------------

::Method testCommitHookVeto
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  db~exec("INSERT INTO t VALUES(1);", .true)
  -- Install vetoing handler
  vetoHandler = .VetoingCommitHookHandler~new
  db~commitHook(vetoHandler)
  db~exec("BEGIN;")
  db~exec("INSERT INTO t VALUES(99);", .true)
  db~exec("COMMIT;")
  -- The vetoed INSERT should not be persisted
  rs = db~exec("SELECT COUNT(*) AS cnt FROM t;", .true)
  self~assertEquals(1, rs[1]~entry("cnt"), -
    "Vetoed commit should not persist the INSERT (expect 1 row)")
  self~assertTrue(vetoHandler~callCount > 0, -
    "VetoingCommitHookHandler should have been invoked")
  db~close

--------------------------------------------------------------------------------
-- commitHook: deregistration                                                 --
--------------------------------------------------------------------------------

::Method testCommitHookDeregister
  db = self~openMemoryDB
  db~exec("CREATE TABLE t(x INTEGER);", .true)
  handler = .CommitHookHandler~new
  db~commitHook(handler)
  db~exec("INSERT INTO t VALUES(1);", .true)
  self~assertTrue(handler~callCount > 0, -
    "commitHook should be invoked before deregister")
  -- Deregister
  db~commitHook(.nil)
  handler~reset
  db~exec("INSERT INTO t VALUES(2);", .true)
  self~assertEquals(0, handler~callCount, -
    "commitHook should not be invoked after deregister")
  db~close

/******************************************************************************/
/*                                                                            */
/* Section 22: Tier 2 — rollbackHook                                          */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- rollbackHook: basic registration and invocation                            --
--------------------------------------------------------------------------------

::Method testRollbackHook
