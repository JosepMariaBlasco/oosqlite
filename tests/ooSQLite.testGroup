  ret = oosqlCollationNeeded(db, "classicCollNeededCB")
  self~assertEquals(0, ret, -
    "oosqlCollationNeeded registration should return OK")
  -- Use unknown collation — triggers the callback
  rs = oosqlExec(db, -
    "SELECT name FROM t ORDER BY name COLLATE DYNAMIC_CL;", .true, 2)
  self~assertEquals("Apple", rs[1]["NAME"], -
    "Dynamically registered collation should sort correctly")
  self~assertEquals("banana", rs[2]["NAME"], -
    "Dynamically registered collation should sort correctly")
  Call oosqlClose db

