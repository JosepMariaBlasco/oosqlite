  db~close

--------------------------------------------------------------------------------
-- Math functions: trigonometry (sin, cos, tan, asin, acos, atan, atan2)      --
--------------------------------------------------------------------------------

::Method testMathCos
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT cos(0);")
  stmt~step
  self~assertEquals(1.0, stmt~columnDouble(1), "cos(0) should be 1.0")
  stmt~finalize
  db~close

::Method testMathSin
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT sin(0);")
  stmt~step
  self~assertEquals(0.0, stmt~columnDouble(1), "sin(0) should be 0.0")
  stmt~finalize
  db~close

::Method testMathTan
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT tan(0);")
  stmt~step
  self~assertEquals(0.0, stmt~columnDouble(1), "tan(0) should be 0.0")
  stmt~finalize
  db~close

::Method testMathAcos
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT acos(1);")
  stmt~step
  self~assertEquals(0.0, stmt~columnDouble(1), "acos(1) should be 0.0")
  stmt~finalize
  db~close

::Method testMathAsin
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT asin(0);")
  stmt~step
  self~assertEquals(0.0, stmt~columnDouble(1), "asin(0) should be 0.0")
  stmt~finalize
  db~close

::Method testMathAtan
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT atan(0);")
  stmt~step
  self~assertEquals(0.0, stmt~columnDouble(1), "atan(0) should be 0.0")
  stmt~finalize
  db~close

::Method testMathAtan2
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT atan2(1, 1);")
  stmt~step
  val = stmt~columnDouble(1)
  -- atan2(1,1) = pi/4 ≈ 0.7854
  self~assertTrue(val > 0.785, "atan2(1,1) should be ~0.7854:" val)
  self~assertTrue(val < 0.786, "atan2(1,1) should be ~0.7854:" val)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Math functions: angle conversion (radians, degrees)                        --
--------------------------------------------------------------------------------

::Method testMathRadians
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT radians(180);")
  stmt~step
  val = stmt~columnDouble(1)
  -- radians(180) = pi ≈ 3.14159
  self~assertTrue(val > 3.1415, "radians(180) should be ~pi:" val)
  self~assertTrue(val < 3.1416, "radians(180) should be ~pi:" val)
  stmt~finalize
  db~close

::Method testMathDegrees
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT degrees(pi());")
  stmt~step
  val = stmt~columnDouble(1)
  -- degrees(pi()) = 180.0
  self~assertTrue(val > 179.99, "degrees(pi()) should be ~180:" val)
  self~assertTrue(val < 180.01, "degrees(pi()) should be ~180:" val)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Math functions: pi()                                                       --
--------------------------------------------------------------------------------

::Method testMathPi
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT pi();")
  stmt~step
  val = stmt~columnDouble(1)
  self~assertTrue(val > 3.1415926, "pi() should be > 3.1415926:" val)
  self~assertTrue(val < 3.1415927, "pi() should be < 3.1415927:" val)
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Math functions: return types                                               --
--------------------------------------------------------------------------------

::Method testMathReturnTypeFloat
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT sqrt(4);")
  stmt~step
  -- FLOAT = 2
  self~assertEquals(2, stmt~columnType(1), -
    "sqrt should return FLOAT type (2)")
  stmt~finalize
  db~close

::Method testMathReturnTypeInteger
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT sign(5);")
  stmt~step
  -- INTEGER = 1
  self~assertEquals(1, stmt~columnType(1), -
    "sign should return INTEGER type (1)")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Math functions: NULL propagation                                           --
--------------------------------------------------------------------------------

::Method testMathNullPropagation
  db = self~openMemoryDB
  stmt = .ooSQLiteStmt~new(db, "SELECT sqrt(NULL);")
  stmt~step
  -- NULL = 5
  self~assertEquals(5, stmt~columnType(1), -
    "sqrt(NULL) should return NULL type (5)")
  stmt~finalize
  db~close

--------------------------------------------------------------------------------
-- Math functions: used in queries                                            --
--------------------------------------------------------------------------------

::Method testMathInQuery
  db = self~openMemoryDB
  db~exec("CREATE TABLE circles(id INTEGER PRIMARY KEY, radius REAL);", .true)
  db~exec("INSERT INTO circles VALUES(1, 3.0);", .true)
  db~exec("INSERT INTO circles VALUES(2, 5.0);", .true)
  stmt = .ooSQLiteStmt~new(db, -
    "SELECT id, pi() * pow(radius, 2) AS area FROM circles ORDER BY id;")
  stmt~step
  area1 = stmt~columnDouble(2)
  -- pi * 9 ≈ 28.274
  self~assertTrue(area1 > 28.27, "Area of circle r=3 should be ~28.274:" area1)
  self~assertTrue(area1 < 28.28, "Area of circle r=3 should be ~28.274:" area1)
  stmt~step
  area2 = stmt~columnDouble(2)
  -- pi * 25 ≈ 78.540
  self~assertTrue(area2 > 78.53, "Area of circle r=5 should be ~78.540:" area2)
  self~assertTrue(area2 < 78.55, "Area of circle r=5 should be ~78.540:" area2)
  stmt~finalize
  db~close

/******************************************************************************/
/*                                                                            */
/* Tier 5B — base64 builtin extension                                        */
/*                                                                            */
