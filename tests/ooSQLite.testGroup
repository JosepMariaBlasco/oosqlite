  list~append(.array~of("DBSTATUS_MAX", 13))
  missing = ""
  Do pair Over list
    name = pair[1]
    value = self~constantValue(name)
    If value == .nil Then missing = missing name
    Else self~assertEquals(pair[2], value, "Constant" name)
  End
  self~assertEquals("", missing~strip, "Constants missing from ooSQLite.cls")

::Method constantValue
  Use Strict Arg name
  Signal On Syntax Name ConstantMissing
  Return .ooSQLite~send(name)
ConstantMissing:
  Return .nil

::Method testConstantsKeptOldNames
  -- SQLite renamed these; the names of SQLite 3.8.4.3 are still valid
  self~assertEquals(.ooSQLite~MUTEX_STATIC_MAIN, .ooSQLite~MUTEX_STATIC_MASTER)
  self~assertEquals(.ooSQLite~OPEN_SUPER_JOURNAL, .ooSQLite~OPEN_MASTER_JOURNAL)
  self~assertEquals(.ooSQLite~FCNTL_GET_LOCKPROXYFILE, .ooSQLite~GET_LOCKPROXYFILE)
  self~assertEquals(.ooSQLite~FCNTL_SET_LOCKPROXYFILE, .ooSQLite~SET_LOCKPROXYFILE)
  self~assertEquals(.ooSQLite~FCNTL_LAST_ERRNO, .ooSQLite~LAST_ERRNO)

/******************************************************************************/
/*                                                                            */
/* Section 36: stmtStatus with an op that is not a STMTSTATUS constant        */
/*                                                                            */
/* sqlite3_stmt_status() uses op as an index into an array of 9 counters,    */
/* without checking it (SQLite is not built with SQLITE_ENABLE_API_ARMOR):    */
/* other values read memory out of bounds, and with reset = .true they wrote */
/* to it. Only 0 to 8 and STMTSTATUS_MEMUSED (99) are valid; the other       */
/* values return 0, as SQLite does when it checks its arguments.             */
/*                                                                            */
/******************************************************************************/

::Method testStmtStatusInvalidOp
  db = self~openMemoryDB
  self~createTestTable(db)
  stmt = .ooSQLiteStmt~new(db, "SELECT * FROM foods ORDER BY id;")
  Do While stmt~step = stmt~ROW
    Nop
  End
  Do op Over .array~of(9, 10, 11, 12, 16, 50, 98, 100, 1000, -1, "-2147483648", "2147483647")
    self~assertEquals(0, stmt~stmtStatus(op), "stmtStatus(" || op || ")")
  End
  -- The read checks come first: if they fail, the writes below are not done
  Do op Over .array~of(9, 10, -1)
    self~assertEquals(0, stmt~stmtStatus(op, .true), "stmtStatus(" || op || ", .true)")
  End
  self~assertTrue(stmt~stmtStatus(.ooSQLite~STMTSTATUS_MEMUSED) > 0, "MEMUSED should be > 0")
  self~assertTrue(stmt~stmtStatus(.ooSQLite~STMTSTATUS_VM_STEP, .true) > 0, "VM_STEP should be > 0")
  self~assertEquals(0, stmt~stmtStatus(.ooSQLite~STMTSTATUS_VM_STEP), "VM_STEP after reset")
  self~assertEquals(.ooSQLite~OK, stmt~finalize)
  self~assertEquals(.ooSQLite~OK, db~close)

/******************************************************************************/
/*                                                                            */
/* Section 37: tableColumnMetadata of a column declared without a type        */
/*                                                                            */
/* sqlite3_table_column_metadata() returns a NULL data type for a column     */
/* declared without a type, and ooSQLite made a string of it: SIGSEGV. The    */
/* data type is now the empty string, as columnDeclType returns.             */
/*                                                                            */
/******************************************************************************/

::Method testTableColumnMetadataNoType
  db = self~openMemoryDB
  self~assertEquals(db~OK, db~exec("CREATE TABLE t(a, b TEXT COLLATE NOCASE NOT NULL);"))
  info = .directory~new
  self~assertEquals(db~OK, db~tableColumnMetadata("t", "a", info), "rc for a column without a type")
  self~assertEquals("", info~dataType, "DATATYPE of a column without a type")
  self~assertEquals("BINARY", info~collationSequence)
  self~assertEquals(0, info~notNull)
  self~assertEquals(0, info~primaryKey)
  self~assertEquals(0, info~autoIncrement)
  self~assertEquals(db~OK, db~tableColumnMetadata("t", "b", info))
  self~assertEquals("TEXT", info~dataType)
  self~assertEquals("NOCASE", info~collationSequence)
  self~assertEquals(1, info~notNull)
  self~assertEquals(db~OK, db~close)

/******************************************************************************/
/*                                                                            */
/* ooSQLiteClassic.testGroup — Tier 4: Classic Rexx routines (oosqlXxx)       */
/* ====================================================================       */
/*                                                                            */
/* Tests for the procedural (classic Rexx) interface to ooSQLite.             */
/* These routines operate on Pointer handles rather than objects.              */
/*                                                                            */
/* Key differences from the OO interface:                                     */
/*   - oosqlOpen returns rc, sets a Pointer handle via variable name          */
/*   - oosqlPrepare returns rc, sets stmt handle via variable name            */
/*   - Column indexes are 1-based (Rexx convention), not 0-based              */
/*   - oosqlDbStatus/oosqlStatus use Stems, not Directories                   */
/*   - oosqlTableColumnMetadata uses Stem with different key names            */
/*   - oosqlExtendedResultCodes is a noop (always on)                         */
/*                                                                            */
/******************************************************************************/

::Class "ooSQLiteClassic.testGroup" Subclass ooTestCase Public

--------------------------------------------------------------------------------
-- Helper: open an in-memory database via classic routine                     --
--------------------------------------------------------------------------------

::Method churnMemory
  -- Makes the garbage collector run, so that memory that is no longer
  -- referenced gets reused.  Callback buffers released too early show up then.
  Do 100
    junk = .Array~new(10000)~fill(Copies("x", 100))
  End

::Method classicOpenMemory
  ret = oosqlOpen(":memory:", "db")
  self~assertEquals(0, ret, "classicOpenMemory: oosqlOpen should return OK")
  Return db

/******************************************************************************/
/*                                                                            */
/* Section C1: Static routines (no handle needed)                             */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- oosqlVersion                                                               --
--------------------------------------------------------------------------------

::Method testClassicVersion
  ver = oosqlVersion()
  self~assertNotNull(ver, -
    "oosqlVersion should return a non-null value")
  self~assertTrue(ver~pos(".") > 0, -
    "oosqlVersion should contain a dot (version format)")

--------------------------------------------------------------------------------
-- oosqlLibVersion                                                            --
--------------------------------------------------------------------------------

::Method testClassicLibVersion
  ver = oosqlLibVersion()
  self~assertNotNull(ver, -
    "oosqlLibVersion should return a non-null value")
  -- Must match the OO equivalent
  self~assertEquals(.ooSQLite~libVersion, ver, -
    "oosqlLibVersion should match .ooSQLite~libVersion")

--------------------------------------------------------------------------------
-- oosqlLibVersionNumber                                                      --
--------------------------------------------------------------------------------

::Method testClassicLibVersionNumber
  num = oosqlLibVersionNumber()
  self~assertTrue(num > 3000000, -
    "oosqlLibVersionNumber should be > 3000000")
  self~assertEquals(.ooSQLite~libVersionNumber, num, -
    "oosqlLibVersionNumber should match .ooSQLite~libVersionNumber")

--------------------------------------------------------------------------------
-- oosqlSourceID                                                              --
--------------------------------------------------------------------------------

::Method testClassicSourceID
  sid = oosqlSourceID()
  self~assertNotNull(sid, -
    "oosqlSourceID should return a non-null value")
  self~assertEquals(.ooSQLite~sourceID, sid, -
    "oosqlSourceID should match .ooSQLite~sourceID")

--------------------------------------------------------------------------------
-- oosqlThreadSafe                                                            --
--------------------------------------------------------------------------------

::Method testClassicThreadSafe
  ts = oosqlThreadSafe()
  self~assertEquals(.ooSQLite~threadSafe, ts, -
    "oosqlThreadSafe should match .ooSQLite~threadSafe")

--------------------------------------------------------------------------------
-- oosqlComplete                                                              --
--------------------------------------------------------------------------------

::Method testClassicComplete
  self~assertTrue(oosqlComplete("SELECT 1;"), -
    "Complete SQL (with semicolon) should return true")
  self~assertFalse(oosqlComplete("SELECT 1"), -
    "Incomplete SQL (no semicolon) should return false")

--------------------------------------------------------------------------------
-- oosqlCompileOptionGet                                                      --
--------------------------------------------------------------------------------

::Method testClassicCompileOptionGet
  -- The index is 1-based, as in compileOptionGet and the rest of the
  -- classic interface; 0 and out of range indexes return "NULL"
  self~assertEquals("NULL", oosqlCompileOptionGet(0), -
    "oosqlCompileOptionGet(0) is out of range")
  opt = oosqlCompileOptionGet(1)
  self~assertTrue(opt \== "NULL" & opt~length > 0, -
    "oosqlCompileOptionGet(1) should return the first compile option")
  n = 1
  Do While oosqlCompileOptionGet(n) \== "NULL"
    self~assertEquals(.ooSQLite~compileOptionGet(n), oosqlCompileOptionGet(n), -
      "oosqlCompileOptionGet and compileOptionGet should agree on option" n)
    n += 1
  End
  self~assertTrue(n > 2, "There should be several compile options")
  self~assertEquals("NULL", .ooSQLite~compileOptionGet(n), -
    "compileOptionGet should end where oosqlCompileOptionGet ends")
  self~assertEquals("NULL", oosqlCompileOptionGet(999), -
    "oosqlCompileOptionGet(999) should return 'NULL' string")

--------------------------------------------------------------------------------
-- oosqlCompileOptionUsed                                                     --
--------------------------------------------------------------------------------

::Method testClassicCompileOptionUsed
  self~assertTrue(oosqlCompileOptionUsed("THREADSAFE"), -
    "THREADSAFE compile option should be present")
  self~assertFalse(oosqlCompileOptionUsed("BOGUS_OPTION"), -
    "Non-existent compile option should return false")

--------------------------------------------------------------------------------
-- oosqlErrStr                                                                --
--------------------------------------------------------------------------------

::Method testClassicErrStr
  self~assertEquals("not an error", oosqlErrStr(0), -
    "oosqlErrStr(0) should return 'not an error'")
  self~assertEquals("SQL logic error", oosqlErrStr(1), -
    "oosqlErrStr(1) should return 'SQL logic error'")

--------------------------------------------------------------------------------
-- oosqlMemoryUsed                                                            --
--------------------------------------------------------------------------------

::Method testClassicMemoryUsed
  mem = oosqlMemoryUsed()
  self~assertTrue(mem >= 0, -
    "oosqlMemoryUsed should return a non-negative value")

--------------------------------------------------------------------------------
-- oosqlMemoryHighWater                                                       --
--------------------------------------------------------------------------------

::Method testClassicMemoryHighWater
  hw = oosqlMemoryHighWater()
  self~assertTrue(hw >= 0, -
    "oosqlMemoryHighWater should return a non-negative value")
  self~assertTrue(hw >= oosqlMemoryUsed(), -
    "High-water mark should be >= current memory used")

--------------------------------------------------------------------------------
-- oosqlReleaseMemory                                                         --
--------------------------------------------------------------------------------

::Method testClassicReleaseMemory
  ret = oosqlReleaseMemory(0)
  self~assertTrue(ret >= 0, -
    "oosqlReleaseMemory(0) should return a non-negative value")

--------------------------------------------------------------------------------
-- oosqlSoftHeapLimit64                                                       --
--------------------------------------------------------------------------------

::Method testClassicSoftHeapLimit64
  -- Query current limit (setting 0 returns previous limit)
  prev = oosqlSoftHeapLimit64(0)
  self~assertTrue(prev >= 0, -
    "oosqlSoftHeapLimit64(0) should return the current limit (>= 0)")

--------------------------------------------------------------------------------
-- oosqlStrGlob                                                               --
--------------------------------------------------------------------------------

::Method testClassicStrGlob
  -- 0 = match, non-zero = no match (SQLite convention)
  self~assertEquals(0, oosqlStrGlob("*hello*", "say hello world"), -
    "oosqlStrGlob should return 0 for a matching pattern")
  self~assertTrue(oosqlStrGlob("*hello*", "goodbye") \= 0, -
    "oosqlStrGlob should return non-zero for a non-matching pattern")
  self~assertEquals(0, oosqlStrGlob("H?llo", "Hello"), -
    "oosqlStrGlob should support ? for single character wildcard")

/******************************************************************************/
/*                                                                            */
/* Section C2: Connection routines                                            */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- oosqlOpen / oosqlClose / oosqlIsHandleNull                                 --
--------------------------------------------------------------------------------

::Method testClassicOpenCloseMemory
  ret = oosqlOpen(":memory:", "db")
  self~assertEquals(0, ret, -
    "oosqlOpen(':memory:') should return OK (0)")
  self~assertFalse(oosqlIsHandleNull(db), -
    "Opened db handle should not be null")
  ret = oosqlClose(db)
  self~assertEquals(0, ret, -
    "oosqlClose should return OK (0)")

--------------------------------------------------------------------------------
-- oosqlOpen with file                                                        --
--------------------------------------------------------------------------------

::Method testClassicOpenCloseFile
  tempFile = .TemporaryTestFile~new(.nil, "test_classic_open.db")
  tmpFile = tempFile~fullName
  ret = oosqlOpen(tmpFile, "db")
  self~assertEquals(0, ret, -
    "oosqlOpen with file should return OK")
  Call oosqlClose db
  Call SysFileDelete tmpFile

--------------------------------------------------------------------------------
-- oosqlErrCode / oosqlErrMsg on success                                      --
--------------------------------------------------------------------------------

::Method testClassicErrCodeErrMsgSuccess
  db = self~classicOpenMemory
  self~assertEquals(0, oosqlErrCode(db), -
    "oosqlErrCode should be 0 after successful open")
  self~assertEquals("not an error", oosqlErrMsg(db), -
    "oosqlErrMsg should be 'not an error' after successful open")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlErrCode / oosqlErrMsg after error                                     --
--------------------------------------------------------------------------------

::Method testClassicErrCodeErrMsgError
  db = self~classicOpenMemory
  Call oosqlExec db, "INVALID SQL GARBAGE;"
  self~assertTrue(oosqlErrCode(db) \= 0, -
    "oosqlErrCode should be non-zero after invalid SQL")
  self~assertTrue(oosqlErrMsg(db) \= "not an error", -
    "oosqlErrMsg should have a descriptive error message")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlExec — DDL / DML without callback                                     --
--------------------------------------------------------------------------------

::Method testClassicExecNoCallback
  db = self~classicOpenMemory
  ret = oosqlExec(db, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);")
  self~assertEquals(0, ret, -
    "oosqlExec CREATE TABLE should return 0")
  ret = oosqlExec(db, "INSERT INTO t VALUES(1, 'Alice');")
  self~assertEquals(0, ret, -
    "oosqlExec INSERT should return 0")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlExec — Stem of Stems (default format, or format 3)                    --
--------------------------------------------------------------------------------

::Method testClassicExecStemOfStems
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'Alice');"
  Call oosqlExec db, "INSERT INTO t VALUES(2, 'Bob');"
  rs = oosqlExec(db, "SELECT * FROM t ORDER BY id;", .true)
  self~assertTrue(rs~isA(.Stem), -
    "Default format should return a Stem")
  self~assertEquals(2, rs[0], -
    "Stem should contain 2 rows")
  row = rs[1]
  self~assertTrue(row~isA(.Stem), -
    "Each row should be a Stem")
  self~assertEquals(1, row["ID"], -
    "First row ID should be 1")
  self~assertEquals("Alice", row["NAME"], -
    "First row NAME should be Alice")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlExec — Array of Arrays (format 1)                                     --
--------------------------------------------------------------------------------

::Method testClassicExecArrayOfArrays
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'Alice');"
  rs = oosqlExec(db, "SELECT * FROM t;", .true, 1)
  self~assertTrue(rs~isA(.Array), -
    "Format 1 should return an Array")
  -- First element is column headers, second is data
  self~assertTrue(rs~items >= 2, -
    "Array of Arrays should have at least header + 1 data row")
  headers = rs[1]
  self~assertTrue(headers~isA(.Array), -
    "First element should be an Array of column names")
  dataRow = rs[2]
  self~assertTrue(dataRow~isA(.Array), -
    "Second element should be an Array of values")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlExec — Array of Directories (format 2)                                --
--------------------------------------------------------------------------------

::Method testClassicExecArrayOfDirectories
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'Alice');"
  rs = oosqlExec(db, "SELECT * FROM t;", .true, 2)
  self~assertTrue(rs~isA(.Array), -
    "Format 2 should return an Array")
  self~assertEquals(1, rs~items, -
    "Array of Directories should have 1 row")
  row = rs[1]
  self~assertTrue(row~isA(.Directory), -
    "Each row should be a Directory")
  self~assertEquals(1, row["ID"], -
    "Directory key ID should be 1 (uppercase)")
  self~assertEquals("Alice", row["NAME"], -
    "Directory key NAME should be Alice (uppercase)")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlExec — Classic Stem (format 4)                                        --
--------------------------------------------------------------------------------

::Method testClassicExecClassicStem
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'Alice');"
  Call oosqlExec db, "INSERT INTO t VALUES(2, 'Bob');"
  rs = oosqlExec(db, "SELECT * FROM t ORDER BY id;", .true, 4)
  self~assertTrue(rs~isA(.Stem), -
    "Format 4 should return a Stem")
  self~assertEquals(2, rs[0], -
    "Classic Stem row count should be 2")
  self~assertEquals(1, rs["1.ID"], -
    "Classic Stem compound tail '1.ID' should be 1")
  self~assertEquals("Bob", rs["2.NAME"], -
    "Classic Stem compound tail '2.NAME' should be 'Bob'")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlChanges / oosqlTotalChanges / oosqlLastInsertRowID                    --
--------------------------------------------------------------------------------

::Method testClassicChangesAndRowID
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);"
  self~assertEquals(0, oosqlChanges(db), -
    "Changes should be 0 before any DML")
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'Alice');"
  self~assertEquals(1, oosqlChanges(db), -
    "Changes should be 1 after single INSERT")
  self~assertEquals(1, oosqlLastInsertRowID(db), -
    "LastInsertRowID should be 1 after first INSERT")
  Call oosqlExec db, "INSERT INTO t VALUES(2, 'Bob');"
  self~assertEquals(2, oosqlLastInsertRowID(db), -
    "LastInsertRowID should be 2 after second INSERT")
  self~assertTrue(oosqlTotalChanges(db) >= 2, -
    "TotalChanges should be >= 2")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlGetAutocommit                                                         --
--------------------------------------------------------------------------------

::Method testClassicGetAutocommit
  db = self~classicOpenMemory
  self~assertTrue(oosqlGetAutocommit(db), -
    "Autocommit should be true by default")
  Call oosqlExec db, "BEGIN;"
  self~assertFalse(oosqlGetAutocommit(db), -
    "Autocommit should be false inside a transaction")
  Call oosqlExec db, "COMMIT;"
  self~assertTrue(oosqlGetAutocommit(db), -
    "Autocommit should be true again after COMMIT")
  Call oosqlClose db

