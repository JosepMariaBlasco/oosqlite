--------------------------------------------------------------------------------
-- oosqlTableColumnMetadata (Stem with specific key names)                    --
--------------------------------------------------------------------------------

::Method testClassicTableColumnMetadata
  db = self~classicOpenMemory
  Call oosqlExec db, -
    "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT NOT NULL);"
  meta = .Stem~new
  ret = oosqlTableColumnMetadata(db, "t", "name", meta)
  self~assertEquals(0, ret, -
    "oosqlTableColumnMetadata should return OK")
  self~assertEquals("TEXT", meta["DATATYPE"], -
    "DATATYPE for 'name' column should be TEXT")
  self~assertEquals(1, meta["NOTNULL"], -
    "NOTNULL for 'name' column should be 1")
  self~assertEquals(0, meta["PRIMARYKEY"], -
    "PRIMARYKEY for 'name' column should be 0")
  self~assertEquals(0, meta["AUTOINCREMENT"], -
    "AUTOINCREMENT for 'name' column should be 0")
  self~assertEquals("BINARY", meta["COLLATIONSEQUENCE"], -
    "COLLATIONSEQUENCE for 'name' column should be BINARY")
  Call oosqlClose db

::Method testClassicTableColumnMetadataNoType
  -- See Section 37 of the OO tests: a column without a type crashed
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(a, b TEXT);"
  meta = .Stem~new
  self~assertEquals(0, oosqlTableColumnMetadata(db, "t", "a", meta), "rc for a column without a type")
  self~assertEquals("", meta["DATATYPE"], "DATATYPE of a column without a type")
  self~assertEquals("BINARY", meta["COLLATIONSEQUENCE"])
  self~assertEquals(0, oosqlClose(db))

--------------------------------------------------------------------------------
-- Argument positions in the syntax errors of the classic routines            --
--                                                                            --
-- The classic routines take the connection as their first argument, so the  --
-- positions are one more than in the methods they were copied from.          --
--------------------------------------------------------------------------------

::Method syntaxMessage
  Use Strict Arg code
  Signal On Syntax Name SyntaxRaised
  Interpret "Call" code
  Return ""
SyntaxRaised:
  Return Condition("O")~message

::Method testClassicExecFormatArgPosition
  .local~argPosDb = self~classicOpenMemory
  msg = self~syntaxMessage("oosqlExec .argPosDb, 'SELECT 1;', .true, 9")
  self~assertEquals("Argument 4", msg~left(10), "Position of format in oosqlExec:" msg)
  self~assertEquals(0, oosqlClose(.argPosDb))

::Method testClassicExecRtnNameArgPosition
  .local~argPosDb = self~classicOpenMemory
  msg = self~syntaxMessage("oosqlExec .argPosDb, 'SELECT 1;', .true, , 'noSuchRoutineAnywhere'")
  self~assertEquals("Argument 5", msg~left(10), "Position of rtnName in oosqlExec:" msg)
  self~assertEquals(0, oosqlClose(.argPosDb))

::Method testClassicBackupInitSrcArgPosition
  .local~argPosDb = self~classicOpenMemory
  Call oosqlPrepare .argPosDb, "", "nullHandle"
  .local~argPosNull = nullHandle
  self~assertTrue(oosqlIsHandleNull(.argPosNull), "Empty SQL gives a null handle")
  msg = self~syntaxMessage("oosqlBackupInit .argPosDb, .argPosNull")
  self~assertEquals("Argument 2", msg~left(10), "Position of srcConn in oosqlBackupInit:" msg)
  self~assertEquals(0, oosqlClose(.argPosDb))

--------------------------------------------------------------------------------
-- oosqlNextStmt                                                              --
--------------------------------------------------------------------------------

::Method testClassicNextStmt
  db = self~classicOpenMemory
  -- No active stmts
  ns = oosqlNextStmt(db)
  self~assertEquals(.nil, ns, -
    "oosqlNextStmt should return .nil when no stmts exist")
  -- Create a stmt, then find it
  Call oosqlPrepare db, "SELECT 1;", "stmt"
  ns = oosqlNextStmt(db)
  self~assertFalse(oosqlIsHandleNull(ns), -
    "oosqlNextStmt should find the active stmt")
  -- Next after the only stmt should be .nil
  ns2 = oosqlNextStmt(db, ns)
  self~assertEquals(.nil, ns2, -
    "oosqlNextStmt past last stmt should return .nil")
  Call oosqlFinalize stmt
  Call oosqlClose db

/******************************************************************************/
/*                                                                            */
/* Section C3: Prepared statement routines                                    */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- oosqlPrepare / oosqlStep / oosqlFinalize                                   --
--------------------------------------------------------------------------------

::Method testClassicPrepareStepFinalize
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'Alice');"
  ret = oosqlPrepare(db, "SELECT * FROM t;", "stmt")
  self~assertEquals(0, ret, -
    "oosqlPrepare should return OK")
  self~assertFalse(oosqlIsHandleNull(stmt), -
    "Prepared stmt handle should not be null")
  ret = oosqlStep(stmt)
  self~assertEquals(.ooSQLite~ROW, ret, -
    "First oosqlStep should return ROW")
  ret = oosqlStep(stmt)
  self~assertEquals(.ooSQLite~DONE, ret, -
    "Second oosqlStep should return DONE")
  ret = oosqlFinalize(stmt)
  self~assertEquals(0, ret, -
    "oosqlFinalize should return OK")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlPrepare with tail                                                     --
--------------------------------------------------------------------------------

::Method testClassicPrepareTail
  db = self~classicOpenMemory
  ret = oosqlPrepare(db, "SELECT 1; SELECT 2;", "stmt", "tail")
  self~assertEquals(0, ret, -
    "oosqlPrepare should return OK")
  self~assertTrue(tail~strip~length > 0, -
    "Tail should contain the remaining SQL")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlReset / oosqlClearBindings                                            --
--------------------------------------------------------------------------------

::Method testClassicResetClearBindings
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlExec db, "INSERT INTO t VALUES(2);"
  ret = oosqlPrepare(db, "SELECT * FROM t WHERE id = ?;", "stmt")
  Call oosqlBindInt stmt, 1, 1
  ret = oosqlStep(stmt)
  self~assertEquals(.ooSQLite~ROW, ret, -
    "Step after bind should find a row")
  -- Reset and rebind
  ret = oosqlReset(stmt)
  self~assertEquals(0, ret, "oosqlReset should return OK")
  ret = oosqlClearBindings(stmt)
  self~assertEquals(0, ret, "oosqlClearBindings should return OK")
  Call oosqlBindInt stmt, 1, 2
  ret = oosqlStep(stmt)
  self~assertEquals(.ooSQLite~ROW, ret, -
    "Step after reset and rebind should find the other row")
  self~assertEquals(2, oosqlColumnInt(stmt, 1), -
    "Should find id=2 after rebinding")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlColumnCount / oosqlColumnName (1-based)                               --
--------------------------------------------------------------------------------

::Method testClassicColumnCountAndName
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT, value REAL);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'A', 3.14);"
  Call oosqlPrepare db, "SELECT id, name, value FROM t;", "stmt"
  self~assertEquals(3, oosqlColumnCount(stmt), -
    "Column count should be 3")
  Call oosqlStep stmt
  -- Classic routines use 1-based column indexes
  self~assertEquals("id", oosqlColumnName(stmt, 1), -
    "Column 1 name should be 'id'")
  self~assertEquals("name", oosqlColumnName(stmt, 2), -
    "Column 2 name should be 'name'")
  self~assertEquals("value", oosqlColumnName(stmt, 3), -
    "Column 3 name should be 'value'")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlColumnInt / oosqlColumnText / oosqlColumnDouble / oosqlColumnInt64    --
--------------------------------------------------------------------------------

::Method testClassicColumnTypes
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT, value REAL);"
  Call oosqlExec db, "INSERT INTO t VALUES(42, 'Hello', 3.14);"
  Call oosqlPrepare db, "SELECT id, name, value FROM t;", "stmt"
  Call oosqlStep stmt
  self~assertEquals(42, oosqlColumnInt(stmt, 1), -
    "oosqlColumnInt should return 42")
  self~assertEquals(42, oosqlColumnInt64(stmt, 1), -
    "oosqlColumnInt64 should return 42")
  self~assertEquals("Hello", oosqlColumnText(stmt, 2), -
    "oosqlColumnText should return 'Hello'")
  self~assertEquals(3.14, oosqlColumnDouble(stmt, 3), -
    "oosqlColumnDouble should return 3.14")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlColumnType / oosqlColumnDeclType                                      --
--------------------------------------------------------------------------------

::Method testClassicColumnTypeAndDeclType
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT, value REAL);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'A', 3.14);"
  Call oosqlPrepare db, "SELECT id, name, value FROM t;", "stmt"
  Call oosqlStep stmt
  self~assertEquals(.ooSQLite~INTEGER, oosqlColumnType(stmt, 1), -
    "Column 1 type should be INTEGER")
  self~assertEquals(.ooSQLite~TEXT, oosqlColumnType(stmt, 2), -
    "Column 2 type should be TEXT")
  self~assertEquals(.ooSQLite~FLOAT, oosqlColumnType(stmt, 3), -
    "Column 3 type should be FLOAT")
  self~assertEquals("INTEGER", oosqlColumnDeclType(stmt, 1), -
    "Column 1 declared type should be 'INTEGER'")
  self~assertEquals("TEXT", oosqlColumnDeclType(stmt, 2), -
    "Column 2 declared type should be 'TEXT'")
  self~assertEquals("REAL", oosqlColumnDeclType(stmt, 3), -
    "Column 3 declared type should be 'REAL'")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlColumnBytes                                                           --
--------------------------------------------------------------------------------

::Method testClassicColumnBytes
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES('Hello');"
  Call oosqlPrepare db, "SELECT name FROM t;", "stmt"
  Call oosqlStep stmt
  self~assertEquals(5, oosqlColumnBytes(stmt, 1), -
    "oosqlColumnBytes for 'Hello' should be 5")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlColumnIndex (1-based, case-insensitive)                               --
--------------------------------------------------------------------------------

::Method testClassicColumnIndex
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'A');"
  Call oosqlPrepare db, "SELECT id, name FROM t;", "stmt"
  Call oosqlStep stmt
  self~assertEquals(1, oosqlColumnIndex(stmt, "id"), -
    "oosqlColumnIndex('id') should return 1 (1-based)")
  self~assertEquals(2, oosqlColumnIndex(stmt, "name"), -
    "oosqlColumnIndex('name') should return 2")
  -- Case-insensitive
  self~assertEquals(1, oosqlColumnIndex(stmt, "ID"), -
    "oosqlColumnIndex should be case-insensitive")
  -- Non-existent column returns 0
  self~assertEquals(0, oosqlColumnIndex(stmt, "bogus"), -
    "oosqlColumnIndex for non-existent column should return 0")
  Call oosqlFinalize stmt
  Call oosqlClose db

::Method testClassicColumnIndexNoLeak
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT);"
  Call oosqlPrepare db, "SELECT id, name FROM t;", "stmt"
  -- Same check as testColumnIndexNoLeak, for the classic routine
  idx = oosqlColumnIndex(stmt, "name")
  idx = oosqlColumnIndex(stmt, "bogus")
  before = oosqlMemoryUsed()
  Do 1000
    idx = oosqlColumnIndex(stmt, "name")
    idx = oosqlColumnIndex(stmt, "bogus")
  End
  growth = oosqlMemoryUsed() - before
  self~assertTrue(growth < 1000, -
    "oosqlColumnIndex should not leak SQLite memory; growth:" growth "bytes")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlColumnDatabaseName / oosqlColumnTableName / oosqlColumnOriginName     --
--------------------------------------------------------------------------------

::Method testClassicColumnMetadataNames
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'A');"
  Call oosqlPrepare db, "SELECT id, name FROM t;", "stmt"
  Call oosqlStep stmt
  self~assertEquals("main", oosqlColumnDatabaseName(stmt, 1), -
    "oosqlColumnDatabaseName should return 'main'")
  self~assertEquals("t", oosqlColumnTableName(stmt, 1), -
    "oosqlColumnTableName should return 't'")
  self~assertEquals("id", oosqlColumnOriginName(stmt, 1), -
    "oosqlColumnOriginName should return 'id'")
  Call oosqlFinalize stmt
  Call oosqlClose db

