::Method testClassicDbStatus
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER PRIMARY KEY);"
  status = .Stem~new
  ret = oosqlDbStatus(db, .ooSQLite~DBSTATUS_CACHE_USED, status)
  self~assertEquals(0, ret, -
    "oosqlDbStatus should return OK")
  self~assertTrue(status["CURRENT"] > 0, -
    "CACHE_USED current should be > 0 after creating a table")
  Call oosqlClose db

