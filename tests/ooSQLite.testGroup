-- oosqlStmtBusy                                                             --
--------------------------------------------------------------------------------

::Method testClassicStmtBusy
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlPrepare db, "SELECT * FROM t;", "stmt"
  self~assertFalse(oosqlStmtBusy(stmt), -
    "Stmt should not be busy before step")
  Call oosqlStep stmt
  self~assertTrue(oosqlStmtBusy(stmt), -
    "Stmt should be busy after step returns ROW")
  Call oosqlFinalize stmt
  Call oosqlClose db

