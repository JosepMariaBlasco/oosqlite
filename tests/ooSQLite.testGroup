--------------------------------------------------------------------------------
-- oosqlDataCount                                                             --
--------------------------------------------------------------------------------

::Method testClassicDataCount
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER, name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'A');"
  Call oosqlPrepare db, "SELECT id, name FROM t;", "stmt"
  -- Before step, dataCount is 0
  self~assertEquals(0, oosqlDataCount(stmt), -
    "oosqlDataCount before step should be 0")
  Call oosqlStep stmt
  -- After step with ROW, dataCount equals column count
  self~assertEquals(2, oosqlDataCount(stmt), -
    "oosqlDataCount after step should equal column count")
  Call oosqlFinalize stmt
  Call oosqlClose db

