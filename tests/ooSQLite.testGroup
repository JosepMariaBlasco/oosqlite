--------------------------------------------------------------------------------
-- ooSQLiteEncryptionAvailable                                                --
--------------------------------------------------------------------------------

::Method testClassicEncryptionAvailable
  -- SEE is not available in this build, so should return 0
  ret = ooSQLiteEncryptionAvailable()
  self~assertEquals(0, ret, -
    "ooSQLiteEncryptionAvailable should return 0 (no SEE)")

--------------------------------------------------------------------------------
-- ooSQLiteEnquote                                                            --
--------------------------------------------------------------------------------

::Method testClassicEnquote
  self~assertEquals("'hello'", ooSQLiteEnquote("hello"), -
    "ooSQLiteEnquote('hello') should return 'hello' (quoted)")

::Method testClassicEnquoteWithQuote
  self~assertEquals("'it''s'", ooSQLiteEnquote("it's"), -
    "ooSQLiteEnquote should double internal single quotes")

::Method testClassicEnquoteStem
  -- A stem in array format: one item (before, the result was garbage),
  -- items with no length limit (before, cut at 4095 characters without an
  -- error when the last item went over), and no items
  one.0 = 1; one.1 = "it's"
  self~assertEquals("'it''s'", ooSQLiteEnquote(one.), "one item")
  a = "a"~copies(3000); b = "b"~copies(3000)
  two.0 = 2; two.1 = a; two.2 = b
  self~assertEquals("'" || a || "', '" || b || "'", ooSQLiteEnquote(two.), "2 long items")
  eight. = ""
  eight.0 = 8
  Do i = 1 To 6; eight.i = i; End
  eight.7 = a; eight.8 = b
  self~assertEquals(.ooSQLite~enquote(.array~of(1, 2, 3, 4, 5, 6, a, b)), ooSQLiteEnquote(eight.), -
    "the stem gives the same as the array of enquote")
  none.0 = 0
  self~assertEquals("NULL", ooSQLiteEnquote(none.), "no items is NULL")

::Method testClassicEnquoteEmpty
  self~assertEquals("''", ooSQLiteEnquote(""), -
    "ooSQLiteEnquote('') should return ''")

--------------------------------------------------------------------------------
-- ooSQLiteVersion                                                            --
--------------------------------------------------------------------------------

::Method testClassicOoSQLiteVersion
  -- Default (no arg) returns the version string
  ver = ooSQLiteVersion()
  self~assertTrue(ver~length > 0, -
    "ooSQLiteVersion() should return a non-empty string:" ver)
  self~assertTrue(ver~pos("ooSQLite") > 0, -
    "ooSQLiteVersion() should contain 'ooSQLite':" ver)

::Method testClassicOoSQLiteVersionCompact
  ver = ooSQLiteVersion("compact")
  -- Should be a version number like "1.0.0.12617"
  self~assertTrue(ver~pos(".") > 0, -
    "ooSQLiteVersion('compact') should contain dots:" ver)
  -- Should not contain the word "ooSQLite" (just the number)
  self~assertTrue(ver~pos("ooSQLite") = 0, -
    "ooSQLiteVersion('compact') should be just the version number:" ver)

::Method testClassicOoSQLiteVersionFull
  ver = ooSQLiteVersion("full")
  self~assertTrue(ver~pos("ooSQLite") > 0, -
    "ooSQLiteVersion('full') should contain 'ooSQLite':" ver)
  self~assertTrue(ver~pos("SQLite") > 0, -
    "ooSQLiteVersion('full') should contain 'SQLite' info:" ver)

--------------------------------------------------------------------------------
-- oosqlExtendedErrCode                                                       --
--------------------------------------------------------------------------------

::Method testClassicExtendedErrCode
  db = self~classicOpenMemory
  -- After open, no error
  self~assertEquals(0, oosqlExtendedErrCode(db), -
    "oosqlExtendedErrCode should be 0 after open")
  Call oosqlClose db

::Method testClassicExtendedErrCodeAfterError
  db = self~classicOpenMemory
  Call oosqlExec db, "SELECT * FROM nonexistent"
  errCode = oosqlErrCode(db)
  extErrCode = oosqlExtendedErrCode(db)
  self~assertTrue(errCode > 0, -
    "oosqlErrCode should be non-zero after error:" errCode)
  -- Extended error code has the primary code in its lower 8 bits
  primaryFromExt = extErrCode // 256
  self~assertEquals(errCode, primaryFromExt, -
    "Lower 8 bits of extended err code should match primary err code")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlBindBlob                                                              --
--------------------------------------------------------------------------------

::Method testClassicBindBlob
  db = self~classicOpenMemory
  Call oosqlExec db, -
    "CREATE TABLE blobs (id INTEGER, data BLOB)"
  Call oosqlPrepare db, "INSERT INTO blobs VALUES (1, ?)", "stmt"
  blobData = "DEADBEEF"x
  rc = oosqlBindBlob(stmt, 1, blobData)
  self~assertEquals(0, rc, -
    "oosqlBindBlob should return OK")
  Call oosqlStep stmt
  Call oosqlFinalize stmt
  -- Read it back and verify
  Call oosqlPrepare db, "SELECT data FROM blobs WHERE id = 1", "stmt2"
  Call oosqlStep stmt2
  readBlob = oosqlColumnBlob(stmt2, 1)
  readBytes = oosqlColumnBytes(stmt2, 1)
  self~assertEquals(4, readBytes, -
    "Blob should be 4 bytes long")
  self~assertEquals(blobData, readBlob, -
    "Read blob should match written blob")
  Call oosqlFinalize stmt2
  Call oosqlClose db

::Method testClassicBindBlobText
  -- oosqlBindBlob accepts String objects — test with printable text
  db = self~classicOpenMemory
  Call oosqlExec db, -
    "CREATE TABLE blobs (id INTEGER, data BLOB)"
  Call oosqlPrepare db, "INSERT INTO blobs VALUES (1, ?)", "stmt"
  textData = "Hello, blob!"
  rc = oosqlBindBlob(stmt, 1, textData)
  self~assertEquals(0, rc, -
    "oosqlBindBlob with text data should return OK")
  Call oosqlStep stmt
  Call oosqlFinalize stmt
  Call oosqlPrepare db, "SELECT data FROM blobs WHERE id = 1", "stmt2"
  Call oosqlStep stmt2
  readBytes = oosqlColumnBytes(stmt2, 1)
  self~assertEquals(textData~length, readBytes, -
    "Blob length should match text length")
  Call oosqlFinalize stmt2
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlBindZeroBlob                                                          --
--------------------------------------------------------------------------------

::Method testClassicBindZeroBlob
  db = self~classicOpenMemory
  Call oosqlExec db, -
    "CREATE TABLE blobs (id INTEGER, data BLOB)"
  Call oosqlPrepare db, "INSERT INTO blobs VALUES (1, ?)", "stmt"
  rc = oosqlBindZeroBlob(stmt, 1, 64)
  self~assertEquals(0, rc, -
    "oosqlBindZeroBlob should return OK")
  Call oosqlStep stmt
  Call oosqlFinalize stmt
  Call oosqlPrepare db, "SELECT data FROM blobs WHERE id = 1", "stmt2"
  Call oosqlStep stmt2
  zbLen = oosqlColumnBytes(stmt2, 1)
