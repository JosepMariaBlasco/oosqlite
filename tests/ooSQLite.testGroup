-- oosqlSql                                                                   --
--------------------------------------------------------------------------------

::Method testClassicSql
  db = self~classicOpenMemory
  sqlText = "SELECT 42;"
  Call oosqlPrepare db, sqlText, "stmt"
  self~assertEquals(sqlText, oosqlSql(stmt), -
    "oosqlSql should return the original SQL text")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlBindParameterCount / Name / Index                                     --
--------------------------------------------------------------------------------

::Method testClassicBindParameters
  db = self~classicOpenMemory
  Call oosqlPrepare db, "SELECT ? WHERE ? = :named;", "stmt"
  self~assertEquals(3, oosqlBindParameterCount(stmt), -
    "Bind parameter count should be 3")
  -- Positional params have no name
  self~assertEquals("", oosqlBindParameterName(stmt, 1), -
    "Positional param 1 should have empty name")
  self~assertEquals(":named", oosqlBindParameterName(stmt, 3), -
    "Named param 3 should be ':named'")
  self~assertEquals(3, oosqlBindParameterIndex(stmt, ":named"), -
    "oosqlBindParameterIndex(':named') should return 3")
  self~assertEquals(0, oosqlBindParameterIndex(stmt, ":bogus"), -
    "oosqlBindParameterIndex for non-existent param should return 0")
  Call oosqlFinalize stmt
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlBindInt / oosqlBindText / oosqlBindDouble / oosqlBindInt64            --
-- oosqlBindNull                                                              --
--------------------------------------------------------------------------------

::Method testClassicBindTypes
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(a INTEGER, b TEXT, c REAL, d INTEGER, e TEXT);"
  Call oosqlPrepare db, "INSERT INTO t VALUES(?, ?, ?, ?, ?);", "stmt"
  self~assertEquals(0, oosqlBindInt(stmt, 1, 42), -
    "oosqlBindInt should return OK")
  self~assertEquals(0, oosqlBindText(stmt, 2, "Hello"), -
    "oosqlBindText should return OK")
  self~assertEquals(0, oosqlBindDouble(stmt, 3, 3.14), -
    "oosqlBindDouble should return OK")
  self~assertEquals(0, oosqlBindInt64(stmt, 4, 9999999999), -
    "oosqlBindInt64 should return OK")
  self~assertEquals(0, oosqlBindNull(stmt, 5), -
    "oosqlBindNull should return OK")
  Call oosqlStep stmt
  Call oosqlFinalize stmt
  -- Verify the inserted values
  Call oosqlPrepare db, "SELECT * FROM t;", "stmt2"
  Call oosqlStep stmt2
  self~assertEquals(42, oosqlColumnInt(stmt2, 1), -
    "Column a should be 42")
  self~assertEquals("Hello", oosqlColumnText(stmt2, 2), -
    "Column b should be 'Hello'")
  self~assertEquals(3.14, oosqlColumnDouble(stmt2, 3), -
    "Column c should be 3.14")
  self~assertEquals(9999999999, oosqlColumnInt64(stmt2, 4), -
    "Column d should be 9999999999")
  self~assertEquals(.ooSQLite~SQLNULL, oosqlColumnType(stmt2, 5), -
    "Column e type should be SQLNULL (5)")
  Call oosqlFinalize stmt2
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlStmtStatus                                                           --
--------------------------------------------------------------------------------

::Method testClassicStmtStatus
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlPrepare db, "SELECT * FROM t;", "stmt"
  Call oosqlStep stmt
  ret = oosqlStmtStatus(stmt, .ooSQLite~STMTSTATUS_FULLSCAN_STEP)
  self~assertTrue(ret >= 0, -
    "oosqlStmtStatus should return a non-negative value")
  Call oosqlFinalize stmt
  Call oosqlClose db

::Method testClassicStmtStatusInvalidOp
  -- See Section 36 of the OO tests: op is checked before it reaches SQLite
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(id INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlPrepare db, "SELECT * FROM t;", "stmt"
  Call oosqlStep stmt
  Do op Over .array~of(9, 10, 11, 12, 16, 50, 98, 100, 1000, -1, "-2147483648", "2147483647")
    self~assertEquals(0, oosqlStmtStatus(stmt, op), "oosqlStmtStatus(" || op || ")")
  End
  Do op Over .array~of(9, 10, -1)
    self~assertEquals(0, oosqlStmtStatus(stmt, op, .true), "oosqlStmtStatus(" || op || ", .true)")
  End
  self~assertTrue(oosqlStmtStatus(stmt, .ooSQLite~STMTSTATUS_MEMUSED) > 0, "MEMUSED should be > 0")
  self~assertTrue(oosqlStmtStatus(stmt, .ooSQLite~STMTSTATUS_VM_STEP, .true) > 0, "VM_STEP should be > 0")
  self~assertEquals(0, oosqlStmtStatus(stmt, .ooSQLite~STMTSTATUS_VM_STEP), "VM_STEP after reset")
  self~assertEquals(0, oosqlFinalize(stmt))
  self~assertEquals(0, oosqlClose(db))

::Method testClassicNullStmtMessage
  -- The message of the syntax error for a null statement handle
  db = self~classicOpenMemory
  Call oosqlPrepare db, "", "stmt"
  self~assertTrue(oosqlIsHandleNull(stmt), "Empty SQL gives a null handle")
  msg = ""
  Signal On Syntax Name NullStmtRaised
  Call oosqlStep stmt
  Signal Off Syntax
  self~fail("oosqlStep with a null handle should raise a syntax error")
NullStmtRaised:
  Signal Off Syntax
  co = Condition("O")
  self~assertEquals(88.900, co~code, "Error code")
  self~assertEquals("Argument 1, the prepared statement handle, must not be null.", co~message, "Error message")
  Call oosqlClose db

::Method testClassicNullHandleMessages
  -- The classic interface has handles, not objects: each kind of null
  -- handle is named as such in the message of the syntax error 88.900
  db = self~classicOpenMemory
  Call oosqlPrepare db, "", "null"                  -- a null Pointer
  self~assertTrue(oosqlIsHandleNull(null), "Empty SQL gives a null handle")
  self~assertEquals("88.900 Argument 1, the database connection handle, must not be null.", -
    self~nullHandleError("oosqlChanges", .array~of(null)), "null connection")
  self~assertEquals("88.900 Argument 2, the database connection handle, must not be null.", -
    self~nullHandleError("oosqlBackupInit", .array~of(db, null)), "null source connection")
  self~assertEquals("88.900 Argument 1, the prepared statement handle, must not be null.", -
    self~nullHandleError("oosqlReset", .array~of(null)), "null statement")
  self~assertEquals("88.900 Argument 1, the mutex handle, must not be null.", -
    self~nullHandleError("oosqlMutexEnter", .array~of(null)), "null mutex")
  self~assertEquals("88.900 Argument 1, the backup handle, must not be null.", -
    self~nullHandleError("oosqlBackupStep", .array~of(null)), "null backup")
  Call oosqlClose db

::Method testClassicRoutineErrorWording
  -- The errors of routines speak of arguments, not of method arguments
  self~assertEquals("88.900 Argument 1, option must be one of [O]neLine [F]ull [C]ompact [L]ibVersion" -
    "[N]umber [S]ourceID; found ""X"".", -
    self~nullHandleError("ooSQLiteVersion", .array~of("X")), "ooSQLiteVersion with a bad type")

::Method nullHandleError
  -- Calls the routine name with args, returns the code and message of the
  -- syntax error it raises
  Use Strict Arg name, args
  rtn = .context~package~findRoutine(name)
  Signal On Syntax
  rtn~callWith(args)
  Return "no error"
Syntax:
  co = Condition("O")
  Return co~code co~message

/******************************************************************************/
/*                                                                            */
/* Section C4: Backup routines                                                */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- oosqlBackupInit / oosqlBackupStep / oosqlBackupFinish                      --
--------------------------------------------------------------------------------

::Method testClassicBackupBasic
  -- Create source with data
  ret = oosqlOpen(":memory:", "srcDb")
  Call oosqlExec srcDb, "CREATE TABLE t(id INTEGER PRIMARY KEY, name TEXT);"
  Call oosqlExec srcDb, "INSERT INTO t VALUES(1, 'Alice');"
  Call oosqlExec srcDb, "INSERT INTO t VALUES(2, 'Bob');"
  -- Create destination
  tempFile = .TemporaryTestFile~new(.nil, "test_classic_backup.db")
  tmpFile = tempFile~fullName
  ret = oosqlOpen(tmpFile, "dstDb")
  -- Init backup: dst, src
  buH = oosqlBackupInit(dstDb, srcDb)
  self~assertFalse(oosqlIsHandleNull(buH), -
    "oosqlBackupInit should return a non-null handle")
  -- Step to copy all pages
  ret = oosqlBackupStep(buH, -1)
  self~assertEquals(.ooSQLite~DONE, ret, -
    "oosqlBackupStep(-1) should return DONE")
  -- Finish
  ret = oosqlBackupFinish(buH)
  self~assertEquals(0, ret, -
    "oosqlBackupFinish should return OK")
  -- Verify destination has the data
  rs = oosqlExec(dstDb, "SELECT * FROM t ORDER BY id;", .true, 2)
  self~assertEquals(2, rs~items, -
    "Backup destination should have 2 rows")
  self~assertEquals("Alice", rs[1]["NAME"], -
    "First row should be Alice")
  self~assertEquals("Bob", rs[2]["NAME"], -
    "Second row should be Bob")
  Call oosqlClose srcDb
  Call oosqlClose dstDb
  Call SysFileDelete tmpFile

--------------------------------------------------------------------------------
-- oosqlBackupPageCount / oosqlBackupRemaining                                --
--------------------------------------------------------------------------------

::Method testClassicBackupPageCountRemaining
  ret = oosqlOpen(":memory:", "srcDb")
  Call oosqlExec srcDb, "CREATE TABLE t(id INTEGER PRIMARY KEY);"
  Call oosqlExec srcDb, "INSERT INTO t VALUES(1);"
  tempFile = .TemporaryTestFile~new(.nil, "test_classic_backup_pc.db")
  tmpFile = tempFile~fullName
  ret = oosqlOpen(tmpFile, "dstDb")
  buH = oosqlBackupInit(dstDb, srcDb)
  -- Before step, both should be 0
  self~assertEquals(0, oosqlBackupPageCount(buH), -
    "oosqlBackupPageCount before step should be 0")
  self~assertEquals(0, oosqlBackupRemaining(buH), -
    "oosqlBackupRemaining before step should be 0")
  -- Step all
  Call oosqlBackupStep buH, -1
  -- After complete backup:
  -- pageCount = total pages (> 0), remaining = 0
  pcActual = oosqlBackupPageCount(buH)
  remActual = oosqlBackupRemaining(buH)
  self~assertTrue(pcActual > 0, -
    "oosqlBackupPageCount after complete backup should be > 0 (total pages)")
  self~assertEquals(0, remActual, -
    "oosqlBackupRemaining after complete backup should be 0")
  Call oosqlBackupFinish buH
  Call oosqlClose srcDb
  Call oosqlClose dstDb
  Call SysFileDelete tmpFile

/******************************************************************************/
/*                                                                            */
/* Section C5: Mutex routines                                                 */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- oosqlMutexAlloc / Enter / Leave / Free                                     --
--------------------------------------------------------------------------------

::Method testClassicMutexBasic
  mtx = oosqlMutexAlloc(.ooSQLite~MUTEX_FAST)
  self~assertFalse(oosqlIsHandleNull(mtx), -
    "oosqlMutexAlloc should return a non-null handle")
  ret = oosqlMutexEnter(mtx)
  self~assertEquals(0, ret, -
    "oosqlMutexEnter should return OK")
  ret = oosqlMutexLeave(mtx)
  self~assertEquals(0, ret, -
    "oosqlMutexLeave should return OK")
  ret = oosqlMutexFree(mtx)
  self~assertEquals(0, ret, -
    "oosqlMutexFree should return OK")

--------------------------------------------------------------------------------
-- oosqlMutexTry                                                              --
--------------------------------------------------------------------------------

::Method testClassicMutexTry
  mtx = oosqlMutexAlloc(.ooSQLite~MUTEX_FAST)
  -- Try on an unlocked mutex should succeed
  ret = oosqlMutexTry(mtx)
  self~assertEquals(0, ret, -
    "oosqlMutexTry on unlocked mutex should return OK (0)")
  -- Leave after successful try
  Call oosqlMutexLeave mtx
  -- Enter, then try again (FAST mutex is not recursive)
  Call oosqlMutexEnter mtx
  ret = oosqlMutexTry(mtx)
  self~assertEquals(.ooSQLite~BUSY, ret, -
    "oosqlMutexTry on already-entered FAST mutex should return BUSY")
  Call oosqlMutexLeave mtx
  Call oosqlMutexFree mtx

--------------------------------------------------------------------------------
-- oosqlStatus (process-wide, uses Stem)                                      --
--------------------------------------------------------------------------------

::Method testClassicStatus
  status = .Stem~new
  ret = oosqlStatus(.ooSQLite~STATUS_MEMORY_USED, status)
  self~assertEquals(0, ret, -
    "oosqlStatus should return OK")
  self~assertTrue(status["CURRENT"] > 0, -
    "STATUS_MEMORY_USED current should be > 0")
  self~assertTrue(status["HIGHWATER"] > 0, -
    "STATUS_MEMORY_USED highwater should be > 0")

/******************************************************************************/
/*                                                                            */
/* Section C6: Classic callback routines                                      */
/*                                                                            */
/* These routines use routine names (strings) instead of callback objects.    */
/* The callback routines are defined as ::Routine at the end of this file.   */
/*                                                                            */
/* Deregistration uses an empty string ("") as the routine name, except       */
/* for oosqlProgressHandler which also needs instructions = 0.               */
/*                                                                            */
/* oosqlSetAuthorizer used to cause SIGSEGV when the callback ran (note #16,  */
/* fixed); it is now tested with execution too.                               */
/*                                                                            */
/******************************************************************************/

--------------------------------------------------------------------------------
-- oosqlCommitHook: basic registration and invocation                         --
--------------------------------------------------------------------------------

::Method testClassicCallbackCommitHook
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicCommitHookCallCount = 0
  Call oosqlCommitHook db, "classicCommitHookCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertTrue(.environment~classicCommitHookCallCount > 0, -
    "oosqlCommitHook callback should be invoked on autocommit INSERT")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCommitHook: userData propagation                                      --
--------------------------------------------------------------------------------

::Method testClassicCallbackCommitHookUserData
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicCommitHookLastUD = .nil
  Call oosqlCommitHook db, "classicCommitHookUDCB", "commit_data"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertEquals("commit_data", .environment~classicCommitHookLastUD, -
    "oosqlCommitHook callback should receive userData")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCommitHook: explicit transaction fires hook once                      --
--------------------------------------------------------------------------------

::Method testClassicCallbackCommitHookExplicit
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicCommitHookCallCount = 0
  Call oosqlCommitHook db, "classicCommitHookCB"
  Call oosqlExec db, "BEGIN;"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlExec db, "INSERT INTO t VALUES(2);"
  Call oosqlExec db, "COMMIT;"
  self~assertEquals(1, .environment~classicCommitHookCallCount, -
    "oosqlCommitHook should fire once for explicit COMMIT")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCommitHook: veto converts COMMIT into ROLLBACK                        --
--------------------------------------------------------------------------------

::Method testClassicCallbackCommitHookVeto
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  -- Install vetoing callback
  Call oosqlCommitHook db, "classicCommitHookVetoCB"
  Call oosqlExec db, "BEGIN;"
  Call oosqlExec db, "INSERT INTO t VALUES(99);"
  Call oosqlExec db, "COMMIT;"
  -- Deregister before querying
  Call oosqlCommitHook db, ""
  rs = oosqlExec(db, "SELECT COUNT(*) AS cnt FROM t;", .true, 2)
  self~assertEquals(1, rs[1]["CNT"], -
    "Vetoed commit should not persist the INSERT (expect 1 row)")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCommitHook: deregistration with empty string                          --
--------------------------------------------------------------------------------

::Method testClassicCallbackCommitHookDeregister
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicCommitHookCallCount = 0
  Call oosqlCommitHook db, "classicCommitHookCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertTrue(.environment~classicCommitHookCallCount > 0, -
    "oosqlCommitHook should be invoked before deregister")
  -- Deregister
  Call oosqlCommitHook db, ""
  .environment~classicCommitHookCallCount = 0
  Call oosqlExec db, "INSERT INTO t VALUES(2);"
  self~assertEquals(0, .environment~classicCommitHookCallCount, -
    "oosqlCommitHook should not be invoked after deregister")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCommitHook: previous userData returned on re-registration             --
--------------------------------------------------------------------------------

::Method testClassicCallbackCommitHookPrevUserData
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  prev = oosqlCommitHook(db, "classicCommitHookCB", "first_ud")
  self~assertSame(.nil, prev, -
    "First registration should return .nil (no previous userData)")
  prev = oosqlCommitHook(db, "classicCommitHookCB", "second_ud")
  self~assertEquals("first_ud", prev, -
    "Second registration should return previous userData")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlRollbackHook: basic invocation                                        --
--------------------------------------------------------------------------------

::Method testClassicCallbackRollbackHook
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicRollbackHookCallCount = 0
  Call oosqlRollbackHook db, "classicRollbackHookCB"
  Call oosqlExec db, "BEGIN;"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlExec db, "ROLLBACK;"
  self~assertEquals(1, .environment~classicRollbackHookCallCount, -
    "oosqlRollbackHook should fire once on explicit ROLLBACK")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlRollbackHook: userData propagation                                    --
--------------------------------------------------------------------------------

::Method testClassicCallbackRollbackHookUserData
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicRollbackHookLastUD = .nil
  Call oosqlRollbackHook db, "classicRollbackHookUDCB", "rb_data"
  Call oosqlExec db, "BEGIN;"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlExec db, "ROLLBACK;"
  self~assertEquals("rb_data", .environment~classicRollbackHookLastUD, -
    "oosqlRollbackHook callback should receive userData")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlRollbackHook: deregistration                                          --
--------------------------------------------------------------------------------

::Method testClassicCallbackRollbackHookDeregister
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicRollbackHookCallCount = 0
  Call oosqlRollbackHook db, "classicRollbackHookCB"
  Call oosqlExec db, "BEGIN;"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  Call oosqlExec db, "ROLLBACK;"
  self~assertTrue(.environment~classicRollbackHookCallCount > 0, -
    "oosqlRollbackHook should be invoked before deregister")
  Call oosqlRollbackHook db, ""
  .environment~classicRollbackHookCallCount = 0
  Call oosqlExec db, "BEGIN;"
  Call oosqlExec db, "INSERT INTO t VALUES(2);"
  Call oosqlExec db, "ROLLBACK;"
  self~assertEquals(0, .environment~classicRollbackHookCallCount, -
    "oosqlRollbackHook should not fire after deregister")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlUpdateHook: INSERT with event data verification                       --
--------------------------------------------------------------------------------

::Method testClassicCallbackUpdateHookInsert
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER, name TEXT);"
  .environment~classicUpdateHookEvents = .Array~new
  Call oosqlUpdateHook db, "classicUpdateHookCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1, 'Alice');"
  events = .environment~classicUpdateHookEvents
  self~assertEquals(1, events~items, -
    "Should have 1 update event")
  ev = events[1]
  self~assertEquals(18, ev~op, -
    "Operation should be INSERT (18)")
  self~assertEquals("main", ev~dbName, -
    "Database name should be 'main'")
  self~assertEquals("t", ev~tableName, -
    "Table name should be 't'")
  self~assertEquals(1, ev~rowID, -
    "rowID should be 1")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlUpdateHook: UPDATE and DELETE                                         --
--------------------------------------------------------------------------------

::Method testClassicCallbackUpdateHookUpdateDelete
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  .environment~classicUpdateHookEvents = .Array~new
  Call oosqlUpdateHook db, "classicUpdateHookCB"
  Call oosqlExec db, "UPDATE t SET x=2 WHERE x=1;"
  Call oosqlExec db, "DELETE FROM t WHERE x=2;"
  events = .environment~classicUpdateHookEvents
  self~assertEquals(2, events~items, -
    "Should have 2 events (UPDATE + DELETE)")
  self~assertEquals(23, events[1]~op, -
    "First event should be UPDATE (23)")
  self~assertEquals(9, events[2]~op, -
    "Second event should be DELETE (9)")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlUpdateHook: userData propagation                                      --
--------------------------------------------------------------------------------

::Method testClassicCallbackUpdateHookUserData
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicUpdateHookLastUD = .nil
  Call oosqlUpdateHook db, "classicUpdateHookUDCB", "upd_data"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertEquals("upd_data", .environment~classicUpdateHookLastUD, -
    "oosqlUpdateHook callback should receive userData")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlUpdateHook: deregistration                                            --
--------------------------------------------------------------------------------

::Method testClassicCallbackUpdateHookDeregister
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicUpdateHookEvents = .Array~new
  Call oosqlUpdateHook db, "classicUpdateHookCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertTrue(.environment~classicUpdateHookEvents~items > 0, -
    "oosqlUpdateHook should fire before deregister")
  Call oosqlUpdateHook db, ""
  .environment~classicUpdateHookEvents = .Array~new
  Call oosqlExec db, "INSERT INTO t VALUES(2);"
  self~assertEquals(0, .environment~classicUpdateHookEvents~items, -
    "oosqlUpdateHook should not fire after deregister")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlTrace: SQL text capture                                               --
--------------------------------------------------------------------------------

::Method testClassicCallbackTrace
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicTraceStatements = .Array~new
  Call oosqlTrace db, "classicTraceCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  stmts = .environment~classicTraceStatements
  self~assertTrue(stmts~items > 0, -
    "oosqlTrace callback should capture SQL statements")
  -- At least one should contain our INSERT
  found = .false
  Do stmt Over stmts
    If stmt~pos("INSERT") > 0 Then found = .true
  End
  self~assertTrue(found, -
    "Trace should capture the INSERT statement text")
  Call oosqlClose db

::Method testClassicCallbackTraceArgs
  -- oosqlTrace registered a profile callback: the routine got 3 arguments
  -- (sql, nanoseconds, userData) instead of (sql, userData), after the
  -- statement, and removing it did not return the user data.
  db = self~classicOpenMemory
  .environment~classicTraceArgs = .Array~new
  self~assertEquals(.nil, oosqlTrace(db, "classicTraceArgsCB", "myData"))
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  args = .environment~classicTraceArgs
  self~assertEquals(1, args~items, "One call for one statement")
  self~assertEquals(2, args[1]~items, "Number of arguments of the trace routine")
  self~assertEquals("CREATE TABLE t(x INTEGER);", args[1][1], "SQL text")
  self~assertEquals("myData", args[1][2], "User data is the second argument")
  self~assertEquals("myData", oosqlTrace(db, ""), "Removing returns the user data")
  self~assertEquals(0, oosqlClose(db))

--------------------------------------------------------------------------------
-- oosqlTrace: deregistration                                                 --
--------------------------------------------------------------------------------

::Method testClassicCallbackTraceDeregister
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicTraceStatements = .Array~new
  Call oosqlTrace db, "classicTraceCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertTrue(.environment~classicTraceStatements~items > 0, -
    "Trace should fire before deregister")
  Call oosqlTrace db, ""
  .environment~classicTraceStatements = .Array~new
  Call oosqlExec db, "INSERT INTO t VALUES(2);"
  self~assertEquals(0, .environment~classicTraceStatements~items, -
    "Trace should not fire after deregister")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlProfile: SQL text and timing capture                                  --
--------------------------------------------------------------------------------

::Method testClassicCallbackProfile
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicProfileEvents = .Array~new
  Call oosqlProfile db, "classicProfileCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  events = .environment~classicProfileEvents
  self~assertTrue(events~items > 0, -
    "oosqlProfile callback should capture events")
  ev = events[1]
  self~assertTrue(ev~sql~pos("INSERT") > 0, -
    "Profile event should contain SQL text")
  self~assertTrue(ev~nanoSeconds~dataType("W"), -
    "Profile nanoSeconds should be a whole number")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlProfile: deregistration                                               --
--------------------------------------------------------------------------------

::Method testClassicCallbackProfileDeregister
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicProfileEvents = .Array~new
  Call oosqlProfile db, "classicProfileCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertTrue(.environment~classicProfileEvents~items > 0, -
    "Profile should fire before deregister")
  Call oosqlProfile db, ""
  .environment~classicProfileEvents = .Array~new
  Call oosqlExec db, "INSERT INTO t VALUES(2);"
  self~assertEquals(0, .environment~classicProfileEvents~items, -
    "Profile should not fire after deregister")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlTrace and oosqlProfile: mutual exclusion                              --
--------------------------------------------------------------------------------

::Method testClassicCallbackTraceMutuallyExclusiveWithProfile
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  .environment~classicTraceStatements = .Array~new
  .environment~classicProfileEvents = .Array~new
  -- Register trace first
  Call oosqlTrace db, "classicTraceCB"
  -- Then register profile — should replace trace
  Call oosqlProfile db, "classicProfileCB"
  Call oosqlExec db, "INSERT INTO t VALUES(1);"
  self~assertEquals(0, .environment~classicTraceStatements~items, -
    "Trace should not fire after profile replaces it")
  self~assertTrue(.environment~classicProfileEvents~items > 0, -
    "Profile should fire (it replaced trace)")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlProgressHandler: basic invocation                                     --
--------------------------------------------------------------------------------

::Method testClassicCallbackProgressHandler
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Do i = 1 To 100
    Call oosqlExec db, "INSERT INTO t VALUES("i");"
  End
  .environment~classicProgressCallCount = 0
  ret = oosqlProgressHandler(db, "classicProgressCB", 10)
  self~assertEquals(0, ret, -
    "oosqlProgressHandler registration should return OK")
  Call oosqlExec db, "SELECT * FROM t;"
  self~assertTrue(.environment~classicProgressCallCount > 0, -
    "Progress callback should be invoked during long query")
  Call oosqlProgressHandler db, "", 0
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlProgressHandler: interruption                                         --
--------------------------------------------------------------------------------

::Method testClassicCallbackProgressHandlerInterrupt
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Do i = 1 To 1000
    Call oosqlExec db, "INSERT INTO t VALUES("i");"
  End
  .environment~classicProgressCallCount = 0
  -- userData = max calls before interrupting
  Call oosqlProgressHandler db, "classicProgressInterruptCB", 10, 5
  Call oosqlExec db, "SELECT * FROM t;"
  ec = oosqlErrCode(db)
  self~assertEquals(.ooSQLite~INTERRUPT, ec, -
    "Interrupted query should set errCode to INTERRUPT (9)")
  self~assertEquals(5, .environment~classicProgressCallCount, -
    "Progress callback should have been called exactly 5 times")
  Call oosqlProgressHandler db, "", 0
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlProgressHandler: deregistration                                       --
--------------------------------------------------------------------------------

::Method testClassicCallbackProgressHandlerDeregister
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x INTEGER);"
  Do i = 1 To 100
    Call oosqlExec db, "INSERT INTO t VALUES("i");"
  End
  .environment~classicProgressCallCount = 0
  Call oosqlProgressHandler db, "classicProgressCB", 10
  Call oosqlExec db, "SELECT * FROM t;"
  self~assertTrue(.environment~classicProgressCallCount > 0, -
    "Progress should fire before deregister")
  Call oosqlProgressHandler db, "", 0
  .environment~classicProgressCallCount = 0
  Call oosqlExec db, "SELECT * FROM t;"
  self~assertEquals(0, .environment~classicProgressCallCount, -
    "Progress should not fire after deregister")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlBusyHandler: lock contention with two file connections                --
--------------------------------------------------------------------------------

::Method testClassicCallbackBusyHandler
  tempFile = .TemporaryTestFile~new(.nil, "test_classic_busy.db")
  dbFile = tempFile~fullName
  Call SysFileDelete dbFile
  ret = oosqlOpen(dbFile, "db1")
  self~assertEquals(0, ret, "Open db1 should succeed")
  Call oosqlExec db1, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db1, "INSERT INTO t VALUES(1);"
  ret = oosqlOpen(dbFile, "db2")
  self~assertEquals(0, ret, "Open db2 should succeed")
  -- Register busy handler on db2
  .environment~classicBusyCallCount = 0
  Call oosqlBusyHandler db2, "classicBusyHandlerCB"
  -- Lock db1
  Call oosqlExec db1, "BEGIN EXCLUSIVE;"
  -- Try to write from db2 — triggers busy handler
  Call oosqlExec db2, "INSERT INTO t VALUES(2);"
  self~assertTrue(.environment~classicBusyCallCount > 0, -
    "Busy handler should be invoked on lock contention")
  Call oosqlExec db1, "COMMIT;"
  Call oosqlClose db1
  Call oosqlClose db2
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- oosqlBusyHandler: userData propagation                                     --
--------------------------------------------------------------------------------

::Method testClassicCallbackBusyHandlerUserData
  tempFile = .TemporaryTestFile~new(.nil, "test_classic_busy_ud.db")
  dbFile = tempFile~fullName
  Call SysFileDelete dbFile
  ret = oosqlOpen(dbFile, "db1")
  Call oosqlExec db1, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db1, "INSERT INTO t VALUES(1);"
  ret = oosqlOpen(dbFile, "db2")
  .environment~classicBusyLastUD = .nil
  Call oosqlBusyHandler db2, "classicBusyHandlerUDCB", "busy_data"
  Call oosqlExec db1, "BEGIN EXCLUSIVE;"
  Call oosqlExec db2, "INSERT INTO t VALUES(2);"
  self~assertEquals("busy_data", .environment~classicBusyLastUD, -
    "Busy handler should receive userData")
  Call oosqlExec db1, "COMMIT;"
  Call oosqlClose db1
  Call oosqlClose db2
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- oosqlBusyHandler: deregistration                                           --
--------------------------------------------------------------------------------

::Method testClassicCallbackBusyHandlerDeregister
  tempFile = .TemporaryTestFile~new(.nil, "test_classic_busy_dereg.db")
  dbFile = tempFile~fullName
  Call SysFileDelete dbFile
  ret = oosqlOpen(dbFile, "db1")
  Call oosqlExec db1, "CREATE TABLE t(x INTEGER);"
  Call oosqlExec db1, "INSERT INTO t VALUES(1);"
  ret = oosqlOpen(dbFile, "db2")
  .environment~classicBusyCallCount = 0
  Call oosqlBusyHandler db2, "classicBusyHandlerCB"
  Call oosqlExec db1, "BEGIN EXCLUSIVE;"
  Call oosqlExec db2, "INSERT INTO t VALUES(2);"
  self~assertTrue(.environment~classicBusyCallCount > 0, -
    "Busy handler should fire before deregister")
  Call oosqlExec db1, "COMMIT;"
  -- Deregister
  Call oosqlBusyHandler db2, ""
  .environment~classicBusyCallCount = 0
  Call oosqlExec db1, "BEGIN EXCLUSIVE;"
  Call oosqlExec db2, "INSERT INTO t VALUES(3);"
  self~assertEquals(0, .environment~classicBusyCallCount, -
    "Busy handler should not fire after deregister")
  Call oosqlExec db1, "COMMIT;"
  Call oosqlClose db1
  Call oosqlClose db2
  Call SysFileDelete dbFile

--------------------------------------------------------------------------------
-- oosqlSetAuthorizer: registration and deregistration                        --
--------------------------------------------------------------------------------

::Method testClassicCallbackSetAuthorizerRegisterOnly
  db = self~classicOpenMemory
  ret = oosqlSetAuthorizer(db, "classicAuthorizerCB")
  self~assertEquals(0, ret, -
    "oosqlSetAuthorizer registration should return OK")
  ret = oosqlSetAuthorizer(db, "")
  self~assertEquals(0, ret, -
    "oosqlSetAuthorizer deregistration should return OK")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlSetAuthorizer: the callback runs and gets its arguments (note #16)    --
--------------------------------------------------------------------------------

::Method testClassicCallbackSetAuthorizerExecution
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(x TEXT);"
  events = .Array~new
  ret = oosqlSetAuthorizer(db, "classicAuthorizerRecordCB", events)
  self~assertEquals(0, ret, -
    "oosqlSetAuthorizer registration should return OK")
  Call oosqlExec db, "SELECT x FROM t;", .true
  Call oosqlSetAuthorizer db, ""
  self~assertEquals(2, events~items, -
    "SELECT x FROM t should be authorized twice: SELECT and READ")
  self~assertEquals(.ooSQLiteConstants~SELECT "|||", events[1], -
    "SELECT: all four strings should be empty")
  self~assertEquals(.ooSQLiteConstants~READ "t|x|main|", events[2], -
    "READ: table, column, database, and an empty string")
  Call oosqlClose db

--------------------------------------------------------------------------------
-- oosqlCreateCollation: basic registration with ORDER BY                     --
--------------------------------------------------------------------------------

::Method testClassicCallbackCreateCollation
  db = self~classicOpenMemory
  Call oosqlExec db, "CREATE TABLE t(name TEXT);"
  Call oosqlExec db, "INSERT INTO t VALUES('banana');"
  Call oosqlExec db, "INSERT INTO t VALUES('Apple');"
  Call oosqlExec db, "INSERT INTO t VALUES('cherry');"
  ret = oosqlCreateCollation(db, "classicNoCaseCB", "CL_NOCASE")
  self~assertEquals(0, ret, -
    "oosqlCreateCollation should return OK")
  rs = oosqlExec(db, -
    "SELECT name FROM t ORDER BY name COLLATE CL_NOCASE;", .true, 2)
  self~assertEquals("Apple", rs[1]["NAME"], -
    "Case-insensitive sort: first should be 'Apple'")
  self~assertEquals("banana", rs[2]["NAME"], -
    "Case-insensitive sort: second should be 'banana'")
  self~assertEquals("cherry", rs[3]["NAME"], -
    "Case-insensitive sort: third should be 'cherry'")
  Call oosqlClose db

