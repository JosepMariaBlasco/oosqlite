/* oosqlCollation.xml */
collation_new ::= 'new'

/* oosqlCollationNeeded.xml */
collationneeded_new ::= 'new'

/* oosqlExtensions.xml */
extensions_lasterrcode_get ::= 'lastErrCode'
extensions_lasterrmsg_get ::= 'lastErrMsg'
extensions_autobuiltin ::= 'autoBuiltin(' entryPoints? ')'
extensions_autocollationneeded ::= 'autoCollationNeeded(' packageName ( ',' enable )? ')'
extensions_autocollation ::= 'autoCollation(' packageName ',' collationName ( ',' enable )? ')'
extensions_autofunction ::= 'autoFunction(' packageName ',' functionName ( ',' enable )? ')'
extensions_autopackage ::= 'autoPackage(' packageName ( ',' enable )? ')'
extensions_cancelautobuiltin ::= 'cancelAutoBuiltin(' entryPoints? ')'
extensions_getlibrary ::= 'getLibrary(' libraryName ')'
extensions_getpackage ::= 'getPackage(' packageName ')'
extensions_listbuiltins ::= 'listBuiltins(' print? ')'
extensions_loadlibrary ::= 'loadLibrary(' libName ( ',' procedures )? ')'
extensions_loadpackage ::= 'loadPackage(' libName ( ',' dbConn )? ( ',' makeAuto )? ')'
extensions_resetautobuiltin ::= 'resetAutoBuiltin'
extensions_registerbuiltin ::= 'registerBuiltin(' connection ( ',' name )? ')'

/* oosqlFunction.xml */
function_new ::= 'new'

/* oosqlLibrary.xml */
library_new ::= 'new'
library_lasterrcode_get ::= 'lastErrCode'
library_lasterrmsg_get ::= 'lastErrMsg'

/* oosqlPackage.xml */
package_new ::= 'new'
package_lasterrcode_get ::= 'lastErrCode'
package_lasterrmsg_get ::= 'lastErrMsg'
package_getcollation ::= 'getCollation(' rxName ')'
package_getcollationneeded ::= 'getCollationNeeded'
package_getfunction ::= 'getFunction(' rxName ')'
package_register ::= 'register(' dbConn ')'

/* oosqlResult.xml */
result_blob ::= 'blob(' sqlCntxt ',' blob ( ',' size )? ')'
result_double ::= 'double(' sqlCntxt ',' value ')'
result_error ::= 'error(' sqlCntxt ',' errMsg ')'
result_errorcode ::= 'errorCode(' sqlCntxt ',' errCode ')'
result_errornomem ::= 'errorNoMem(' sqlCntxt ')'
result_errortoobig ::= 'errorTooBig(' sqlCntxt ')'
result_int ::= 'int(' sqlCntxt ',' value ')'
result_int64 ::= 'int64(' sqlCntxt ',' value ')'
result_null ::= 'null(' sqlCntxt ')'
result_text ::= 'text(' sqlCntxt ',' txt ')'
result_value ::= 'value(' sqlCntxt ',' value ')'
result_zeroblob ::= 'zeroBlob(' sqlCntxt ',' size ')'

/* oosqlValue.xml */
value_blob ::= 'blob(' sqlValue ')'
value_bytes ::= 'bytes(' sqlValue ')'
value_double ::= 'double(' sqlValue ')'
value_int ::= 'int(' sqlValue ')'
value_int64 ::= 'int64(' sqlValue ')'
value_numerictype ::= 'numericType(' sqlValue ')'
value_text ::= 'text(' sqlValue ')'
value_type ::= 'type(' sqlValue ')'
