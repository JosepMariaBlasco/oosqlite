/* oosqliteBackup.xml */
backup_new ::= 'new(' srcDB ',' dstDB ( ',' save )? ( ',' srcName )? ( ',' dstName )? ')'
backup_finished_get ::= 'finished'
backup_initcode_get ::= 'initCode'
backup_lasterrcode_get ::= 'lastErrCode'
backup_lasterrmsg_get ::= 'lastErrMsg'
backup_pagecount_get ::= 'pageCount'
backup_remaining_get ::= 'remaining'
backup_savedestconn_get ::= 'saveDestConn'
backup_savedestconn_set ::= 'saveDestConn=' save
backup_finish ::= 'finish'
backup_getdestconn ::= 'getDestConn'
backup_step ::= 'step(' count? ')'

/* oosqliteClass.xml */
oosqlite_null_get ::= 'null'
oosqlite_null_set ::= 'null=' nullObj
oosqlite_recordformat_get ::= 'recordFormat'
oosqlite_recordformat_set ::= 'recordFormat=' format
oosqlite_compileoptionget ::= 'compileOptionGet(' nth ')'
oosqlite_compileoptionused ::= 'compileOptionUsed(' name ')'
oosqlite_complete ::= 'complete(' text ')'
oosqlite_enquote ::= 'enquote(' values? ')'
oosqlite_errstr ::= 'errStr(' resultCode ')'
oosqlite_libversion ::= 'libVersion'
oosqlite_libversionnumber ::= 'libVersionNumber'
oosqlite_memoryhighwater ::= 'memoryHighWater(' reset? ')'
oosqlite_memoryused ::= 'memoryUsed'
oosqlite_releasememory ::= 'releaseMemory(' count ')'
oosqlite_softheaplimit64 ::= 'softHeapLimit64(' n ')'
oosqlite_sourceid ::= 'sourceID'
oosqlite_sqlite3version ::= 'sqlite3Version'
oosqlite_status ::= 'status(' optParam ',' result ( ',' reset )? ')'
oosqlite_threadsafe ::= 'threadSafe'
oosqlite_version ::= 'version(' type? ')'

/* oosqliteConnection.xml */
connection_new ::= 'new(' file ( ',' opts )? ( ',' defFormat )? ( ',' reserved )? ')'
connection_backupdestination_get ::= 'backupDestination'
connection_closed_get ::= 'closed'
connection_filename_get ::= 'fileName'
connection_initcode_get ::= 'initCode'
connection_lasterrcode_get ::= 'lastErrCode'
connection_lasterrmsg_get ::= 'lastErrMsg'
connection_null_get ::= 'null'
connection_null_set ::= 'null=' nullObj
connection_recordformat_get ::= 'recordFormat'
connection_recordformat_set ::= 'recordFormat=' format
connection_busyhandler ::= 'busyHandler(' callBackObj ( ',' mthName )? ( ',' userData )? ')'
connection_busycallback ::= 'busyCallBack(' countInvoked ',' userData ')'
connection_busytimeout ::= 'busyTimeOut(' milliseconds ')'
connection_changes ::= 'changes'
connection_close ::= 'close'
connection_commithook ::= 'commitHook(' callBackObj ( ',' mthName )? ( ',' userData )? ')'
connection_commithookcallback ::= 'commitHookCallBack(' userData ')'
connection_createcollation ::= 'createCollation(' collationName ',' callbackObj ( ',' callbackOpt2 )? ( ',' userData )? ')'
connection_createfunction_function ::= 'createFunction(' name ',' callbackObj ',' countArgs ',' funcMth ( ',' ',' ',' userData )? ')'
connection_createfunction_aggregate ::= 'createFunction(' name ',' callbackObj ',' countArgs ',' ',' stepMth ',' finalMth ( ',' userData )? ')'
connection_createfunction_remove ::= 'createFunction(' name ',' '.nil' ( ',' countArgs )? ')'
connection_dbfilename ::= 'dbFileName(' name ')'
connection_dbmutex ::= 'dbMutex'
connection_dbreadonly ::= 'dbReadOnly(' name ')'
connection_dbreleasememory ::= 'dbReleaseMemory'
connection_dbstatus ::= 'dbStatus(' opt ',' result ( ',' reset )? ')'
connection_errcode ::= 'errCode'
connection_errmsg ::= 'errMsg'
connection_exec ::= 'exec(' sql ( ',' useCB )? ( ',' format )? ( ',' cbObj )? ( ',' mthName )? ( ',' uData )? ')'
connection_execcallback ::= 'execCallBack(' row ',' rowNum ',' userData ')'
connection_extendederrcode ::= 'extendedErrCode'
connection_extendedresultcodes ::= 'extendedResultCodes(' onOff ')'
connection_getautocommit ::= 'getAutocommit'
connection_interrupt ::= 'interrupt'
connection_lastinsertrowid ::= 'lastInsertRowID'
connection_limit ::= 'limit(' id ',' value ')'
connection_nextstmt ::= 'nextStmt(' stmt? ')'
connection_profile ::= 'profile(' callBackObj ( ',' mthName )? ( ',' userData )? ')'
connection_profilecallback ::= 'profileCallBack(' sql ',' nanoSeconds ',' userData ')'
connection_progresshandler ::= 'progressHandler(' callBackObj ( ',' instrcts )? ( ',' mName )? ( ',' urData )? ')'
connection_progresscallback ::= 'progressCallBack(' userData ')'
connection_pragma ::= 'pragma(' name ( ',' value )? ')'
connection_rollbackhook ::= 'rollbackHook(' callBackObj ( ',' mthName )? ( ',' userData )? ')'
connection_rollbackhookcallback ::= 'rollbackHookCallBack(' userData ')'
connection_setauthorizer ::= 'setAuthorizer(' callBackObj ( ',' mthName )? ( ',' userData )? ')'
connection_authorizercallback ::= 'authorizerCallBack(' code ',' str1 ',' str2 ',' str3 ',' str4 ',' userData ')'
connection_tablecolumnmetadata ::= 'tableColumnMetadata(' tableName ',' colName ',' results ( ',' dbName )? ')'
connection_totalchanges ::= 'totalChanges'
connection_trace ::= 'trace(' callBackObj ( ',' mthName )? ( ',' userData )? ')'
connection_tracecallback ::= 'traceCallBack(' sql ',' userData ')'
connection_updatehook ::= 'updateHook(' callBackObj ( ',' mthName )? ( ',' userData )? ')'
connection_updatehookcallback ::= 'updateHookCallBack(' op ',' dbName ',' tableName ',' rowID ',' userData ')'
