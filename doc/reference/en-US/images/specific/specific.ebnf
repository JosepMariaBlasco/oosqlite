/* oosqlFunctions.xml */
oosqliteencryptionavailable ::= 'ooSQLiteEncryptionAvailable()'
oosqliteenquote ::= 'ooSQLiteEnquote(' values? ')'
oosqlitemerge ::= 'ooSQLiteMerge(' ( arg ( ',' arg )* )? ')'
oosqliteregisterbuiltin ::= 'ooSQLiteRegisterBuiltin(' db ',' name ')'
oosqliteversion ::= 'ooSQLiteVersion(' type? ')'
