/* oosqlFunctionsA_F.xml */
oosqlautoextension ::= 'oosqlAutoExtension(' extensionName ')'
oosqlbackupfinish ::= 'oosqlBackupFinish(' buHandle ')'
oosqlbackupinit ::= 'oosqlBackupInit(' dstConn ',' srcConn ( ',' dstName )? ( ',' srcName )? ')'
oosqlbackuppagecount ::= 'oosqlBackupPageCount(' buHandle ')'
oosqlbackupremaining ::= 'oosqlBackupRemaining(' buHandle ')'
oosqlbackupstep ::= 'oosqlBackupStep(' buHandle ( ',' count )? ')'
oosqlbindblob ::= 'oosqlBindBlob(' stmt ',' index ',' value ')'
oosqlbinddouble ::= 'oosqlBindDouble(' stmt ',' index ',' value ')'
oosqlbindint ::= 'oosqlBindInt(' stmt ',' index ',' value ')'
oosqlbindint64 ::= 'oosqlBindInt64(' stmt ',' index ',' value ')'
oosqlbindnull ::= 'oosqlBindNull(' stmt ',' index ')'
oosqlbindparametercount ::= 'oosqlBindParameterCount(' stmt ')'
oosqlbindparameterindex ::= 'oosqlBindParameterIndex(' stmt ',' name ')'
oosqlbindparametername ::= 'oosqlBindParameterName(' stmt ',' index ')'
oosqlbindtext ::= 'oosqlBindText(' stmt ',' index ',' text ')'
oosqlbindvalue ::= 'oosqlBindValue(' stmt ',' index ',' value ')'
oosqlbindzeroblob ::= 'oosqlBindZeroBlob(' stmt ',' index ',' length ')'
oosqlbusyhandler ::= 'oosqlBusyHandler(' db ',' rtnName ( ',' userData )? ')'
oosqlbusytimeout ::= 'oosqlBusyTimeOut(' db ',' ms ')'
oosqlchanges ::= 'oosqlChanges(' db ')'
oosqlclearbindings ::= 'oosqlClearBindings(' stmt ')'
oosqlclose ::= 'oosqlClose(' db ')'
oosqlcolumnblob ::= 'oosqlColumnBlob(' stmt ',' col ')'
oosqlcolumnbytes ::= 'oosqlColumnBytes(' stmt ',' col ')'
oosqlcolumncount ::= 'oosqlColumnCount(' stmt ')'
oosqlcolumndatabasename ::= 'oosqlColumnDatabaseName(' stmt ',' col ')'
oosqlcolumndecltype ::= 'oosqlColumnDeclType(' stmt ',' col ')'
oosqlcolumndouble ::= 'oosqlColumnDouble(' stmt ',' col ')'
oosqlcolumnindex ::= 'oosqlColumnIndex(' stmt ',' colName ')'
oosqlcolumnint ::= 'oosqlColumnInt(' stmt ',' col ')'
oosqlcolumnint64 ::= 'oosqlColumnInt64(' stmt ',' col ')'
oosqlcolumnname ::= 'oosqlColumnName(' stmt ',' col ')'
oosqlcolumnoriginname ::= 'oosqlColumnOriginName(' stmt ',' col ')'
oosqlcolumntablename ::= 'oosqlColumnTableName(' stmt ',' col ')'
oosqlcolumntext ::= 'oosqlColumnText(' stmt ',' col ( ',' nullObj )? ')'
oosqlcolumntype ::= 'oosqlColumnType(' stmt ',' col ')'
oosqlcolumnvalue ::= 'oosqlColumnValue(' stmt ',' col ')'
oosqlcollationneeded ::= 'oosqlCollationNeeded(' db ',' rtnName ( ',' userData )? ')'
oosqlcommithook ::= 'oosqlCommitHook(' db ',' rtnName ( ',' userData )? ')'
oosqlcompileoptionget ::= 'oosqlCompileOptionGet(' index ')'
oosqlcompileoptionused ::= 'oosqlCompileOptionUsed(' name ')'
oosqlcomplete ::= 'oosqlComplete(' sql ')'
oosqlcreatecollation ::= 'oosqlCreateCollation(' db ',' rtnName ',' collationName ( ',' userData )? ')'
oosqlcreatefunction_function ::= 'oosqlCreateFunction(' db ',' name ',' countArgs ',' funcRtn ( ',' ',' ',' userData )? ')'
oosqlcreatefunction_aggregate ::= 'oosqlCreateFunction(' db ',' name ',' countArgs ',' ',' stepRtn ',' finalRtn ( ',' userData )? ')'
oosqlcreatefunction_remove ::= 'oosqlCreateFunction(' db ',' name ( ',' countArgs )? ')'
oosqldatacount ::= 'oosqlDataCount(' stmt ')'
oosqldbfilename ::= 'oosqlDbFileName(' db ',' name ')'
oosqldbhandle ::= 'oosqlDbHandle(' stmt ')'
oosqldbmutex ::= 'oosqlDbMutex(' db ')'
oosqldbreadonly ::= 'oosqlDbReadOnly(' db ',' name ')'
oosqldbreleasememory ::= 'oosqlDbReleaseMemory(' db ')'
oosqldbstatus ::= 'oosqlDbStatus(' db ',' param ',' result ( ',' reset )? ')'
oosqlenableloadextension ::= 'oosqlEnableLoadExtension(' db ( ',' on )? ')'
oosqlerrcode ::= 'oosqlErrCode(' db ')'
oosqlerrmsg ::= 'oosqlErrMsg(' db ')'
oosqlerrstr ::= 'oosqlErrStr(' resultCode ')'
oosqlexec ::= 'oosqlExec(' db ',' sql ( ',' doCallback )? ( ',' format )? ( ',' rtnName )? ')'
oosqlextendederrcode ::= 'oosqlExtendedErrCode(' db ')'
oosqlextendedresultcodes ::= 'oosqlExtendedResultCodes(' db ',' onOff ')'
oosqlfinalize ::= 'oosqlFinalize(' stmt ')'
